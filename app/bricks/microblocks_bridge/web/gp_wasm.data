#. "Output" blocks category label
msgid "cat;Output"
msgstr "Risultato"

#. Block in Output category
msgid "set user LED _"
msgstr "Accendi LED utente _"

#. Block in Output category
msgid "say _"
msgstr "dici _"

#. Block in Output category
msgid "graph _"
msgstr "grafico _"

#. "Input" blocks category label
msgid "cat;Input"
msgstr "Ingresso"

#. Block in Input category
msgid "button A"
msgstr "Tasto A"

#. Block in Input category
msgid "button B"
msgstr "Tasto B"

#. Block in Input category
msgid "timer"
msgstr "cronometro"

#. Block in Input category
msgid "reset timer"
msgstr "azzera il timer"

#. Block in Input category
msgid "seconds"
msgstr "secondi"

#. Block in Input category
msgid "microseconds"
msgstr "microsecondi"

#. Block in Input category
msgid "milliseconds"
msgstr "millisecondi"

#. Block in Input category
msgid "board type"
msgstr "tipo di scheda"

#. Block in Input category
msgid "version"
msgstr "versione"

#. Block in Input category
msgid "milliseconds since _"
msgstr "millisecondi a partire da _"

#. Block in Input category
msgid "end time _"
msgstr "tempo finale _"

#. Block in Input category
msgid "microseconds since _"
msgstr "microsecondi a partire da _"

#. Block in Input category
msgid "BLE id"
msgstr "numero di identificazione BLE"

#. Block in Input category
msgid "BLE connected"
msgstr "BLE connesso"

#. Block in Input category
#, fuzzy
msgid "connected to IDE"
msgstr "connesso all'IDE"

#. "Pins" blocks category label
msgid "cat;Pins"
msgstr "Pins"

#. Block in Pins category
msgid "read digital pin _"
msgstr "leggi pin digitale _"

#. Block in Pins category
msgid "read analog pin _"
msgstr "leggi pin analogico _"

#. Block in Pins category
#, fuzzy
msgid "pullup _"
msgstr "pullup _"

#. Block in Pins category
msgid "set digital pin _ to _"
msgstr "set pin digitale _ a _"

#. Block in Pins category
msgid "set pin _ to _"
msgstr "set pin _ a _"

#. Block in Pins category
msgid "analog pins"
msgstr "pin analogici"

#. Block in Pins category
msgid "digital pins"
msgstr "pin digitali"

#. "Control" blocks category label
msgid "cat;Control"
msgstr "Controllo"

#. Block in Control category
msgid "when started"
msgstr "all'avvio"

#. Block in Control category
msgid "when button _ pressed"
msgstr "quando tasto _ è premuto"

#. Block in Control category
msgid "forever _"
msgstr "all'infinito _"

#. Block in Control category
msgid "repeat _ _"
msgstr "ripeti _ _"

#. Block in Control category
msgid "wait _ millisecs"
msgstr "attendi _ millisecondi"

#. Block in Control category
msgid "if _ _"
msgstr "se _ _"

#. Block in Control category
msgid "if _ _ else _"
msgstr "se _ _ altrimenti _"

#. Block in Control category
msgid "else if _ _"
msgstr "altrimenti se _ _"

#. Block in Control category
msgid "else"
msgstr "altrimenti"

#. Block in Control category
msgid "when _"
msgstr "quando _"

#. Block in Control category
msgid "wait until _"
msgstr "attendi fino a _"

#. Block in Control category
msgid "wait _ microsecs"
msgstr "attendi _ microsecondi"

#. Block in Control category
msgid "return _"
msgstr "ritorna _"

#. Block in Control category
