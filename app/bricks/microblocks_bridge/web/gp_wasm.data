#. String in file picker and library dialogs
msgid "New library name?"
msgstr "Jméno nové knihovny?"

#. Scripting area right-click context menu
msgid "show all block definitions"
msgstr "zobraz všechny definice bloků"

#. Scripting area right-click context menu
msgid "hide all block definitions"
msgstr "skryj všechny definice bloků"

#. Library label right click context menu option
msgid "export this library"
msgstr "exportuj tuto knihovnu"

#. Library label right click context menu option
msgid "delete library"
msgstr "smaž knihovnu"

#. Project source folder
msgid "Examples"
msgstr "Příklady"

#. Project source folder
msgid "Desktop"
msgstr "Plocha"

#. Project source folder
msgid "Computer"
msgstr "Počítač"

#. Project source
msgid "Cloud"
msgstr "Cloud"

#. String in file picker and library dialogs
msgid "File"
msgstr "Soubor"

#. String in file picker and library dialogs
msgid "File Open"
msgstr "Otevřít soubor"

#. String in file picker and library dialogs
msgid "File Save"
msgstr "Uložit soubor"

#. String in file picker and library dialogs
msgid "File name:"
msgstr "Soubor:"

#. String in file picker and library dialogs
msgid "New Folder"
msgstr "Nová složka"

#. String in file picker and library dialogs
#. as in "by Jane Doe", the author of this library
msgid "libdata;by"
msgstr "od"

#. String in file picker and library dialogs
#. as in dependencies of this library
msgid "Depends:"
msgstr "Závisí na:"

#. String in file picker and library dialogs
msgid "Tags:"
msgstr "Klíčová slova:"

#. String in file picker and library dialogs
msgid "Path, name or URL for library?"
msgstr "Cesta, jméno nebo URL pro knihovnu?"

#. String in file picker and library dialogs
msgid "Invalid URL"
msgstr "Neplatné URL"

#. String in file picker and library dialogs
msgid "Could not fetch library."
msgstr "Nelze načíst knihovnu."

#. String in file picker and library dialogs
msgid "Host does not exist or is currently down."
msgstr "Server neexistuje nebo je momentálně nedostupný."

#. String in file picker and library dialogs
msgid "File not found in server."
msgstr "Soubor na serveru nenalezen."

#. String in file picker and library dialogs
msgid "Server expects HTTPS, and MicroBlocks doesn't currently support it."
msgstr "Server očekává HTTPS, momentálně MicroBlocks nepodporuje."

#. String in file picker and library dialogs
msgid "library information"
msgstr "informace o knihovně"

#. String in file picker and library dialogs
msgid "built-in library"
msgstr "vestavěná knihovna"

#. String in file picker and library dialogs
msgid "Dependency path, name or URL?"
msgstr "Závislost - cesta, jméno nebo URL?"

#. String in file picker and library dialogs
msgid "If you are adding a library that's built into MicroBlocks, you can just enter its name."
msgstr ""
"Při přidání knihovny která je vestavěna v MicroBlocks lze zadat pouze její "
"jméno."

#. String in file picker and library dialogs
msgid "If your library is in the Libraries folder in your local MicroBlocks project folder, you need to prefix it with a slash (/)."
msgstr ""
"Pokud je vaše knihovna ve složce \"Libraries\" ve vaší lokální složce "
"projektu MicroBlocks, musíte název doplnit prefixem \"/\"."

#. String in file picker and library dialogs
msgid "If the library is hosted online, please input its full URL."
msgstr "Pokud je knihovna hostována online, je třeba zadat celou URL adresu."

#. String in file picker and library dialogs
msgid "Tag name?"
msgstr "Klíčové slovo?"

#. String in file picker and library dialogs
msgid "user library"
msgstr "uživatelská knihovna"

#. String in file picker and library dialogs
msgid "Add Library"
msgstr "Přidat Knihovnu"

#. the %1 tag should be kept intact. Seconds remaining for a process to finish.
msgid "%1 seconds remaining"
msgstr "%1 vteřin zbývá"

#. Block size button tooltip
msgid "Decrease block size"
msgstr "Zmenšit velikost bloku"

#. Block size button tooltip
msgid "Restore block size to 100%"
msgstr "Obnovit velikost bloku (100%)"

#. Block size button tooltip
msgid "Increase block size"
msgstr "Zvětšit velikost bloku"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Button"
msgstr "Tlačítko"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Boolean Input"
msgstr "Zadání logické hodnoty"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
msgid "[l] toggle value, or drop a reporter into it."
msgstr "[l] přepnutí hodnoty nebo přetažení hodnoty na pozici."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Color Input"
msgstr "Zadání barvy"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
msgid "[l] change the color, or drop a reporter into it."
msgstr "[l] změna barvy nebo přetažení hodnoty na pozici."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Input"
msgstr "Vstup"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
msgid "[l] edit its value, or drop a reporter into it."
msgstr "[l] úprava hodnoty nebo přetažení hodnoty na pozici."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Block Extension"
msgstr "Rozšířené bloky"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
msgid "[l] right arrow to show optional inputs, left arrow to hide."
msgstr ""
"[l] šipka doprava pro zobrazení volitelných parametrů, šipka doleva pro "
"skrytí."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Command Block"
msgstr "Příkazový Blok"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Hat Block"
msgstr "Zahajovací Blok"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
#. The [r] tag turns into an icon of a mouse with the right button pressed
msgid "[l] to run, or drag to build scripts. [r] menu."
msgstr "[l] spustit, přetáhnout pro tvorbu skriptu. [r] menu."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Reporter Block"
msgstr "Blok Zprávy"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
#. The [r] tag turns into an icon of a mouse with the right button pressed
msgid "[l] to see value, or drop into an input slot. [r] menu."
msgstr "[l] zobrazit hodnotu, přetáhnout do místa pro vstup. [r] menu."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Script"
msgstr "Skript"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
#. The [r] tag turns into an icon of a mouse with the right button pressed
msgid "[l] to run. [r] menu."
msgstr "[l] spustit. [r] menu."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Pane Divider"
msgstr "Oddělovač Panelů"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Drag to change pane width."
msgstr "Táhnout pro změnu šířky panelu."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Library"
msgstr "Knihovna"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
#. The [r] tag turns into an icon of a mouse with the right button pressed
msgid "[l] to show the blocks in this library. [r] menu."
msgstr "[l] zobrazení bloků v této knihovně. [r] menu."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Block Category"
msgstr "Kategorie Bloků"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
msgid "[l] to show the blocks in this category."
msgstr "[l] zobrazení bloků této kategorie."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Palette"
msgstr "Paleta"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Drag blocks from here to build scripts. Drop scripts here to delete them."
msgstr ""
"Odsud se tahají bloky pro vytváření skriptů. Pro smazání skriptu jej upusťte "
"zde."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Scripts Pane"
msgstr "Panel Skriptů"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [r] tag turns into an icon of a mouse with the right button pressed
msgid "Drag blocks here to build scripts. [r] menu."
msgstr "Do tohoto panelu se vkládají bloky pro vytváření skriptu. [r] menu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Turn the user LED on or off."
msgstr "Zhasnutí/Rozsvícení uživatelské LED na desce mikropočítače."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Display a bubble showing the value."
msgstr "Zobrazení bubliny s hodnotou."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Graph the value."
msgstr "Záznam hodnoty do grafu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Report the state of button A ( (-o) or (o-) )."
msgstr "Vrátí stav tlačítka A ( (-o) nebo (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Report the state of button B ( (-o) or (o-) )."
msgstr "Vrátí stav tlačítka B ( (-o) nebo (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the milliseconds since the timer was last reset."
msgstr "Vrátí počet milisekund od posledního nulování časovače."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Reset the timer."
msgstr "Vynulování časovače."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the seconds since power up."
msgstr "Vrátí počet vteřin od zapnutí mikropočítače."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the milliseconds since power up."
msgstr "Vrátí počet milisekund od zapnutí mikropočítače."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the microseconds since power up."
msgstr "Vrátí počet mikrosekund od zapnutí mikropočítače."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the board type."
msgstr "Vrátí typ mikropočítače/desky."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Reports firmware version loaded on the board."
msgstr "Vrátí aktuální verzi firmware mikropočítače."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Reports the three-letter BLE ID of the board if it supports BLE."
msgstr ""
"Vrátí 3-znakovou identifikaci BLE pokud deska mikropočítače podporuje BLE."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Reports (-o) if a BLE client is connected."
msgstr "Vrátí (-o) pokud je připojen BLE klient."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the milliseconds since the given start milliseconds. Handles clock wrap."
msgstr "Vrátí počet milisekund od daného počátečního stavu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the microseconds since the given start microseconds. Handles clock wrap."
msgstr "Vrátí počet mikrosekund od daného počátečního stavu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Reports (-o) if the board is connected to IDE."
msgstr "Vrátí (-o) pokud je mikropočítač připojen k IDE."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Report the electrical logic level on a digital pin ( (-o) or (o-) )."
msgstr "Vrátí logickou hodnotu digitálního vstupu ( (-o) or (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a number proportional to the voltage on an analog pin (0 = ground, 1023 = supply voltage)."
msgstr ""
"Vrátí hodnotu odpovídající napětí na analogovém vstupu ( 0 = GND, 1023 = "
"napájecí napětí )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Turn a pin on or off ( (-o) or (o-) )."
msgstr "Nastaví logickou hodnotu na výstupním pinu ( (-o) nebo (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Pulse width modulate (PWM) a pin with the given duty cycle (0 - 1023)."
msgstr "Nastavení šířky PWM pulzu na výstupním pinu (0-1023)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report number of analog pins on this device."
msgstr "Vrátí počet analogových pinů mikropočítače/desky."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report number of digital pins on this device."
msgstr "Vrátí počet digitálních pinů mikropočítače/desky."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the value of a register (0-255) of an I2C device (0-127)."
msgstr "Vrátí hodnotu registru (0-255) z I2C zařízení (adresa 0-127)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Set an I2C device and register to given value (0-255)."
msgstr "Nastaví registr I2C zařízení na zadanou hodnotu (0-255)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Receive multiple bytes from an I2C device."
msgstr "Příjem více bajtů z I2C zařízení."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send multiple bytes to an I2C device."
msgstr "Odeslání více bajtů do I2C zařízení."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send a byte (0-255) to an SPI device."
msgstr "Odeslání bajtu (0-255) do SPI zařízení."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Read a byte from an SPI device while sending a zero byte. Report the byte received."
msgstr "Vrátí přečtený bajt z SPI zařízení zatímco odešle bajt=0."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Set the SPI clock speed, mode, channel (Raspberry Pi only), and bit order."
msgstr "Nastaví rychlost hodin SPI, kanál (pouze RPI) a pořadí bitů."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send a byte array via SPI, replacing its contents with the bytes received."
msgstr "Odeslání pole bajtů do SPI a nahrazení jejich obsahu přijatými bajty."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Open the serial port at the given baud rate."
msgstr "Otevření sériového portu s danou přenosovou rychlostí."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Close the serial port."
msgstr "Zavření sériového portu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report data received from the serial port (a byte array)."
msgstr "Vrátí data přijatá ze sériového portu (pole bajtů)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send a byte array to the serial port."
msgstr "Odeslání pole bajtů po sériovém portu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send a byte array to the serial port, starting at the given byte."
msgstr "Odeslání pole bajtů po sériovém portu počínaje daným bajtem."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Write a byte to the pin at the specified baud rate."
msgstr "Odeslání jednoho bajtu na výstup specifikovanou rychlostí (baud)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Run when the board powers up or when the IDE start button is clicked."
msgstr ""
"Úkol spuštěný po zapnutí napájení desky mikropočítače nebo při kliknutí na "
"tlačítko start v pravém horním rohu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Run when buttons A, B, or A+B are pressed."
msgstr "Úkol běží při stisku tlačítka A, B nebo A+B."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Repeat the enclosed blocks indefinitely."
msgstr "Nekonečné opakování vnořených bloků."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Repeat the enclosed blocks the given number of times."
msgstr "Opakování vnořených bloků tolikrát kolikrát je uvedeno."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Wait the given number of milliseconds."
msgstr "Čekání po zadaný čas (v milisekundách)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Run the first set of blocks whose test condition is (-o) ."
msgstr "Provede první skupinu bloků když je splněna podmínka (-o) ."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Run when the condition becomes (-o) ."
msgstr "Úkol běží při splnění podmínky (-o) ."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Wait until the condition becomes (-o) ."
msgstr "Čekání na splnění podmínky (-o) ."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Return (report) the given value from a function or script."
msgstr "Vrátí výstupní hodnotu z funkce nebo skriptu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Run when the given message is received as a broadcast."
msgstr "Spuštění úkolu když je přijata zadaná zpráva."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Broadcast the given message."
msgstr "Rozeslání zadané zprávy."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Do nothing. Used to add notes and documentation."
msgstr "Prázdný příkaz. Nedělá nic, používá se pro poznámky a dokumentaci."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a list containing the given range of numbers (with optional increment). Useful in \"for\" loops."
msgstr ""
"Vrátí seznam obsahující zadaný rozsah čísel. Užitečné pro počítané cykly ("
"\"for\")."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Repeat the enclosed blocks with the variable set to the current iteration number or item."
msgstr ""
"Opakování vnořených bloků s proměnnou pro hodnoty z rozsahu nebo položky ze "
"seznamu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Repeat the enclosed blocks until the condition becomes (-o) ."
msgstr "Opakování vnořených bloků dokud není splněna podmínka."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Stop this task."
msgstr "Zastaví tento úkol."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Stop all tasks except this one."
msgstr "Zastaví všechny úkoly kromě aktuálního."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Wait the given number of microseconds."
msgstr "Čekání po zadaný čas (v mikrosekundách)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the last broadcast message received."
msgstr "Vrátí poslední přijatou zprávu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the given argument or defaultValue if the argument was not supplied by the caller."
msgstr ""
"Vrátí zadaný argument nebo default hodnotu pokud argument nebyl při volání "
"dodán."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Call the function with the given name and optional parameter list."
msgstr "Zavolá funkci daného jména s případnými parametry."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Call the function with the given name and optional parameter list and report its return value."
msgstr ""
"Zavolá funkci daného jména s případnými parametry a vrátí návratovou hodnotu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the sum of the given numbers."
msgstr "Vrátí součet zadaných čísel."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the first number minus the second."
msgstr "Vrátí rozdíl čísel."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the product of the given numbers."
msgstr "Vrátí součin čísel."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the first number divided by the second."
msgstr "Vrátí podíl čísel (celočíselný)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the remainder of dividing the first number by the second."
msgstr "Vrátí zbytek po celočíselném dělení."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the absolute value of the given number (always >= 0)."
msgstr "Vrátí absolutní hodnotu čísla (vždy >= 0 )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the minimum of the values."
msgstr "Vrátí nejmenší hodnotu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the maximum of the values."
msgstr "Vrátí největší hodnotu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a randomly chosen number in the given range."
msgstr "Vrátí náhodné číslo z rozsahu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the first value is less than the second one."
msgstr "Vrátí (-o) když je první hodnota menší než druhá."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the first value is less than or equal to the second one."
msgstr "Vrátí (-o) když je první hodnota menší nebo stejná jako druhá."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the two values are equal."
msgstr "Vrátí (-o) když jsou obě hodnoty stejné."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the two values are not equal."
msgstr "Vrátí (-o) když jsou hodnoty odlišné."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the first value is greater than or equal to the second one."
msgstr "Vrátí (-o) když je první hodnota větší nebo stejná jako druhá."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the first value is greater than the second one."
msgstr "Vrátí (-o) když je první hodnota větší než druhá."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Boolean constant ( (-o) or (o-) )."
msgstr "Logická hodnota ( (-o) nebo (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Report the logical inverse of a Boolean ( (-o) or (o-) ) value."
msgstr "Vrátí opak logické hodnoty ( (-o) případně (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if both values are (-o)"
msgstr "Vrátí (-o) pokud jsou obě hodnoty (-o)"

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if either value is (-o)"
msgstr "Vrátí (-o) pokud je nějaká z hodnot (-o)"

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if first input is a value of the given data type."
msgstr "Vrátí (-o) pokud první údaj je daného typu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Convert a value to the given data type."
msgstr "Zkonvertuje hodnotu do zadaného datového typu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "If the condition is (-o) report the first alternative otherwise report the second alternative."
msgstr "Když je podmínka (-o) vrací první variantu jinak vrací druhou variantu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Map a value in the \"from\" range to the corresponding value in the \"to\" range."
msgstr "Mapuje hodnotu ze vstupního rozsahu do výstupního rozsahu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the numerical value of a hexadecimal string (range: -0x1FFFFFFF to 0x1FFFFFFF)"
msgstr ""
"Vrátí numerickou hodnotu jako hexadecimální řetězec (rozsah: -0x1FFFFFFF to "
"0x1FFFFFFF)"

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report bitwise AND of two numbers."
msgstr "Vrátí bitové AND dvou čísel."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report bitwise OR of two numbers."
msgstr "Vrátí bitové OR dvou čísel."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report bitwise XOR (exclusive OR) of two numbers."
msgstr "Vrátí bitové XOR dvou čísel."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report bitwise inverse of the given number."
msgstr "Vrátí bitovou inverzi čísla."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the given number shifted left by the given number of bits."
msgstr "Vrátí hodnotu čísla posunutou doleva o zadaný počet bitů."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the given number shifted right by the given number of bits (arithmetic shift; sign is maintained)."
msgstr ""
"Vrátí hodnotu čísla posunutou doprava o zadaný počet bitů (aritmetický "
"posun, znaménko zůstává zachováno)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Set a variable to the given value."
msgstr "Nastaví proměnnou na danou hodnotu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Change a variable by the given amount."
msgstr "Změní proměnnou o danou hodnotu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Create a variable local to the containing script with the given initial value."
msgstr ""
"Vytvoří lokální proměnnou aktuálního skriptu s danou počáteční hodnotou."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the Nth item of a list, string, or byte array."
msgstr "Vrátí n-tou položku seznamu, řetězce nebo pole bajtů."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the number of items in a list, string, or byte array."
msgstr "Vrátí počet položek (délku) seznamu, řetězce nebo pole bajtů."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Join (concatenate) the given lists, strings, or byte arrays and report the result."
msgstr "Spojí zadané seznamy, řetězce nebo pole bajtů a vrátí výsledek."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Create and report a short list containing the given items. Length limited by available stack space."
msgstr ""
"Vytvoří a vrátí seznam obsahující dané položky. Délka je limitována "
"dostupnou velikostí zásobníku."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Add an item to the end of a list."
msgstr "Přidá položku na konec seznamu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Replace the Nth item (or all items) of a list or byte array with the given value."
msgstr ""
"Nahradí N-tou položku seznamu/pole bajtů (případně všechny) danou hodnotou."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Delete the Nth item (or all items) of a list."
msgstr "Smaže N-tou položku seznamu (případně všechny)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Find and report the index of an item in a list or a substring within a string. Report -1 if not found."
msgstr ""
"Vyhledá a vrátí index položky v seznamu nebo podřetězce v textu. Pokud není "
"položka nalezena vrátí -1."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a copy from the given index through the end (or optional stop index) of the given list, string, or byte array."
msgstr ""
"Pro zadaný seznam/text/pole bajtů vrátí kopii od daného indexu do konce ("
"případně do zadaného koncového indexu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Split the given string with the given delimiter and report the result (a list of strings)."
msgstr ""
"Rozdělí text do seznamu řetězců podle zadaného oddělovače a vrátí tento "
"seznam."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Combine the items of a list into a string, optionally separated by a delimiter (e.g. comma)."
msgstr ""
"Spojí položky seznamu do řetězce, s použitím volitelného oddělovače položek."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the Unicode value (\"code point\") of the Nth character of the given string."
msgstr "Vrací Unicode N-tého znaku řetězce."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a string containing the given Unicode value (\"code point\") or list of values."
msgstr "Vrátí řetězec obsahující zadanou hodnotu Unicode nebo seznamu hodnot."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a new list of the given length filled with zero or the optional value."
msgstr ""
"Vrátí nový seznam dané délky vyplněný nulami případně zadanou volitelnou "
"hodnotou."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a new byte array of the given length filled with zero or the optional value."
msgstr ""
"Vrátí nové pole bajtů dané délky vyplněné nulami případně zadanou volitelnou "
"hodnotou."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a byte array containing the UTF-8 bytes of the given string."
msgstr "Vrátí pole bajtů obsahující UTF-8 hodnoty znaků zadaného řetězce."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the number of words of memory available. Stop button frees up memory."
msgstr "Vrátí velikost dostupné paměti (words). Stop uvolňuje paměť."

