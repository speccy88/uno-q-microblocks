#. Block in Input category
msgid "BLE connected"
msgstr "Ble இணைக்கப்பட்டுள்ளது"

#. Block in Input category
msgid "connected to IDE"
msgstr "IDE உடன் இணைக்கப்பட்டுள்ளது"

#. "Pins" blocks category label
msgid "cat;Pins"
msgstr "ஊசிகள்"

#. Block in Pins category
msgid "read digital pin _"
msgstr "டிசிட்டல் முள் _ படிக்கவும்"

