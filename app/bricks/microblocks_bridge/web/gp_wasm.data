  'play tone' 'D' 1 400
  waitMillis 100
  'play tone' 'D#' 1 250
  'play tone' 'F' 1 250
  'play tone' 'G' 1 250
  'play tone' 'F' 1 250
  'play tone' 'D#' 1 250
