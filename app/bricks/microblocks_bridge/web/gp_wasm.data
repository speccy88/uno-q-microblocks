#. Generate synthesized sound waves to play on a DAC, over PWM, or any other analog means
msgid "Analog Synthesis"
msgstr "அனலாக் தொகுப்பு"

#. Analog Synthesis library block
#. only translate "gate _" as in a synthesizer sound gate that can be triggered
msgid "#SVG#wave-square gate _"
msgstr "#எச்.வி.சி#அலை-சதுர வாயில் _"

