msgstr "போர்டில் மைக்ரோ பிளாக்சைப் பதிவேற்றுவது ..."

#. Settings menu option
msgid "dark mode"
msgstr "இருண்ட முறை"

#. Settings menu option
msgid "advanced mode"
msgstr "மேம்பட்ட பயன்முறை"

