msgstr "அனலாக்ச் ஊசிகள்"

#. Block in Pins category
msgid "digital pins"
msgstr "டிசிட்டல் ஊசிகள்"

#. "Control" blocks category label
msgid "cat;Control"
msgstr "கட்டுப்பாடு"

#. Block in Control category
msgid "when started"
msgstr "தொடங்கும்போது"

#. Block in Control category
msgid "when button _ pressed"
msgstr "பொத்தான் _ அழுத்தும் போது"

