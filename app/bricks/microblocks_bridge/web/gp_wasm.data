msgstr "Dibuat dengan GP"

#. About window info
msgid "More info at %1"
msgstr "Info lebih lanjut di %1"

#. MicroBlocks IDE error message.
msgid "Script is too large to send to board."
msgstr "Skrip terlalu besar untuk dikirim ke papan."

#. MicroBlocks IDE information
msgid "Use \"Connect\" button to connect to a MicroBlocks device."
msgstr "Gunakan tombol \"Sambungkan\" untuk terhubung ke perangkat MicroBlocks."

#. MicroBlocks IDE error message.
msgid "No boards found; is your board plugged in?"
msgstr "Tidak ada papan ditemukan; apakah papan Anda sudah dicolokkan?"

#. MicroBlocks IDE information
msgid "For AdaFruit boards, double-click reset button and try again."
msgstr "Untuk papan AdaFruit, klik ganda tombol reset dan coba lagi."

#. MicroBlocks IDE error message.
msgid "Only recent Chrome and Edge browsers support WebSerial."
msgstr "Hanya browser Chrome dan Edge terbaru yang mendukung WebSerial."

