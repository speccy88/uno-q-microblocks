msgid "attach ST7735 w _ h _ rotation _ #BR# dc pin _ cs pin _ backlight pin _"
msgstr ""
"attacher ST7735 larg _ haut _ rotation _ #BR# broche dc _ broche cs _ broche "
"rétroéclairage _"

