#. String in file picker and library dialogs
msgid "File"
msgstr "Tệp"

#. String in file picker and library dialogs
msgid "File Open"
msgstr "Mở tệp"

#. String in file picker and library dialogs
msgid "File Save"
msgstr "Lưu tệp"

#. String in file picker and library dialogs
msgid "File name:"
msgstr "Tên tệp:"

#. String in file picker and library dialogs
msgid "New Folder"
msgstr "Thư mục mới"

#. String in file picker and library dialogs
#. as in "by Jane Doe", the author of this library
msgid "libdata;by"
msgstr "qua"

#. String in file picker and library dialogs
#. as in dependencies of this library
msgid "Depends:"
msgstr "Phụ thuộc:"

#. String in file picker and library dialogs
msgid "Tags:"
msgstr "Thẻ:"

#. String in file picker and library dialogs
msgid "Path, name or URL for library?"
msgstr "Đường dẫn, tên hoặc URL cho thư viện?"

#. String in file picker and library dialogs
msgid "Invalid URL"
msgstr "URL không hợp lệ"

#. String in file picker and library dialogs
msgid "Could not fetch library."
msgstr "Không thể tìm nạp thư viện."

#. String in file picker and library dialogs
msgid "Host does not exist or is currently down."
msgstr "Máy chủ không tồn tại hoặc hiện đang ngừng hoạt động."

#. String in file picker and library dialogs
msgid "File not found in server."
msgstr "Không tìm thấy tệp trong máy chủ."

#. String in file picker and library dialogs
msgid "Server expects HTTPS, and MicroBlocks doesn't currently support it."
msgstr "Máy chủ yêu cầu HTTPS và MicroBlocks hiện không hỗ trợ nó."

#. String in file picker and library dialogs
msgid "library information"
msgstr "thông tin thư viện"

#. String in file picker and library dialogs
msgid "built-in library"
msgstr "thư viện tích hợp"

#. String in file picker and library dialogs
msgid "Dependency path, name or URL?"
msgstr "Đường dẫn phụ thuộc, tên hoặc URL?"

#. String in file picker and library dialogs
msgid "If you are adding a library that's built into MicroBlocks, you can just enter its name."
msgstr ""
"Nếu bạn đang thêm một thư viện được tích hợp vào MicroBlocks, bạn chỉ cần "
"nhập tên của nó."

#. String in file picker and library dialogs
msgid "If your library is in the Libraries folder in your local MicroBlocks project folder, you need to prefix it with a slash (/)."
msgstr ""
"Nếu thư viện của bạn nằm trong thư mục Thư viện trong thư mục dự án "
"MicroBlocks cục bộ của bạn, bạn cần thêm prefix vào dấu gạch chéo (/)."

#. String in file picker and library dialogs
msgid "If the library is hosted online, please input its full URL."
msgstr "Nếu thư viện được lưu trữ trực tuyến, vui lòng nhập URL đầy đủ của nó."

#. String in file picker and library dialogs
msgid "Tag name?"
msgstr "Tên thẻ?"

#. String in file picker and library dialogs
msgid "user library"
msgstr "thư viện người dùng"

#. String in file picker and library dialogs
msgid "Add Library"
msgstr "Thêm thư viện"

#. the %1 tag should be kept intact. Seconds remaining for a process to finish.
msgid "%1 seconds remaining"
msgstr "còn lại %1 giây"

#. Block size button tooltip
msgid "Decrease block size"
msgstr "Giảm kích thước khối"

#. Block size button tooltip
msgid "Restore block size to 100%"
msgstr "Khôi phục kích thước khối về 100%"

#. Block size button tooltip
msgid "Increase block size"
msgstr "Tăng kích thước khối"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Button"
msgstr "Nút"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Boolean Input"
msgstr "Đầu vào Boolean"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
msgid "[l] toggle value, or drop a reporter into it."
msgstr "[l] chuyển đổi giá trị hoặc thả người báo cáo vào đó."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Color Input"
msgstr "Đầu vào màu"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
msgid "[l] change the color, or drop a reporter into it."
msgstr "[l] thay đổi màu sắc, hoặc thả Viceng viên vào đó."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Input"
msgstr "Đầu vào"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
msgid "[l] edit its value, or drop a reporter into it."
msgstr "[l] chỉnh sửa giá trị của nó hoặc thả người báo cáo vào đó."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Block Extension"
msgstr "Chặn tiện ích mở rộng"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
msgid "[l] right arrow to show optional inputs, left arrow to hide."
msgstr "[l] mũi tên phải để hiển thị đầu vào tùy chọn, mũi tên trái để ẩn."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Command Block"
msgstr "Khối lệnh"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Hat Block"
msgstr "Khối mũ"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
#. The [r] tag turns into an icon of a mouse with the right button pressed
msgid "[l] to run, or drag to build scripts. [r] menu."
msgstr "[l] để chạy hoặc kéo để tạo tập lệnh. [r] thực đơn."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Reporter Block"
msgstr "Khối Viceng viên"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
#. The [r] tag turns into an icon of a mouse with the right button pressed
msgid "[l] to see value, or drop into an input slot. [r] menu."
msgstr "[l] để xem giá trị hoặc thả vào khe đầu vào. [r] thực đơn."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Script"
msgstr "Tập lệnh"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
#. The [r] tag turns into an icon of a mouse with the right button pressed
msgid "[l] to run. [r] menu."
msgstr "[l] để chạy. [r] thực đơn."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Pane Divider"
msgstr "Bộ chia ngăn"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Drag to change pane width."
msgstr "Kéo để thay đổi độ rộng của khung."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Library"
msgstr "Thư viện"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
#. The [r] tag turns into an icon of a mouse with the right button pressed
msgid "[l] to show the blocks in this library. [r] menu."
msgstr "[l] để hiển thị các khối trong thư viện này. [r] thực đơn."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Block Category"
msgstr "Chặn danh mục"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
msgid "[l] to show the blocks in this category."
msgstr "[l] để hiển thị các khối trong danh mục này."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Palette"
msgstr "Bảng màu"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Drag blocks from here to build scripts. Drop scripts here to delete them."
msgstr ""
"Kéo các khối từ đây để xây dựng tập lệnh. Thả tập lệnh vào đây để xóa chúng."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Scripts Pane"
msgstr "Ngăn tập lệnh"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [r] tag turns into an icon of a mouse with the right button pressed
msgid "Drag blocks here to build scripts. [r] menu."
msgstr "Kéo các khối vào đây để xây dựng tập lệnh. [r] thực đơn."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Turn the user LED on or off."
msgstr "Bật hoặc tắt đèn LED người dùng."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Display a bubble showing the value."
msgstr "Màn hình một bong bóng màn hình giá trị."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Graph the value."
msgstr "Vẽ đồ thị giá trị."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Report the state of button A ( (-o) or (o-) )."
msgstr "Báo cáo trạng thái của nút A ( (-o) hoặc (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Report the state of button B ( (-o) or (o-) )."
msgstr "Báo cáo trạng thái của nút B ( (-o) hoặc (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the milliseconds since the timer was last reset."
msgstr "Báo cáo mili giây kể từ khi bộ hẹn giờ được đặt lại lần cuối."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Reset the timer."
msgstr "Đặt lại bộ hẹn giờ."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the seconds since power up."
msgstr "Báo cáo số giây kể từ khi bật nguồn."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the milliseconds since power up."
msgstr "Báo cáo mili giây kể từ khi bật nguồn."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the microseconds since power up."
msgstr "Báo cáo micro giây kể từ khi bật nguồn."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the board type."
msgstr "Báo cáo loại bảng."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Reports firmware version loaded on the board."
msgstr "Báo cáo phiên bản phần sụn được tải trên bảng."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Reports the three-letter BLE ID of the board if it supports BLE."
msgstr "Báo cáo ID BLE gồm ba chữ cái của bảng nếu nó hỗ trợ BLE."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Reports (-o) if a BLE client is connected."
msgstr "Báo cáo (-o) nếu máy khách BLE được kết nối."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the milliseconds since the given start milliseconds. Handles clock wrap."
msgstr ""
"Báo cáo mili giây kể từ mili giây bắt đầu nhất định. Tay cầm bọc đồng hồ."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the microseconds since the given start microseconds. Handles clock wrap."
msgstr ""
"Báo cáo micro giây kể từ micro giây bắt đầu nhất định. Tay cầm bọc đồng hồ."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Reports (-o) if the board is connected to IDE."
msgstr "Báo cáo (-o) nếu bo mạch được kết nối với IDE."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Report the electrical logic level on a digital pin ( (-o) or (o-) )."
msgstr "Báo cáo mức logic điện trên chân kỹ thuật số ( (-o) hoặc (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a number proportional to the voltage on an analog pin (0 = ground, 1023 = supply voltage)."
msgstr ""
"Báo cáo một số tỷ lệ thuận với điện áp trên chân analog (0 = nối đất, 1023 = "
"điện áp nguồn)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Turn a pin on or off ( (-o) or (o-) )."
msgstr "Bật hoặc tắt ghim ( (-o) hoặc (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Pulse width modulate (PWM) a pin with the given duty cycle (0 - 1023)."
msgstr ""
"Điều chế độ rộng xung (PWM) một chân với chu kỳ nhiệm vụ nhất định (0 - 1023)"
"."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report number of analog pins on this device."
msgstr "Báo cáo số lượng chân analog trên thiết bị này."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report number of digital pins on this device."
msgstr "Báo cáo số lượng chân kỹ thuật số trên thiết bị này."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the value of a register (0-255) of an I2C device (0-127)."
msgstr "Báo cáo giá trị của một thanh ghi (0-255) của thiết bị I2C (0-127)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Set an I2C device and register to given value (0-255)."
msgstr "Đặt thiết bị I2C và đăng ký giá trị đã cho (0-255)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Receive multiple bytes from an I2C device."
msgstr "Nhận nhiều byte từ thiết bị I2C."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send multiple bytes to an I2C device."
msgstr "Gửi nhiều byte đến thiết bị I2C."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send a byte (0-255) to an SPI device."
msgstr "Gửi một byte (0-255) tới thiết bị SPI."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Read a byte from an SPI device while sending a zero byte. Report the byte received."
msgstr ""
"Đọc một byte từ thiết bị SPI trong khi gửi byte 0. Báo cáo byte nhận được."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Set the SPI clock speed, mode, channel (Raspberry Pi only), and bit order."
msgstr ""
"Đặt tốc độ xung nhịp SPI, chế độ, kênh (chỉ Raspberry Pi) và thứ tự bit."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send a byte array via SPI, replacing its contents with the bytes received."
msgstr ""
"Gửi một mảng byte qua SPI, thay thế nội dung của nó bằng byte nhận được."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Open the serial port at the given baud rate."
msgstr "Mở cổng nối tiếp ở tốc độ truyền nhất định."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Close the serial port."
msgstr "Đóng cổng nối tiếp."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report data received from the serial port (a byte array)."
msgstr "Báo cáo dữ liệu nhận được từ cổng nối tiếp (một mảng byte)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send a byte array to the serial port."
msgstr "Gửi một mảng byte tới cổng nối tiếp."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send a byte array to the serial port, starting at the given byte."
msgstr "Gửi một mảng byte tới cổng nối tiếp, bắt đầu từ byte đã cho."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Write a byte to the pin at the specified baud rate."
msgstr "Viết một byte vào pin ở tốc độ truyền được chỉ định."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Run when the board powers up or when the IDE start button is clicked."
msgstr "Chạy khi bo mạch bật nguồn hoặc khi nhấp vào nút khởi động IDE."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Run when buttons A, B, or A+B are pressed."
msgstr "Chạy khi nhấn nút A, B hoặc A+B."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Repeat the enclosed blocks indefinitely."
msgstr "Lặp lại các khối kèm theo vô thời hạn."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Repeat the enclosed blocks the given number of times."
msgstr "Lặp lại các khối kèm theo số lần nhất định."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Wait the given number of milliseconds."
msgstr "Đợi số mili giây đã cho."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Run the first set of blocks whose test condition is (-o) ."
msgstr "Chạy tập khối đầu tiên có điều kiện kiểm tra là (-o)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Run when the condition becomes (-o) ."
msgstr "Chạy khi điều kiện trở thành (-o) ."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Wait until the condition becomes (-o) ."
msgstr "Đợi cho đến khi điều kiện trở thành (-o) ."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Return (report) the given value from a function or script."
msgstr "Trả về (báo cáo) giá trị đã cho từ một hàm hoặc tập lệnh."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Run when the given message is received as a broadcast."
msgstr "Chạy khi tin nhắn đã cho được nhận dưới dạng phát sóng."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Broadcast the given message."
msgstr "Phát sóng tin nhắn đã cho."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Do nothing. Used to add notes and documentation."
msgstr "Không làm gì cả. Được sử dụng để thêm ghi chú và tài liệu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a list containing the given range of numbers (with optional increment). Useful in \"for\" loops."
msgstr ""
"Báo cáo danh sách chứa phạm vi số đã cho (với mức tăng tùy chọn). Hữu ích "
"trong vòng lặp \"for\"."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Repeat the enclosed blocks with the variable set to the current iteration number or item."
msgstr ""
"Lặp lại các khối kèm theo với biến được đặt thành số lần lặp hoặc mục hiện "
"tại."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Repeat the enclosed blocks until the condition becomes (-o) ."
msgstr "Lặp lại các khối kèm theo cho đến khi điều kiện trở thành (-o)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Stop this task."
msgstr "Dừng nhiệm vụ này."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Stop all tasks except this one."
msgstr "Dừng tất cả các nhiệm vụ ngoại trừ nhiệm vụ này."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Wait the given number of microseconds."
msgstr "Đợi số micro giây đã cho."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the last broadcast message received."
msgstr "Báo cáo tin nhắn quảng bá cuối cùng nhận được."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the given argument or defaultValue if the argument was not supplied by the caller."
msgstr ""
"Báo cáo đối số đã cho hoặc defaultValue nếu đối số đó không được người gọi "
"cung cấp."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Call the function with the given name and optional parameter list."
msgstr "Gọi hàm với tên đã cho và danh sách tham số tùy chọn."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Call the function with the given name and optional parameter list and report its return value."
msgstr ""
"Gọi hàm với tên đã cho và danh sách tham số tùy chọn rồi báo cáo giá trị trả "
"về của nó."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the sum of the given numbers."
msgstr "Báo cáo tổng các số đã cho."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the first number minus the second."
msgstr "Báo cáo số đầu tiên trừ đi số thứ hai."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the product of the given numbers."
msgstr "Báo cáo tích của các số đã cho."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the first number divided by the second."
msgstr "Báo cáo số đầu tiên chia cho số thứ hai."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the remainder of dividing the first number by the second."
msgstr "Báo cáo số dư khi chia số thứ nhất cho số thứ hai."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the absolute value of the given number (always >= 0)."
msgstr "Báo cáo giá trị tuyệt đối của số đã cho (luôn >= 0)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the minimum of the values."
msgstr "Báo cáo giá trị tối thiểu."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the maximum of the values."
msgstr "Báo cáo giá trị tối đa."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a randomly chosen number in the given range."
msgstr "Báo cáo một số được chọn ngẫu nhiên trong phạm vi nhất định."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the first value is less than the second one."
msgstr "Báo cáo (-o) nếu giá trị đầu tiên nhỏ hơn giá trị thứ hai."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the first value is less than or equal to the second one."
msgstr "Báo cáo (-o) nếu giá trị đầu tiên nhỏ hơn hoặc bằng giá trị thứ hai."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the two values are equal."
msgstr "Báo cáo (-o) nếu hai giá trị bằng nhau."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the two values are not equal."
msgstr "Báo cáo (-o) nếu hai giá trị không bằng nhau."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the first value is greater than or equal to the second one."
msgstr "Báo cáo (-o) nếu giá trị đầu tiên lớn hơn hoặc bằng giá trị thứ hai."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the first value is greater than the second one."
msgstr "Báo cáo (-o) nếu giá trị đầu tiên lớn hơn giá trị thứ hai."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Boolean constant ( (-o) or (o-) )."
msgstr "Hằng số Boolean ( (-o) hoặc (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Report the logical inverse of a Boolean ( (-o) or (o-) ) value."
msgstr "Báo cáo nghịch đảo logic của giá trị Boolean ( (-o) hoặc (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if both values are (-o)"
msgstr "Báo cáo (-o) nếu cả hai giá trị là (-o)"

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if either value is (-o)"
msgstr "Báo cáo (-o) nếu một trong hai giá trị là (-o)"

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if first input is a value of the given data type."
msgstr ""
"Báo cáo (-o) nếu đầu vào đầu tiên là giá trị của kiểu dữ liệu nhất định."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Convert a value to the given data type."
msgstr "Chuyển đổi một giá trị thành kiểu dữ liệu nhất định."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "If the condition is (-o) report the first alternative otherwise report the second alternative."
msgstr ""
"Nếu điều kiện là (-o) hãy báo cáo phương án thay thế đầu tiên, nếu không thì "
"báo cáo phương án thứ hai."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Map a value in the \"from\" range to the corresponding value in the \"to\" range."
msgstr ""
"Ánh xạ một giá trị trong phạm vi \"từ\" tới giá trị tương ứng trong phạm vi "
"\"đến\"."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the numerical value of a hexadecimal string (range: -0x1FFFFFFF to 0x1FFFFFFF)"
msgstr ""
"Báo cáo giá trị số của chuỗi thập lục phân (phạm vi: -0x1FFFFFFF đến "
"0x1FFFFFFF)"

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report bitwise AND of two numbers."
msgstr "Báo cáo theo bit AND của hai số."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report bitwise OR of two numbers."
msgstr "Báo cáo theo bit HOẶC của hai số."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report bitwise XOR (exclusive OR) of two numbers."
msgstr "Báo cáo XOR theo bit (OR độc quyền) của hai số."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report bitwise inverse of the given number."
msgstr "Báo cáo nghịch đảo bitwise của số đã cho."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the given number shifted left by the given number of bits."
msgstr "Báo cáo số đã cho được dịch chuyển sang trái theo số bit đã cho."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the given number shifted right by the given number of bits (arithmetic shift; sign is maintained)."
msgstr ""
"Báo cáo số đã cho được dịch sang phải theo số bit đã cho (sự dịch chuyển số "
"học; dấu được giữ nguyên)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Set a variable to the given value."
msgstr "Đặt một biến cho giá trị đã cho."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Change a variable by the given amount."
msgstr "Thay đổi một biến theo số tiền đã cho."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Create a variable local to the containing script with the given initial value."
msgstr "Tạo một biến cục bộ cho tập lệnh chứa với giá trị ban đầu đã cho."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the Nth item of a list, string, or byte array."
msgstr "Báo cáo mục thứ N của danh sách, chuỗi hoặc mảng byte."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the number of items in a list, string, or byte array."
msgstr "Báo cáo số mục trong danh sách, chuỗi hoặc mảng byte."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Join (concatenate) the given lists, strings, or byte arrays and report the result."
msgstr ""
"Nối (nối) các danh sách, chuỗi hoặc mảng byte đã cho và báo cáo kết quả."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Create and report a short list containing the given items. Length limited by available stack space."
msgstr ""
"Tạo và báo cáo một danh sách ngắn có chứa các mục nhất định. Độ dài bị giới "
"hạn bởi không gian ngăn xếp có sẵn."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Add an item to the end of a list."
msgstr "Thêm một mục vào cuối danh sách."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Replace the Nth item (or all items) of a list or byte array with the given value."
msgstr ""
"Thay thế mục thứ N (hoặc tất cả các mục) của danh sách hoặc mảng byte bằng "
"giá trị đã cho."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Delete the Nth item (or all items) of a list."
msgstr "Xóa mục thứ N (hoặc tất cả các mục) của danh sách."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Find and report the index of an item in a list or a substring within a string. Report -1 if not found."
msgstr ""
"Tìm kiếm và báo cáo chỉ mục của một mục trong danh sách hoặc chuỗi con trong "
"chuỗi. Báo cáo -1 nếu không tìm kiếm thấy."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a copy from the given index through the end (or optional stop index) of the given list, string, or byte array."
msgstr ""
"Báo cáo một bản sao từ chỉ mục đã cho đến cuối (hoặc chỉ mục dừng tùy chọn) "
"của danh sách, chuỗi hoặc mảng byte đã cho."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Split the given string with the given delimiter and report the result (a list of strings)."
msgstr ""
"Tách chuỗi đã cho bằng dấu phân cách đã cho và báo cáo kết quả (danh sách "
"các chuỗi)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Combine the items of a list into a string, optionally separated by a delimiter (e.g. comma)."
msgstr ""
"Kết hợp các mục của danh sách thành một chuỗi, tùy ý phân tách bằng dấu phân "
"cách (ví dụ: dấu phẩy)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the Unicode value (\"code point\") of the Nth character of the given string."
msgstr "Báo cáo giá trị Unicode (\"điểm mã\") của ký tự thứ N của chuỗi đã cho."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a string containing the given Unicode value (\"code point\") or list of values."
msgstr ""
"Báo cáo một chuỗi chứa giá trị Unicode đã cho (\"điểm mã\") hoặc danh sách "
"các giá trị."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a new list of the given length filled with zero or the optional value."
msgstr ""
"Báo cáo danh sách mới có độ dài nhất định được điền bằng 0 hoặc giá trị tùy "
"chọn."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a new byte array of the given length filled with zero or the optional value."
msgstr ""
"Báo cáo một mảng byte mới có độ dài nhất định được điền bằng 0 hoặc giá trị "
"tùy chọn."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a byte array containing the UTF-8 bytes of the given string."
msgstr "Báo cáo một mảng byte chứa byte UTF-8 của chuỗi đã cho."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the number of words of memory available. Stop button frees up memory."
msgstr "Báo cáo số lượng từ bộ nhớ có sẵn. Nút dừng giải Viceng bộ nhớ."

#. Option in dropdown menu of editable input slots on mobile devices:
msgid "edit"
msgstr "chỉnh sửa"

#. NeoPixel library block
msgid "set NeoPixels #BR# _ _ _ _ _ #BR# _ _ _ _ _ #BR# _ _ _ _ _ #BR# _ _ _ _ _ #BR# _ _ _ _ _"
msgstr "đặt NeoPixels #BR# _"

#. NeoPanel library block
msgid "NeoPanel draw line from x _ y _ to x _ y _ color _"
msgstr "NeoPanel vẽ đường từ x _ y _ đến x _ y _ màu _"

#. NeoPanel library block
msgid "NeoPanel draw circle at x _ y _ radius _ color _"
msgstr "NeoPanel vẽ hình tròn tại x _ y _ bán kính _ màu _"

#. NeoPanel library block
msgid "NeoPanel draw rectangle at x _ y _ width _ height _ color _"
msgstr "NeoPanel vẽ hình chữ nhật theo x _ y _ chiều rộng _ chiều cao _ màu _"

#. Microphone library block
msgid "turn off microphone"
msgstr "tắt micrô"

#. OLED Graphics library block
msgid "initialize i2c(auto) reset pin# _ flip _"
msgstr "khởi tạo pin đặt lại i2c (tự động) # _ lật _"

#. Fractions library block
msgid "fract _ − _"
msgstr "phân số _ − _"

#. Files library block
msgid "contents of file _"
msgstr "nội dung của tệp _"

#. WiFi library block
msgid "wifi set local domain name _ .local"
msgstr "wifi đặt tên miền cục bộ _ .local"

#. micro:STEAMakers library block
msgid "ms pin _ touched?"
msgstr "ms pin _ chạm vào?"

#. micro:STEAMakers library block
msgid "ms accel _ m/s2"
msgstr "gia tốc ms _ m/s2"

#. micro:STEAMakers library block
msgid "ms gyro _ deg/s"
msgstr "con quay hồi chuyển ms _ độ/s"

#. Generic robot side input. Used in robot libraries
#. as in "left" side
msgid "left"
msgstr "bên trái"

#. Generic robot side input. Used in robot libraries
#. as in "right" side
msgid "right"
msgstr "phải"

#. Generic robot side input. Used in robot libraries
#. as in "both" sides
msgid "both"
msgstr "cả hai"

#. Generic servo type
msgid "180°"
msgstr "180°"

#. Generic servo type
msgid "270°"
msgstr "270°"

#. Generic servo type
msgid "360°"
msgstr "360°"

#. Octostudio shape names
msgid "octo;circle"
msgstr "vòng tròn"

#. Octostudio shape names
msgid "octo;square"
msgstr "quảng trường"

#. Octostudio shape names
msgid "octo;star"
msgstr "ngôi sao"

#. Octostudio shape names
msgid "octo;heart"
msgstr "trái tim"

#. Octostudio shape names
