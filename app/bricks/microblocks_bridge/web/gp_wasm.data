    pb_set_motor_speed 1 50
    waitMillis 1000
    setServoAngle _pb_pin_Motor2 90
    pb_set_motor_speed 1 75
    waitMillis 1000
    pb_set_motor_speed 1 0
    waitMillis 200
  }
}
}

