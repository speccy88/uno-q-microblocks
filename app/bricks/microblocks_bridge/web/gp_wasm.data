  'play tone' 'C' 2 250
  'play tone' 'B' 1 400
  waitMillis 100
  'play tone' 'C' 2 250
  'play tone' 'D' 2 250
  'play tone' 'G' 1 400
  waitMillis 100
  'play tone' 'A' 1 250
  'play tone' 'B' 1 250
  'play tone' 'C' 2 400
  waitMillis 100
