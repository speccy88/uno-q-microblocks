'trigger event' 'Button double-pressed'
setUserLED true
waitMillis 100
setUserLED false
waitMillis 100
setUserLED true
waitMillis 100
setUserLED false
}

script 61 367 {
whenCondition ('button long pressed' 'A')
'trigger event' 'Button long-pressed'
