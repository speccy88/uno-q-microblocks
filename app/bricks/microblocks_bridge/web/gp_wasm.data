msgstr "Nezha2"

#. NeZha2 robot library block
msgid "Nezha stop all motors"
msgstr "Nezha zastav všechny motory"

#. NeZha2 robot library block
msgid "brightness _ %"
msgstr "NeZha jas _ %"

#. File System library block
#, fuzzy
msgid "skip _ bytes of file _"
msgstr "přeskoč _ bajtů souboru _"

#. NeZha2 robot library block
msgid "Nezha beep _ Hz for _ msecs"
msgstr "Nezha tón _ Hz po dobu _ ms"

#. NeZha2 robot library block
msgid "Nezha set _ servo _ angle to _"
msgstr "Nezha nastav servo _ _ na úhel _ stupňů"

#. NeZha2 robot library block
msgid "Nezha trim pot _"
msgstr "Nezha potenciometr _"

#. NeZha2 robot library block
msgid "Nezha set all LEDs to _"
msgstr "Nezha nastav všechny LED na _"

#. NeZha2 robot library block
msgid "Nezha set LED _ to _"
msgstr "Nezha nastav LED _ na _"

#. NeZha2 robot library block
msgid "Nezha set continuous servo _ speed to _ (-100 to 100)"
msgstr "Nezha nastav kontinuální servo _ rychlost _ (-100 až 100)"

#. NeZha2 robot library block
msgid "Nezha stop motor _"
msgstr "Nezha zastav motor _"

#. NeZha2 robot library block
msgid "Nezha crash sensor _"
msgstr "Nezha senzor nárazu _"

#. NeZha2 robot library block
msgid "Nezha read analog _"
msgstr "Nezha přečíst analogový vstup _"

#. CoCube Module library block
msgid "power on module"
msgstr "zapnout modul"

#. NeZha2 robot library block
msgid "Nezha line sensor _ sees line on left _ right _"
msgstr "Nezha senzor čáry _ vidí čáru vlevo _ vpravo _"

#. File System library block
