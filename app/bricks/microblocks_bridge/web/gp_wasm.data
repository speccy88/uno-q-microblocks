#. Variable right-click context menu
msgid "find variable accessors"
msgstr "بحث عن وصول المتغير"

#. Variable right-click context menu tooltip
msgid "find scripts or block definitions where this variable is being read"
msgstr "البحث عن نصوص برمجية أو تعريفات لبنات حيث يتم قراءة هذا المتغير"

#. Variable right-click context menu
msgid "find variable modifiers"
msgstr "البحث عن معدّلات المتغير"

#. Variable right-click context menu tooltip
msgid "find scripts or block definitions where this variable is being set or changed"
msgstr ""
"البحث عن نصوص برمجية أو تعريفات لبنات حيث يتم تعيين أو تغيير هذا المتغير"

#. Block right-click context menu
msgid "find uses of this block"
msgstr "البحث عن استخدامات هذه اللبنة"

#. Block right-click context menu tooltip
msgid "find scripts or block definitions using this block"
msgstr "البحث عن نصوص برمجية أو تعريفات لبنات تستخدم هذه اللبنة"

#. Block right-click context menu
msgid "show block definition..."
msgstr "إظهار تعريف اللبنة..."

#. Block right-click context menu tooltip
msgid "show the definition of this block"
msgstr "إظهار تعريف هذه اللبنة"

#. Block right-click context menu
msgid "delete block definition..."
msgstr "حذف تعريف اللبنة..."

#. Block right-click context menu tooltip
msgid "delete the definition of this block"
msgstr "حذف تعريف هذه اللبنة"

#. Block right-click context menu
msgid "help"
msgstr "مساعدة"

#. Block right-click context menu
msgid "duplicate this block"
msgstr "مضاعفة هذه اللبنة"

#. Block right-click context menu
msgid "delete block"
msgstr "حذف اللبنة"

#. Block right-click context menu tooltip
msgid "delete this block"
msgstr "حذف هذه اللبنة"

#. Block right-click context menu
msgid "copy to clipboard"
msgstr "نسخ إلى الحافظة"

#. Block right-click context menu
msgid "copy to clipboard as URL"
msgstr "نسخ إلى الحافظة كرابط URL"

#. Block right-click context menu tooltip
msgid "copy these blocks to the clipboard as a URL"
msgstr "نسخ هذه اللبنات إلى الحافظة كرابط URL"

#. Block right-click context menu tooltip
msgid "copy these blocks to the clipboard"
msgstr "نسخ هذه اللبنات إلى الحافظة"

#. Block right-click context menu
msgid "duplicate all"
msgstr "مضاعفة الكل"

#. Block right-click context menu tooltip
msgid "duplicate these blocks"
msgstr "مضاعفة هذه اللبنات"

#. Block right-click context menu
msgid "extract block"
msgstr "استخراج اللبنة"

#. Block right-click context menu tooltip
msgid "pull out this block"
msgstr "سحب هذه اللبنة"

#. Block right-click context menu tooltip
msgid "show help for this block in a browser"
msgstr "إظهار المساعدة لهذه اللبنة في المتصفح"

#. Script right-click context menu
msgid "save picture of script with result"
msgstr "حفظ صورة للنص البرمجي مع النتيجة"

#. Script right-click context menu tooltip
msgid "save a picture of this block definition as a PNG file"
msgstr "حفظ صورة لتعريف اللبنة هذا كملف PNG"

#. Script right-click context menu tooltip
msgid "save a picture of these blocks as a PNG file"
msgstr "حفظ صورة لهذه اللبنات كملف PNG"

#. Script right-click context menu tooltip
msgid "save a picture of these blocks and their result as a PNG file"
msgstr "حفظ صورة لهذه اللبنات ونتيجتها كملف PNG"

#. Slot type menu option
msgid "string or number"
msgstr "سلسلة أو رقم"

#. Slot type menu option
msgid "number only"
msgstr "رقم فقط"

#. Slot type menu option
msgid "string only"
msgstr "سلسلة فقط"

#. Text right-click context menu option
msgid "stop editing"
msgstr "إيقاف التعديل"

#. Text right-click context menu option
msgid "cut"
msgstr "قص"

#. Text right-click context menu option
msgid "copy"
msgstr "نسخ"

#. Text right-click context menu option
msgid "paste"
msgstr "لصق"

#. Text right-click context menu option
msgid "accept"
msgstr "قبول"

#. Text right-click context menu option
msgid "revert"
msgstr "تراجع"

#. Block input right-click context menu option
msgid "select all"
msgstr "تحديد الكل"

#. Block input right-click context menu option
msgid "define"
msgstr "تعريف"

#. Block input right-click context menu option
msgid "number/string"
msgstr "رقم/سلسلة"

#. Block input right-click context menu option
msgid "editable number or string"
msgstr "رقم أو سلسلة قابلة للتعديل"

#. Block part type, while making a new block
msgid "label"
msgstr "تسمية"

#. Block part type, while making a new block
msgid "input"
msgstr "إدخال"

#. Block definition right-click context menu option
msgid "hide block definition"
msgstr "إخفاء تعريف اللبنة"

#. Language menu tooltip
msgid "Language"
msgstr "اللغة"

#. Language menu item. Takes the user to documentation about adding a missing language
msgid "Missing language?"
msgstr "هل تفتقد لغة؟"

#. As in load a "Custom" language file
msgid "Custom..."
msgstr "مخصص..."

#. Button
msgid "OK"
msgstr "موافق"

#. Library folder
msgid "LIBRARIES"
msgstr "المكتبات"

#. Library folder
msgid "folder;AI"
msgstr "الذكاء الاصطناعي"

#. Library folder
msgid "folder;Graphics and Displays"
msgstr "الرسومات والشاشات"

#. Library folder
msgid "folder;Kits and Boards"
msgstr "الأطقم واللوحات"

#. Library folder
msgid "folder;Network"
msgstr "الشبكة"

#. Library folder
msgid "folder;Motors"
msgstr "المحركات"

#. Library folder
msgid "folder;Other"
msgstr "أخرى"

#. Library folder
msgid "folder;Robots"
msgstr "الروبوتات"

#. Library folder
msgid "folder;Sensing"
msgstr "الاستشعار"

#. Library folder
msgid "folder;Sound"
msgstr "الصوت"

#. Library folder
msgid "folder;System"
msgstr "النظام"

#. Library folder
msgid "folder;WorkInProgress"
msgstr "العمل قيد التقدم"

#. String in file picker and library dialogs
msgid "New library name?"
msgstr "اسم المكتبة الجديد؟"

#. Scripting area right-click context menu
msgid "show all block definitions"
msgstr "إظهار جميع تعريفات اللبنات"

#. Scripting area right-click context menu
msgid "hide all block definitions"
msgstr "إخفاء جميع تعريفات اللبنات"

#. Library label right click context menu option
msgid "export this library"
msgstr "تصدير هذه المكتبة"

#. Library label right click context menu option
msgid "delete library"
msgstr "حذف المكتبة"

#. Project source folder
msgid "Examples"
msgstr "أمثلة"

#. Project source folder
msgid "Desktop"
msgstr "سطح المكتب"

#. Project source folder
msgid "Computer"
msgstr "الكمبيوتر"

#. Project source
msgid "Cloud"
msgstr "السحابة"

#. String in file picker and library dialogs
msgid "File"
msgstr "ملف"

#. String in file picker and library dialogs
msgid "New Folder"
msgstr "مجلد جديد"

#. String in file picker and library dialogs
#. as in dependencies of this library
msgid "Depends:"
msgstr "يعتمد على:"

#. String in file picker and library dialogs
msgid "Tags:"
msgstr "العلامات:"

#. String in file picker and library dialogs
msgid "Path, name or URL for library?"
msgstr "المسار أو الاسم أو رابط URL للمكتبة؟"

#. String in file picker and library dialogs
msgid "Invalid URL"
msgstr "رابط URL غير صالح"

#. String in file picker and library dialogs
msgid "Could not fetch library."
msgstr "تعذر جلب المكتبة."

#. String in file picker and library dialogs
msgid "Host does not exist or is currently down."
msgstr "المضيف غير موجود أو معطل حاليًا."

#. String in file picker and library dialogs
msgid "File not found in server."
msgstr "الملف غير موجود في الخادم."

#. String in file picker and library dialogs
msgid "Server expects HTTPS, and MicroBlocks doesn't currently support it."
msgstr "يتوقع الخادم HTTPS، و MicroBlocks لا يدعمه حاليًا."

#. String in file picker and library dialogs
msgid "library information"
msgstr "معلومات المكتبة"

#. String in file picker and library dialogs
msgid "built-in library"
msgstr "مكتبة مدمجة"

#. String in file picker and library dialogs
msgid "Dependency path, name or URL?"
msgstr "مسار التبعية أو الاسم أو رابط URL؟"

#. String in file picker and library dialogs
msgid "If you are adding a library that's built into MicroBlocks, you can just enter its name."
msgstr "إذا كنت تضيف مكتبة مدمجة في MicroBlocks، فيمكنك فقط إدخال اسمها."

#. String in file picker and library dialogs
msgid "If your library is in the Libraries folder in your local MicroBlocks project folder, you need to prefix it with a slash (/)."
msgstr ""
"إذا كانت مكتبتك في مجلد المكتبات في مجلد مشروع MicroBlocks المحلي، فيجب أن "
"تسبقها بشرطة مائلة (/)."

#. String in file picker and library dialogs
msgid "If the library is hosted online, please input its full URL."
msgstr ""
"إذا كانت المكتبة مستضافة عبر الإنترنت، يرجى إدخال الرابط الكامل (URL) الخاص "
"بها."

#. String in file picker and library dialogs
msgid "Tag name?"
msgstr "اسم العلامة؟"

#. String in file picker and library dialogs
msgid "user library"
msgstr "مكتبة المستخدم"

#. String in file picker and library dialogs
msgid "Add Library"
msgstr "إضافة مكتبة"

#. the %1 tag should be kept intact. Seconds remaining for a process to finish.
msgid "%1 seconds remaining"
msgstr "%1 ثانية متبقية"

#. Block size button tooltip
msgid "Decrease block size"
msgstr "تصغير حجم اللبنة"

#. Block size button tooltip
msgid "Restore block size to 100%"
msgstr "استعادة حجم اللبنة إلى 100%"

#. Block size button tooltip
msgid "Increase block size"
msgstr "تكبير حجم اللبنة"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Button"
msgstr "زر"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Boolean Input"
msgstr "إدخال منطقي"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
msgid "[l] toggle value, or drop a reporter into it."
msgstr "[l] تبديل القيمة، أو إسقاط إبلاغ فيها."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Color Input"
msgstr "إدخال اللون"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
msgid "[l] change the color, or drop a reporter into it."
msgstr "[l] تغيير اللون، أو إسقاط إبلاغ فيه."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
msgid "[l] edit its value, or drop a reporter into it."
msgstr "[l] تعديل قيمته، أو إسقاط إبلاغ فيه."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Block Extension"
msgstr "امتداد اللبنة"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
msgid "[l] right arrow to show optional inputs, left arrow to hide."
msgstr "[l] السهم الأيمن لإظهار المدخلات الاختيارية، السهم الأيسر لإخفائها."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Command Block"
msgstr "لبنة أمر"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Hat Block"
msgstr "لبنة بداية (Hat)"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
#. The [r] tag turns into an icon of a mouse with the right button pressed
msgid "[l] to run, or drag to build scripts. [r] menu."
msgstr "[l] للتشغيل، أو السحب لبناء نصوص برمجية. [r] قائمة."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Reporter Block"
msgstr "لبنة إبلاغ"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
#. The [r] tag turns into an icon of a mouse with the right button pressed
msgid "[l] to see value, or drop into an input slot. [r] menu."
msgstr "[l] لرؤية القيمة، أو الإسقاط في خانة إدخال. [r] قائمة."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Script"
msgstr "نص برمجي"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
#. The [r] tag turns into an icon of a mouse with the right button pressed
msgid "[l] to run. [r] menu."
msgstr "[l] للتشغيل. [r] قائمة."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Pane Divider"
msgstr "مقسم الأجزاء"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Drag to change pane width."
msgstr "السحب لتغيير عرض الجزء."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
#. The [r] tag turns into an icon of a mouse with the right button pressed
msgid "[l] to show the blocks in this library. [r] menu."
msgstr "[l] لإظهار اللبنات في هذه المكتبة. [r] قائمة."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Block Category"
msgstr "فئة اللبنات"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
msgid "[l] to show the blocks in this category."
msgstr "[l] لإظهار اللبنات في هذه الفئة."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Palette"
msgstr "لوحة (Palette)"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Drag blocks from here to build scripts. Drop scripts here to delete them."
msgstr "اسحب اللبنات من هنا لبناء نصوص برمجية. أسقط النصوص البرمجية هنا لحذفها."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Scripts Pane"
msgstr "جزء النصوص البرمجية"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [r] tag turns into an icon of a mouse with the right button pressed
msgid "Drag blocks here to build scripts. [r] menu."
msgstr "اسحب اللبنات هنا لبناء نصوص برمجية. [r] قائمة."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Turn the user LED on or off."
msgstr "تشغيل أو إيقاف تشغيل LED الخاص بالمستخدم."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Display a bubble showing the value."
msgstr "عرض فقاعة توضح القيمة."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Graph the value."
msgstr "رسم بياني للقيمة."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Report the state of button A ( (-o) or (o-) )."
msgstr "إبلاغ عن حالة الزر A ( (-o) أو (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Report the state of button B ( (-o) or (o-) )."
msgstr "إبلاغ عن حالة الزر B ( (-o) أو (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the milliseconds since the timer was last reset."
msgstr "الإبلاغ عن المللي ثانية منذ آخر إعادة تعيين للمؤقت."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Reset the timer."
msgstr "إعادة تعيين المؤقت."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the seconds since power up."
msgstr "الإبلاغ عن الثواني منذ بدء التشغيل."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the milliseconds since power up."
msgstr "الإبلاغ عن المللي ثانية منذ بدء التشغيل."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the microseconds since power up."
msgstr "الإبلاغ عن الميكروثانية منذ بدء التشغيل."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the board type."
msgstr "إبلاغ عن نوع اللوحة."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Reports firmware version loaded on the board."
msgstr "إبلاغ عن إصدار البرنامج الثابت المحمل على اللوحة."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Reports the three-letter BLE ID of the board if it supports BLE."
msgstr "يبلغ عن معرف BLE المكون من ثلاثة أحرف للوحة إذا كانت تدعم BLE."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Reports (-o) if a BLE client is connected."
msgstr "يبلغ (-o) إذا كان عميل BLE متصلاً."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the milliseconds since the given start milliseconds. Handles clock wrap."
msgstr ""
"يبلغ عن المللي ثانية منذ بدء المللي ثانية المحددة. يتعامل مع دوران الساعة."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the microseconds since the given start microseconds. Handles clock wrap."
msgstr ""
"يبلغ عن الميكروثانية منذ بدء الميكروثانية المحددة. يتعامل مع دوران الساعة."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Reports (-o) if the board is connected to IDE."
msgstr "يبلغ (-o) إذا كانت اللوحة متصلة ببيئة التطوير (IDE)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Report the electrical logic level on a digital pin ( (-o) or (o-) )."
msgstr "يبلغ عن المستوى المنطقي الكهربائي على منفذ رقمي ( (-o) أو (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a number proportional to the voltage on an analog pin (0 = ground, 1023 = supply voltage)."
msgstr ""
"يبلغ عن رقم يتناسب مع الجهد على منفذ تناظري (0 = أرضي، 1023 = جهد الإمداد)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Turn a pin on or off ( (-o) or (o-) )."
msgstr "تشغيل أو إيقاف تشغيل المنفذ ( (-o) أو (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Pulse width modulate (PWM) a pin with the given duty cycle (0 - 1023)."
msgstr "تعديل عرض النبضة (PWM) لمنفذ بدورة العمل المحددة (0 - 1023)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report number of analog pins on this device."
msgstr "يبلغ عن عدد المنافذ التناظرية في هذا الجهاز."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report number of digital pins on this device."
msgstr "يبلغ عن عدد المنافذ الرقمية في هذا الجهاز."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the value of a register (0-255) of an I2C device (0-127)."
msgstr "يبلغ عن قيمة سجل (0-255) لجهاز I2C (0-127)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Set an I2C device and register to given value (0-255)."
msgstr "يعين جهاز I2C ويسجل للقيمة المحددة (0-255)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Receive multiple bytes from an I2C device."
msgstr "استقبال بايتات متعددة من جهاز I2C."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send multiple bytes to an I2C device."
msgstr "إرسال بايتات متعددة إلى جهاز I2C."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send a byte (0-255) to an SPI device."
msgstr "إرسال بايت (0-255) إلى جهاز SPI."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Read a byte from an SPI device while sending a zero byte. Report the byte received."
msgstr "قراءة بايت من جهاز SPI أثناء إرسال بايت صفري. يبلغ عن البايت المستلم."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Set the SPI clock speed, mode, channel (Raspberry Pi only), and bit order."
msgstr "يعين سرعة ساعة SPI والوضع والقناة (Raspberry Pi فقط) وترتيب البتات."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send a byte array via SPI, replacing its contents with the bytes received."
msgstr "إرسال مصفوفة بايتات عبر SPI، واستبدال محتوياتها بالبايتات المستلمة."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Open the serial port at the given baud rate."
msgstr "فتح المنفذ التسلسلي بمعدل الباود المحدد."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Close the serial port."
msgstr "إغلاق المنفذ التسلسلي."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report data received from the serial port (a byte array)."
msgstr "يبلغ عن البيانات المستلمة من المنفذ التسلسلي (مصفوفة بايتات)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send a byte array to the serial port."
msgstr "إرسال مصفوفة بايتات إلى المنفذ التسلسلي."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send a byte array to the serial port, starting at the given byte."
msgstr "إرسال مصفوفة بايتات إلى المنفذ التسلسلي، بدءًا من البايت المحدد."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Write a byte to the pin at the specified baud rate."
msgstr "كتابة بايت إلى المنفذ بمعدل الباود المحدد."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Run when the board powers up or when the IDE start button is clicked."
msgstr ""
"يتم التشغيل عند تشغيل اللوحة أو عند النقر فوق زر البدء في بيئة التطوير (IDE)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Run when buttons A, B, or A+B are pressed."
msgstr "يتم التشغيل عند الضغط على الأزرار A أو B أو A+B."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Repeat the enclosed blocks indefinitely."
msgstr "يكرر اللبنات المضمنة إلى أجل غير مسمى."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Repeat the enclosed blocks the given number of times."
msgstr "يكرر اللبنات المضمنة لعدد المرات المحدد."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Wait the given number of milliseconds."
msgstr "ينتظر العدد المحدد من المللي ثانية."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Run the first set of blocks whose test condition is (-o) ."
msgstr "يشغل المجموعة الأولى من اللبنات التي يكون شرط اختبارها هو (-o) ."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Run when the condition becomes (-o) ."
msgstr "يتم التشغيل عندما يصبح الشرط (-o) ."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Wait until the condition becomes (-o) ."
msgstr "ينتظر حتى يصبح الشرط (-o) ."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Return (report) the given value from a function or script."
msgstr "إرجاع (الإبلاغ عن) القيمة المحددة من دالة أو نص برمجي."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Run when the given message is received as a broadcast."
msgstr "يتم التشغيل عند تلقي الرسالة المحددة كبث."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Broadcast the given message."
msgstr "بث الرسالة المحددة."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Do nothing. Used to add notes and documentation."
msgstr "لا تفعل شيئا. تستخدم لإضافة الملاحظات والوثائق."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a list containing the given range of numbers (with optional increment). Useful in \"for\" loops."
msgstr ""
"يبلغ عن قائمة تحتوي على النطاق المحدد من الأرقام (مع زيادة اختيارية). مفيدة "
"في حلقات \"for\"."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Repeat the enclosed blocks with the variable set to the current iteration number or item."
msgstr ""
"يكرر اللبنات المضمنة مع تعيين المتغير لرقم التكرار الحالي أو العنصر الحالي."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Repeat the enclosed blocks until the condition becomes (-o) ."
msgstr "يكرر اللبنات المضمنة حتى يصبح الشرط (-o) ."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Stop this task."
msgstr "يوقف هذه المهمة."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Stop all tasks except this one."
msgstr "يوقف جميع المهام باستثناء هذه المهمة."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Wait the given number of microseconds."
msgstr "ينتظر العدد المحدد من الميكروثانية."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the last broadcast message received."
msgstr "يبلغ عن آخر رسالة بث تم تلقيها."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the given argument or defaultValue if the argument was not supplied by the caller."
msgstr ""
"يبلغ عن الوسيطة المحددة أو القيمة الافتراضية إذا لم يتم توفير الوسيطة بواسطة "
"المستدعي."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Call the function with the given name and optional parameter list."
msgstr "يستدعي الدالة بالاسم المحدد وقائمة المعلمات الاختيارية."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Call the function with the given name and optional parameter list and report its return value."
msgstr ""
"يستدعي الدالة بالاسم المحدد وقائمة المعلمات الاختيارية ويبلغ عن قيمة الإرجاع "
"الخاصة بها."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the sum of the given numbers."
msgstr "يبلغ عن مجموع الأرقام المحددة."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the first number minus the second."
msgstr "يبلغ عن الرقم الأول ناقص الثاني."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the product of the given numbers."
msgstr "يبلغ عن حاصل ضرب الأرقام المحددة."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the first number divided by the second."
msgstr "يبلغ عن الرقم الأول مقسومًا على الثاني."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the remainder of dividing the first number by the second."
msgstr "يبلغ عن باقي قسمة الرقم الأول على الثاني."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the absolute value of the given number (always >= 0)."
msgstr "يبلغ عن القيمة المطلقة للرقم المحدد (دائمًا >= 0)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the minimum of the values."
msgstr "يبلغ عن الحد الأدنى للقيم."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the maximum of the values."
msgstr "يبلغ عن الحد الأقصى للقيم."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a randomly chosen number in the given range."
msgstr "يبلغ عن رقم تم اختياره عشوائيًا في النطاق المحدد."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the first value is less than the second one."
msgstr "يبلغ (-o) إذا كانت القيمة الأولى أقل من الثانية."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the first value is less than or equal to the second one."
msgstr "يبلغ (-o) إذا كانت القيمة الأولى أقل من أو تساوي الثانية."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the two values are equal."
msgstr "يبلغ (-o) إذا كانت القيمتان متساويتين."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the two values are not equal."
msgstr "يبلغ (-o) إذا كانت القيمتان غير متساويتين."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the first value is greater than or equal to the second one."
msgstr "يبلغ (-o) إذا كانت القيمة الأولى أكبر من أو تساوي الثانية."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the first value is greater than the second one."
msgstr "يبلغ (-o) إذا كانت القيمة الأولى أكبر من الثانية."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Boolean constant ( (-o) or (o-) )."
msgstr "ثابت منطقي ( (-o) أو (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Report the logical inverse of a Boolean ( (-o) or (o-) ) value."
msgstr "يبلغ عن المعكوس المنطقي لقيمة منطقية ( (-o) أو (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if both values are (-o)"
msgstr "يبلغ (-o) إذا كانت كلتا القيمتين (-o)"

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if either value is (-o)"
msgstr "يبلغ (-o) إذا كانت أي من القيمتين (-o)"

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if first input is a value of the given data type."
msgstr "يبلغ (-o) إذا كان الإدخال الأول يمثل قيمة من نوع البيانات المحدد."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Convert a value to the given data type."
msgstr "تحويل القيمة إلى نوع البيانات المحدد."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "If the condition is (-o) report the first alternative otherwise report the second alternative."
msgstr ""
"إذا كان الشرط هو (-o) يبلغ عن البديل الأول وإلا فإنه يبلغ عن البديل الثاني."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Map a value in the \"from\" range to the corresponding value in the \"to\" range."
msgstr "يعين قيمة في نطاق \"من\" إلى القيمة المقابلة في نطاق \"إلى\"."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the numerical value of a hexadecimal string (range: -0x1FFFFFFF to 0x1FFFFFFF)"
msgstr ""
"يبلغ عن القيمة العددية لسلسلة سداسية عشرية (النطاق: -0x1FFFFFFF إلى "
"0x1FFFFFFF)"

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report bitwise AND of two numbers."
msgstr "يبلغ عن عملية AND على مستوى البت لعددين."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report bitwise OR of two numbers."
msgstr "يبلغ عن عملية OR على مستوى البت لعددين."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report bitwise XOR (exclusive OR) of two numbers."
msgstr "يبلغ عن عملية XOR (OR حصري) على مستوى البت لعددين."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report bitwise inverse of the given number."
msgstr "يبلغ عن المعكوس على مستوى البت للرقم المحدد."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the given number shifted left by the given number of bits."
msgstr "يبلغ عن الرقم المحدد مزاحًا لليسار بعدد البتات المحدد."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the given number shifted right by the given number of bits (arithmetic shift; sign is maintained)."
msgstr ""
"يبلغ عن الرقم المحدد مزاحًا لليمين بعدد البتات المحدد (إزاحة حسابية؛ يتم "
"الحفاظ على الإشارة)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Set a variable to the given value."
msgstr "تعيين متغير للقيمة المحددة."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Change a variable by the given amount."
msgstr "تغيير المتغير بالمقدار المحدد."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Create a variable local to the containing script with the given initial value."
msgstr "ينشئ متغيرًا محليًا للنص البرمجي الذي يحتويه مع القيمة الأولية المحددة."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the Nth item of a list, string, or byte array."
msgstr "يبلغ عن العنصر N من قائمة أو سلسلة أو مصفوفة بايتات."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the number of items in a list, string, or byte array."
msgstr "يبلغ عن عدد العناصر في قائمة أو سلسلة أو مصفوفة بايتات."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Join (concatenate) the given lists, strings, or byte arrays and report the result."
msgstr ""
"ينضم (يسلسل) القوائم أو السلاسل أو مصفوفات البايتات المحددة ويبلغ عن النتيجة."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Create and report a short list containing the given items. Length limited by available stack space."
msgstr ""
"ينشئ ويبلغ عن قائمة قصيرة تحتوي على العناصر المحددة. الطول محدود بمساحة "
"المكدس المتاحة."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Add an item to the end of a list."
msgstr "يضيف عنصرًا إلى نهاية القائمة."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Replace the Nth item (or all items) of a list or byte array with the given value."
msgstr ""
"يستبدل العنصر N (أو جميع العناصر) في قائمة أو مصفوفة بايتات بالقيمة المحددة."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Delete the Nth item (or all items) of a list."
msgstr "يحذف العنصر N (أو جميع العناصر) من القائمة."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Find and report the index of an item in a list or a substring within a string. Report -1 if not found."
msgstr ""
"يبحث ويبلغ عن فهرس عنصر في قائمة أو سلسلة فرعية ضمن سلسلة. يبلغ -1 إذا لم "
"يتم العثور عليه."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a copy from the given index through the end (or optional stop index) of the given list, string, or byte array."
msgstr ""
"يبلغ عن نسخة من الفهرس المحدد حتى النهاية (أو فهرس التوقف الاختياري) للقائمة "
"أو السلسلة أو مصفوفة البايتات المحددة."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Split the given string with the given delimiter and report the result (a list of strings)."
msgstr ""
"يقسم السلسلة المحددة بالمحدد المحدد ويبلغ عن النتيجة (قائمة من السلاسل)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Combine the items of a list into a string, optionally separated by a delimiter (e.g. comma)."
msgstr "يجمع عناصر القائمة في سلسلة، مفصولة اختياريًا بمحدد (مثل الفاصلة)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the Unicode value (\"code point\") of the Nth character of the given string."
msgstr "يبلغ عن قيمة يونيكود (\"نقطة الرمز\") للحرف N في السلسلة المحددة."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a string containing the given Unicode value (\"code point\") or list of values."
msgstr ""
"يبلغ عن سلسلة تحتوي على قيمة يونيكود المحددة (\"نقطة الرمز\") أو قائمة من "
"القيم."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a new list of the given length filled with zero or the optional value."
msgstr "يبلغ عن قائمة جديدة بالطول المحدد مملوءة بالصفر أو القيمة الاختيارية."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a new byte array of the given length filled with zero or the optional value."
msgstr ""
"يبلغ عن مصفوفة بايتات جديدة بالطول المحدد مملوءة بالصفر أو القيمة الاختيارية."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a byte array containing the UTF-8 bytes of the given string."
msgstr "يبلغ عن مصفوفة بايتات تحتوي على بايتات UTF-8 للسلسلة المحددة."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the number of words of memory available. Stop button frees up memory."
msgstr "يبلغ عن عدد كلمات الذاكرة المتوفرة. زر التوقف يحرر الذاكرة."
msgid ""
msgstr ""
