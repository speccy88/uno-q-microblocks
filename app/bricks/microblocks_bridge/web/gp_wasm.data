msgstr ""
"Klicke auf die Taste \"verbinden\", um dein Board mit MicroBlocks zu "
"verbinden."

#. MicroBlocks IDE error message.
msgid "The board is not responding."
msgstr "Das Board reagiert nicht."

#. MicroBlocks IDE information
msgid "Try to update MicroBlocks on the board?"
msgstr "MicroBlocks auf dem Board aktualisieren?"

#. MicroBlocks doesn't need a translation, does it?
msgid "MicroBlocks"
msgstr "MicroBlocks"

#. Tooltip in "Start" button. Top right of IDE.
msgid "Start"
msgstr "Start"

#. Confirmation window
msgid "Quit MicroBlocks?"
msgstr "MicroBlocks beenden?"

#. Scripting area right-click context menu
msgid "paste script"
msgstr "füge Skript ein"

#. Scripting area right-click context menu
msgid "paste script from clipboard"
msgstr "füge Skript aus der Zwischenablage ein"

#. Scripting area right-click context menu
