msgstr "தூண்டுதல் கேட் _ மிடி விசை _"

#. Analog Synthesis library block
msgid "set frequency ramp from _ % to _ % for gate _"
msgstr "வாயிலுக்கு _ % முதல் _ % வரை அதிர்வெண் வளைவை அமைக்கவும் _"

#. Analog Synthesis library block
msgid "amplitude for gate _"
msgstr "வாயிலுக்கான வீச்சு _"

#. Analog Synthesis library block
msgid "frequency for gate _"
msgstr "வாயிலுக்கான அதிர்வெண் _"

#. Analog Synthesis library block
#. example: output [16320] to [analog pin]
#. example: output [16320] to [MCP4725 DAC]
msgid "output _ to _"
msgstr "வெளியீடு _ முதல் _"

#. Analog Synthesis library block
#. as in pin number or i2c address
msgid "number/address _"
msgstr "எண்/முகவரி _"

#. Analog Synthesis library block
#. as in digital resolution (8 bit, 16 bit...)
msgid "asynth;resolution _"
msgstr "தீர்மானம் _"

