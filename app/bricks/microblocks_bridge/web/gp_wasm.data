to '_max7219_drawTextClipped' text ox oy zx zy zw zh {
  comment 'Draw text at (ox,oy) but only where it lands inside the zone rect (zx,zy,zw,zh). All coords 1-based.'
  local 'x' ox
  for char text {
    local 'shape' ('[misc:shapeforChar]' char)
    if (shape != 0) {
      for c 5 {
        local 'mask' 1
        for row 8 {
          if (((at c shape) & mask) != 0) {
            local 'px' ((x + c) - 1)
            local 'py' ((oy + row) - 1)
            if (and (and (px >= zx) (px < (zx + zw))) (and (py >= zy) (py < (zy + zh)))) {
              max7219_set_pixel px py true
            }
          }
          mask = (mask << 1)
        }
      }
    }
    x += 6
  }
}

to '_max7219_drawTextScaled' text x y scale {
  for char text {
    local 'shape' ('[misc:shapeforChar]' char)
    if (shape != 0) {
      for c 5 {
        local 'mask' 1
        for row 8 {
          if (((at c shape) & mask) != 0) {for dy scale {
            for dx scale {
              max7219_set_pixel (((x + ((c - 1) * scale)) + dx) - 1) (((y + ((row - 1) * scale)) + dy) - 1) true
            }
          }
}
          mask = (mask << 1)
        }
      }
    }
    x += (6 * scale)
  }
}

to '_max7219_ensure' {
  comment 'Auto-start with sensible per-board default pins if begin was not called. Defaults assume the board hardware-SPI pins (DIN=MOSI, CLK=SCK) plus a free CS; call "MAX7219 begin" to match your own wiring.'
  if (_max7219_buf == 0) {
    if ((boardType) == 'ESP32') {
      max7219_begin 23 18 5 4
    } (or ((boardType) == 'micro:bit v2') ((boardType) == 'micro:bit')) {
      max7219_begin 15 13 16 4
    } else {
      comment 'ESP8266 NodeMCU / D1 mini: D7=7 (MOSI), D5=5 (SCK), D8=8 (CS).'
      max7219_begin 7 5 8 4
    }
  }
}

to '_max7219_h' {
  comment 'Logical canvas height in the current rotation (valid y range).'
  '_max7219_ensure'
  if (or (_max7219_rot == 90) (_max7219_rot == 270)) {
    return _max7219_width
  }
  return (_max7219_rows * 8)
}

to '_max7219_initGrid' din clk cs wide tall {
  _max7219_din = din
  _max7219_clk = clk
  _max7219_cs = cs
  _max7219_cols = wide
  _max7219_rows = tall
  _max7219_count = (wide * tall)
  _max7219_width = (wide * 8)
  _max7219_flipH = (booleanConstant true)
  _max7219_flipV = (booleanConstant false)
  _max7219_rot = 0
  _max7219_serp = (booleanConstant false)
  _max7219_rowFlip = (booleanConstant false)
  _max7219_buf = (newList (_max7219_width * _max7219_rows) 0)
  digitalWriteOp _max7219_cs true
  comment 'Init each module: test off, no BCD decode, scan all 8 rows, medium brightness, wake up.'
  '_max7219_write_all' (hexToInt '0F') 0
  '_max7219_write_all' (hexToInt '09') 0
  '_max7219_write_all' (hexToInt '0B') 7
  '_max7219_write_all' (hexToInt '0A') 4
  '_max7219_write_all' (hexToInt '0C') 1
  max7219_clear
}

to '_max7219_line' x0 y0 x1 y1 {
  comment 'Bresenham line algorithm - draws into the buffer (no show).'
  local 'dx' (absoluteValue (x1 - x0))
  local 'dy' (0 - (absoluteValue (y1 - y0)))
  local 'sx' (ifExpression (x0 < x1) 1 -1)
  local 'sy' (ifExpression (y0 < y1) 1 -1)
  local 'err' (dx + dy)
  forever {
    max7219_set_pixel x0 y0 true
    if (and (x0 == x1) (y0 == y1)) {
      exitLoop
    }
    local 'e2' (2 * err)
    if (e2 >= dy) {
      err += dy
      x0 += sx
    }
    if (e2 <= dx) {
      err += dx
      y0 += sy
    }
  }
}

to '_max7219_renderZone' i {
  local 'zx' (at i _max7219_zx)
  local 'zy' (at i _max7219_zy)
  local 'zw' (at i _max7219_zw)
  local 'zh' (at i _max7219_zh)
  local 'txt' (at i _max7219_ztext)
  local 'eff' (at i _max7219_zeffect)
  local 'ph' (at i _max7219_zphase)
  local 'tw' (((size txt) * 6) - 1)
  if (eff == 'blink') {
    if ((ph % 2) == 0) {'_max7219_drawTextClipped' txt zx zy zx zy zw zh}
  } (eff == 'scroll left') {
    '_max7219_drawTextClipped' txt ((zx + zw) - (ph % ((zw + tw) + 2))) zy zx zy zw zh
  } (eff == 'scroll right') {
    '_max7219_drawTextClipped' txt ((zx - tw) + (ph % ((zw + tw) + 2))) zy zx zy zw zh
  } (eff == 'scroll up') {
    '_max7219_drawTextClipped' txt zx ((zy + zh) - (ph % ((zh + 8) + 2))) zx zy zw zh
  } (eff == 'scroll down') {
    '_max7219_drawTextClipped' txt zx ((zy - 8) + (ph % ((zh + 8) + 2))) zx zy zw zh
  } else {
    '_max7219_drawTextClipped' txt zx zy zx zy zw zh
  }
}

to '_max7219_send' b {
  comment 'Shift out one byte, most-significant bit first.'
  for i 8 {
    digitalWriteOp _max7219_din (((b >> (8 - i)) & 1) == 1)
    digitalWriteOp _max7219_clk true
    digitalWriteOp _max7219_clk false
  }
}

to '_max7219_setPixel2d' x y on {
  comment '2D pixel write into the (width x rows*8) buffer. Per-module orientation is handled in show, so this writes plain logical pixels (plus optional whole-canvas 180).'
  local 'lw' _max7219_width
  local 'lh' (_max7219_rows * 8)
  if (_max7219_rot == 180) {
    x = ((lw + 1) - x)
    y = ((lh + 1) - y)
  }
  if (and (and (x > 0) (x <= lw)) (and (y > 0) (y <= lh))) {
    local 'idx' ((((x - 1) * _max7219_rows) + ((y - 1) / 8)) + 1)
    local 'b' (at idx _max7219_buf)
    if on {
      b = (b | (1 << ((y - 1) % 8)))
    } else {
      b = (b & ('~' (1 << ((y - 1) % 8))))
    }
    atPut idx _max7219_buf b
  }
}

to '_max7219_show2d' {
  comment 'Push a wide x tall grid: map each chain module (near->far) to its 8x8 block + orientation (serpentine / flip-alt-rows / per-module flipH/flipV), then send its 8 rows.'
  for r 8 {
    digitalWriteOp _max7219_cs false
    for mm _max7219_count {
      local 'k' (_max7219_count - mm)
      local 'br' (k / _max7219_cols)
      local 'bc' (k % _max7219_cols)
      if (and _max7219_serp ((br % 2) == 1)) {
        bc = ((_max7219_cols - 1) - bc)
      }
      local 'colFlip' _max7219_flipH
      local 'rowFl' _max7219_flipV
      if (and _max7219_rowFlip ((br % 2) == 1)) {
        colFlip = (not colFlip)
        rowFl = (not rowFl)
      }
      local 'rowBits' 0
      for c 8 {
        local 'lc' c
        local 'lr' r
        if colFlip {
          lc = (9 - c)
        }
        if rowFl {
          lr = (9 - r)
        }
        local 'idx' ((((((bc * 8) + lc) - 1) * _max7219_rows) + br) + 1)
        if (((at idx _max7219_buf) & (1 << (lr - 1))) != 0) {
          rowBits = (rowBits | (1 << (c - 1)))
        }
      }
      '_max7219_send' r
      '_max7219_send' rowBits
    }
    digitalWriteOp _max7219_cs true
  }
}

to '_max7219_textWidth' text {
  comment 'Pixel width of the rendered text (6 px per character, minus the final gap).'
  if ((size text) == 0) {
    return 0
  }
  return (((size text) * 6) - 1)
}

to '_max7219_w' {
  comment 'Logical canvas width in the current rotation (valid x range).'
  '_max7219_ensure'
  if (or (_max7219_rot == 90) (_max7219_rot == 270)) {
    return 8
  }
  return _max7219_width
}

to '_max7219_write_all' reg data {
  comment 'Send the same register+data to every module (used for init / brightness / lamp test). One frame per module, latched together.'
  digitalWriteOp _max7219_cs false
  repeat _max7219_count {
    '_max7219_send' reg
    '_max7219_send' data
  }
  digitalWriteOp _max7219_cs true
}

to '_max7219_zonesInit' {
  comment 'Create the parallel zone lists if they do not exist yet.'
  if (not (isType _max7219_zx 'list')) {
    _max7219_zx = (newList 0)
    _max7219_zy = (newList 0)
    _max7219_zw = (newList 0)
    _max7219_zh = (newList 0)
    _max7219_ztext = (newList 0)
    _max7219_zeffect = (newList 0)
    _max7219_zspeed = (newList 0)
    _max7219_zphase = (newList 0)
    _max7219_zcount = (newList 0)
  }
}

to max7219_bar percent {
  comment 'Horizontal level bar filling left-to-right (0-100%). Good for a speed/level meter.'
  '_max7219_ensure'
  for i (_max7219_width * _max7219_rows) {
    atPut i _max7219_buf 0
  }
  local 'lw' ('_max7219_w')
  local 'cols' ((percent * lw) / 100)
  if (cols > lw) {
    cols = lw
  }
  for x cols {
    for y ('_max7219_h') {
      max7219_set_pixel x y true
    }
  }
  max7219_show
}

to max7219_begin din clk cs modules {
  comment 'A single row of `modules` (backward compatible) = begin grid with tall 1.'
  '_max7219_initGrid' din clk cs modules 1
}

to max7219_begin_grid din clk cs wide tall {
  comment 'A wide x tall GRID of 8x8 modules (e.g. 4 x 2 = 32x16). Run "identify" + "grid wiring" once to match how your panel is chained. tall 1 behaves exactly like "begin".'
  '_max7219_initGrid' din clk cs wide tall
}

to max7219_brightness level {
  '_max7219_ensure'
  '_max7219_write_all' (hexToInt '0A') level
}

to max7219_circle x0 y0 radius filled {
  '_max7219_ensure'
  comment 'Bresenham circle algorithm.'
  local 'x' (-1 * radius)
  local 'y' 0
  local 'err' (2 - (2 * radius))
  repeatUntil (x >= 0) {
    if filled {
      '_max7219_line' (x0 - x) (y0 + y) (x0 + x) (y0 + y)
      '_max7219_line' (x0 + y) (y0 + x) (x0 - y) (y0 + x)
    } else {
      max7219_set_pixel (x0 - x) (y0 + y) true
      max7219_set_pixel (x0 - y) (y0 - x) true
      max7219_set_pixel (x0 + x) (y0 - y) true
      max7219_set_pixel (x0 + y) (y0 + x) true
    }
    radius = err
    if (radius <= y) {
      y += 1
      err += ((y * 2) + 1)
    }
    if (or (radius > x) (err > y)) {
      x += 1
      err += ((x * 2) + 1)
    }
  }
  max7219_show
}

to max7219_clear {
  '_max7219_ensure'
  for i (_max7219_width * _max7219_rows) {
    atPut i _max7219_buf 0
  }
  max7219_show
}

to max7219_display_test on {
  comment 'Lamp test: light every LED (great first wiring check). Turn off to return to normal.'
  '_max7219_ensure'
  '_max7219_write_all' (hexToInt '0F') (ifExpression on 1 0)
}

to max7219_dissolve_out optionalDelay {
  comment 'Clear the display in a scattered (dissolve) order. Stride 7 is coprime with the (power-of-two) pixel count, so it visits every pixel.'
  '_max7219_ensure'
  local 'delay' (argOrDefault 1 20)
  local 'w' ('_max7219_w')
  local 'h' ('_max7219_h')
  local 'total' (w * h)
  local 'k' 0
  repeat total {
    local 'idx' ((k * 7) % total)
    max7219_set_pixel ((idx % w) + 1) ((idx / w) + 1) false
    k += 1
    if ((k % 6) == 0) {
      max7219_show
      waitMillis delay
    }
  }
  max7219_show
}

to max7219_draw_text text x {
  comment 'Draw a string into the buffer starting at column x (may be off-screen; pixels outside are clipped). 5px glyphs + 1px gap = 6px per character.'
  for char text {
    local 'shape' ('[misc:shapeforChar]' char)
    if (shape != 0) {
      for c 5 {
        local 'mask' 1
        for y 8 {
          if (((at c shape) & mask) != 0) {max7219_set_pixel ((x + c) - 1) y true}
          mask = (mask << 1)
        }
      }
    }
    x += 6
  }
}

to max7219_flip_h on {
  '_max7219_ensure'
  _max7219_flipH = on
}

to max7219_flip_v on {
  '_max7219_ensure'
  _max7219_flipV = on
}

to max7219_identify {
  comment 'Walk the chain, lighting one module at a time (near -> far) with a top-left corner marker, so you can read the physical order + orientation. Sends raw, independent of the wiring guess -- watch which panel lights and where the marker sits.'
  '_max7219_ensure'
  for target _max7219_count {
    for r 8 {
      digitalWriteOp _max7219_cs false
      for mm _max7219_count {
        local 'm' ((_max7219_count - mm) + 1)
        local 'bits' 0
        if (m == target) {
          if (r == 1) {bits = 15}
          if (and (r >= 2) (r <= 3)) {bits = 3}
        }
        '_max7219_send' r
        '_max7219_send' bits
      }
      digitalWriteOp _max7219_cs true
    }
    waitMillis 700
  }
  max7219_clear
}

to max7219_line x0 y0 x1 y1 {
  '_max7219_ensure'
  '_max7219_line' x0 y0 x1 y1
  max7219_show
}

to max7219_number whole frac places {
  comment 'Draw whole.frac with a compact decimal point. Pass the whole and fractional parts SEPARATELY (your code does the maths); places = digits to pad the fraction to. e.g. number 36 . 45 places 2 -> "36.45"; number 36 . 5 places 2 -> "36.05".'
  '_max7219_ensure'
  local 'wstr' ('[data:toString]' whole)
  local 'fstr' ('[data:toString]' frac)
  repeatUntil ((size fstr) >= places) {
    fstr = ('[data:join]' '0' fstr)
  }
  local 'digits' ('[data:join]' wstr fstr)
  local 'startx' (((('_max7219_w') - (((size digits) * 6) - 1)) / 2) + 1)
  if (startx < 1) {
    startx = 1
  }
  for i (_max7219_width * _max7219_rows) {
    atPut i _max7219_buf 0
  }
  max7219_draw_text digits startx
  max7219_sep startx (size wstr) '.'
  max7219_show
}

to max7219_plot x y {
  '_max7219_ensure'
  max7219_set_pixel x y true
  max7219_show
}

to max7219_power on {
  comment 'Turn the display on (normal) or off (shutdown: blanks the panel, low power). The buffer is kept.'
  '_max7219_ensure'
  '_max7219_write_all' (hexToInt '0C') (ifExpression on 1 0)
}

to max7219_print text optionalAlign optionalShow {
  comment 'Clear and draw a short string. align: left (default)/right/center. show: yes (default) shows it now; set NO to compose silently first (e.g. before "wipe in").'
  '_max7219_ensure'
  local 'a' (argOrDefault 2 'left')
  text = ('[data:toString]' text)
  for i (_max7219_width * _max7219_rows) {
    atPut i _max7219_buf 0
  }
  local 'x' 1
  if (a == 'right') {
    x = ((('_max7219_w') - ('_max7219_textWidth' text)) + 1)
  } (a == 'center') {
    x = (((('_max7219_w') - ('_max7219_textWidth' text)) / 2) + 1)
  }
  max7219_draw_text text x
  if (argOrDefault 3 (booleanConstant true)) {
    max7219_show
  }
}

to max7219_print_big text scale optionalAlign {
  comment 'Print scaled text (scale 2 = 16px tall) -- a big clock/countdown/score on a 2+ row panel. Each font pixel becomes a scale x scale block.'
  '_max7219_ensure'
  local 'a' (argOrDefault 3 'center')
  text = ('[data:toString]' text)
  for i (_max7219_width * _max7219_rows) {
    atPut i _max7219_buf 0
  }
  local 'tw' ((((size text) * 6) * scale) - scale)
  local 'x' 1
  if (a == 'right') {
    x = ((('_max7219_w') - tw) + 1)
  } (a == 'center') {
    x = (((('_max7219_w') - tw) / 2) + 1)
  }
  '_max7219_drawTextScaled' text x 1 scale
  max7219_show
}

to max7219_rect x y w h filled {
  '_max7219_ensure'
  if (or (w < 1) (h < 1)) {
    return 0
  }
  if filled {
    local 'r' y
    repeat h {
      '_max7219_line' x r ((x + w) - 1) r
      r += 1
    }
  } else {
    '_max7219_line' x y ((x + w) - 1) y
    '_max7219_line' x ((y + h) - 1) ((x + w) - 1) ((y + h) - 1)
    '_max7219_line' x y x ((y + h) - 1)
    '_max7219_line' ((x + w) - 1) y ((x + w) - 1) ((y + h) - 1)
  }
  max7219_show
}

to max7219_scroll text optionalDelay {
  comment 'Scroll text right-to-left once. Lower delay = faster. Tip: run this in its own script (when-broadcast) so it does not block beam sensing.'
  '_max7219_ensure'
  local 'msec' (argOrDefault 2 40)
  text = ('[data:toString]' text)
  local 'totalW' ((size text) * 6)
  local 'x' (('_max7219_w') + 1)
  repeatUntil (x < (0 - totalW)) {
    for i (_max7219_width * _max7219_rows) {
      atPut i _max7219_buf 0
    }
    max7219_draw_text text x
    max7219_show
    x += -1
    waitMillis msec
  }
}

to max7219_sep startx afterDigit kind {
  comment 'Compact separator in the gap after digit #afterDigit: "." = bottom dot, ":" = colon. Costs no extra width.'
  local 'gx' ((startx + (afterDigit * 6)) - 1)
  if (kind == '.') {
    max7219_set_pixel gx 8 true
  }
  if (kind == ':') {
    max7219_set_pixel gx 3 true
    max7219_set_pixel gx 6 true
  }
}

to max7219_set_pixel x y on {
  comment 'Set one pixel in the current rotation frame (1,1 = top-left). Mapped to the physical buffer via rotation then flip. Call "MAX7219 show" to push the buffer. lw/lh are inlined here (not via _max7219_w / _max7219_h) to keep this hot, deeply-nested function shallow on the call stack.'
  if (_max7219_rows > 1) {
    '_max7219_setPixel2d' x y on
    return 0
  }
  local 'lw' _max7219_width
  local 'lh' 8
  if (or (_max7219_rot == 90) (_max7219_rot == 270)) {
    lw = 8
    lh = _max7219_width
  }
  if (and (and (x > 0) (x <= lw)) (and (y > 0) (y <= lh))) {
    comment 'rotation: logical (x,y) -> base px (1.._max7219_width), py (1..8)'
    local 'px' x
    local 'py' y
    if (_max7219_rot == 180) {
      px = ((_max7219_width + 1) - x)
      py = (9 - y)
    } (_max7219_rot == 90) {
      px = y
      py = (9 - x)
    } (_max7219_rot == 270) {
      px = ((_max7219_width + 1) - y)
      py = x
    }
    comment 'panel wiring correction (independent of rotation)'
    if _max7219_flipH {
      px = ((_max7219_width + 1) - px)
    }
    if _max7219_flipV {
      py = (9 - py)
    }
    local 'b' (at px _max7219_buf)
    if on {
      b = (b | (1 << (py - 1)))
    } else {
      b = (b & ('~' (1 << (py - 1))))
    }
    atPut px _max7219_buf b
  }
}

to max7219_set_rotation deg {
  comment 'Rotate the whole display: 0/90/180/270 degrees. 0/180 keep the (8*modules)x8 canvas (180 = upside-down); 90/270 give an 8x(8*modules) canvas.'
  '_max7219_ensure'
  _max7219_rot = ('[data:convertType]' deg 'number')
}

to max7219_show {
  comment 'Push the column buffer to the chips. The buffer is column-major (one byte per x, bit (y-1) = row y); MAX7219 wants one byte per ROW per module, so we transpose here.'
  '_max7219_ensure'
  if (_max7219_rows > 1) {
    '_max7219_show2d'
    return 0
  }
  for r 8 {
    digitalWriteOp _max7219_cs false
    for mm _max7219_count {
      comment 'KNOB 1 (module order): far module first. If text is split/reversed across modules, use m = mm instead.'
      local 'm' ((_max7219_count - mm) + 1)
      local 'rowBits' 0
      for c 8 {
        local 'x' (((m - 1) * 8) + c)
        comment 'KNOB 3 (rows): if the display is upside-down, use (1 << (8 - r)).'
        if (((at x _max7219_buf) & (1 << (r - 1))) != 0) {
          comment 'KNOB 2 (columns): if each module is mirrored left-right, use (1 << (8 - c)).'
          rowBits = (rowBits | (1 << (c - 1)))
        }
      }
      '_max7219_send' r
      '_max7219_send' rowBits
    }
    digitalWriteOp _max7219_cs true
  }
}

to max7219_time mins secs hund {
  comment 'Draw mins:secs.hund (hund = hundredths of a second). Pass the three parts SEPARATELY (your code does the maths). Shows secs.hund when mins is 0, else m:ss.hund. e.g. time 0 : 2 . 45 -> "02.45"; time 1 : 5 . 9 -> "1:05.09". Single minute digit fits 32x8.'
  '_max7219_ensure'
  local 'sstr' ('[data:toString]' secs)
  if (secs < 10) {
    sstr = ('[data:join]' '0' sstr)
  }
  local 'cstr' ('[data:toString]' hund)
  if (hund < 10) {
    cstr = ('[data:join]' '0' cstr)
  }
  local 'mstr' ''
  local 'digits' ('[data:join]' sstr cstr)
  if (mins > 0) {
    mstr = ('[data:toString]' mins)
    digits = ('[data:join]' mstr digits)
  }
  local 'startx' (((('_max7219_w') - (((size digits) * 6) - 1)) / 2) + 1)
  if (startx < 1) {
    startx = 1
  }
  for i (_max7219_width * _max7219_rows) {
    atPut i _max7219_buf 0
  }
  max7219_draw_text digits startx
  if (mins > 0) {
    max7219_sep startx (size mstr) ':'
  }
  max7219_sep startx ((size mstr) + 2) '.'
  max7219_show
}

to max7219_unplot x y {
  '_max7219_ensure'
  max7219_set_pixel x y false
  max7219_show
}

to max7219_wipe_in optionalDelay {
  comment 'Reveal whatever is in the buffer, sweeping left to right (all module rows together).'
  '_max7219_ensure'
  local 'delay' (argOrDefault 1 25)
  local 'n' (_max7219_width * _max7219_rows)
  local 'saved' (newList n 0)
  for i n {
    atPut i saved (at i _max7219_buf)
  }
  for i n {
    atPut i _max7219_buf 0
  }
  for x _max7219_width {
    for b _max7219_rows {
      local 'idx' (((x - 1) * _max7219_rows) + b)
      atPut idx _max7219_buf (at idx saved)
    }
    max7219_show
    waitMillis delay
  }
}

to max7219_wipe_module col row {
  comment 'Clear one 8x8 module (col 1.._cols, row 1.._rows) and show. For per-panel wipe effects on a grid.'
  '_max7219_ensure'
  if (and (and (col > 0) (col <= _max7219_cols)) (and (row > 0) (row <= _max7219_rows))) {
    for yy 8 {
      for xx 8 {
        max7219_set_pixel (((col - 1) * 8) + xx) (((row - 1) * 8) + yy) false
      }
    }
    max7219_show
  }
}

to max7219_wipe_out optionalDelay {
  comment 'Clear the display, sweeping left to right (all module rows together).'
  '_max7219_ensure'
  local 'delay' (argOrDefault 1 25)
  for x _max7219_width {
    for b _max7219_rows {
      atPut (((x - 1) * _max7219_rows) + b) _max7219_buf 0
    }
    max7219_show
    waitMillis delay
  }
}

to max7219_wipe_out_dir direction optionalDelay {
  comment 'Clear the display, sweeping in a direction (left / right / up / down).'
  '_max7219_ensure'
  local 'delay' (argOrDefault 2 25)
  local 'w' ('_max7219_w')
  local 'h' ('_max7219_h')
  if (or (direction == 'left') (direction == 'right')) {
    for i w {
      local 'col' (ifExpression (direction == 'left') i ((w - i) + 1))
      for y h {
        max7219_set_pixel col y false
      }
      max7219_show
      waitMillis delay
    }
  } else {
    for i h {
      local 'rowY' (ifExpression (direction == 'up') i ((h - i) + 1))
      for x w {
        max7219_set_pixel x rowY false
      }
      max7219_show
      waitMillis delay
    }
  }
}

to max7219_wiring serpentine flipAltRows {
  comment 'Set the 2D chain wiring: serpentine = alternate module-rows run right-to-left; flip alt rows = those rows are mounted 180. Default false/false = raster, no flip. Use "identify" to find yours.'
  '_max7219_ensure'
  _max7219_serp = serpentine
  _max7219_rowFlip = flipAltRows
  max7219_show
}

to max7219_zone_add x y w h {
  comment 'Add a zone (a pixel rectangle; x,y = 1-based top-left). Returns its number -- pass that to "set zone".'
  '_max7219_zonesInit'
  '[data:addLast]' x _max7219_zx
  '[data:addLast]' y _max7219_zy
  '[data:addLast]' w _max7219_zw
  '[data:addLast]' h _max7219_zh
  '[data:addLast]' '' _max7219_ztext
  '[data:addLast]' 'static' _max7219_zeffect
  '[data:addLast]' 1 _max7219_zspeed
  '[data:addLast]' 0 _max7219_zphase
  '[data:addLast]' 0 _max7219_zcount
  return (size _max7219_zx)
}

to max7219_zone_set id text effect speed {
  comment 'Set a zone content + effect (static / blink / scroll left/right/up/down) + speed (ticks per step; higher = slower).'
  '_max7219_zonesInit'
  if (and (id > 0) (id <= (size _max7219_zx))) {
    atPut id _max7219_ztext ('[data:convertType]' text 'string')
    atPut id _max7219_zeffect effect
    atPut id _max7219_zspeed (maximum 1 speed)
    atPut id _max7219_zphase 0
    atPut id _max7219_zcount 0
  }
}

to max7219_zones_clear {
  comment 'Remove all zones.'
  _max7219_zx = (newList 0)
  _max7219_zy = (newList 0)
  _max7219_zw = (newList 0)
  _max7219_zh = (newList 0)
  _max7219_ztext = (newList 0)
  _max7219_zeffect = (newList 0)
  _max7219_zspeed = (newList 0)
  _max7219_zphase = (newList 0)
  _max7219_zcount = (newList 0)
}

to max7219_zones_step {
  comment 'Advance every zone by its OWN clock, compose them all, and show ONCE. Call in a forever loop -> different effects run at the same time.'
  '_max7219_ensure'
  '_max7219_zonesInit'
  for i (size _max7219_zx) {
    atPut i _max7219_zcount ((at i _max7219_zcount) + 1)
    if ((at i _max7219_zcount) >= (at i _max7219_zspeed)) {
      atPut i _max7219_zcount 0
      atPut i _max7219_zphase ((at i _max7219_zphase) + 1)
    }
  }
  for i (_max7219_width * _max7219_rows) {
    atPut i _max7219_buf 0
  }
  for i (size _max7219_zx) {
    '_max7219_renderZone' i
  }
  max7219_show
}

module main
author MicroBlocks
version 1 0 
description 'Bridge between MicroBlocks and Snap! using broadcast messages over USB-serial/WebSerial.
Streams pin and sensor data to Snap! Allows digital pins to be set.
Includes support for MakerBit and HyperDuino motor control.'
variables isMakerBit pinOutputValues 

  spec ' ' 'snapConnect_processCommands' 'Read & Execute Snap! Commands'
  spec ' ' 'snapConnect_sendPinState' 'Send Touch & Pin State'
  spec 'r' 'snapConnect_digitalPins' 'Digital Pin State from pin _ through pin _' 'auto auto' 2 13
  spec ' ' 'snapConnect_setDigitalPin' 'Set Digital Pin _ to _' 'auto bool' 2 true
  spec ' ' 'snapConnect_setMotorHyperduino' 'Set Motor _ Power _ (HyperDuino)' 'auto auto' 'A' 100
  spec ' ' 'snapConnect_setMotorMakerbit' 'Set Motor _ label _ (MakerBit)' 'auto auto' 'A' 100
  spec ' ' 'Send Sensors' 'Send Sensors'
  spec 'r' 'is microbit?' 'is microbit?'

to 'Send Sensors' {
  local 'msg' (newList 7)
  atPut 1 msg 'sensors'
  atPut 2 msg ('[sensors:tiltX]')
  atPut 3 msg ('[sensors:tiltY]')
  atPut 4 msg ('[sensors:tiltZ]')
  atPut 5 msg ('[display:lightLevel]')
  atPut 6 msg ('[sensors:temperature]')
  atPut 7 msg ('[sensors:magneticField]')
  sendBroadcast ('[data:joinStrings]' msg ',')
}

to 'is microbit?' {
  return (('[data:find]' 'micro:bit' (boardType)) == 1)
}

to snapConnect_digitalPins firstPin lastPin {
  comment 'Return an integer encoding the state of the digital pins from
firstPin through lastPin. The result encodes the pin values
as bits, where the pin number determines the bit offset.'
  comment 'Least signifcant bit is always pin zero, regardless of firstPin.'
  if (pinOutputValues == 0) {
    pinOutputValues = (newList 32 '')
  }
  local 'pinState' 0
  for i ((lastPin - firstPin) + 1) {
    local 'pin' ((firstPin + i) - 1)
    local 'output' (at (pin + 1) pinOutputValues)
    if (isType output 'boolean') {
      comment 'Pin is an output; set bit if current output is true'
      if output {
        pinState = (pinState | (1 << pin))
      }
    } else {
      comment 'Pin is an input; set bit if pin voltage is "high"'
      if (digitalReadOp pin) {
        pinState = (pinState | (1 << pin))
      }
    }
  }
  return pinState
}

to snapConnect_processCommands {
  local 'msg parts' ('[data:split]' (getLastBroadcast) ',')
  local 'cmd' (at 1 (v 'msg parts'))
  if (cmd == 'Set Digital Pin') {
    local 'pin' ((at 2 (v 'msg parts')) + 0)
    local 'value' ((at 3 (v 'msg parts')) == 'true')
    snapConnect_setDigitalPin pin value
  } (cmd == 'Enable Display') {
    '[display:mbEnableDisplay]' ((at 2 (v 'msg parts')) == 'true')
  } (cmd == 'Set Motor') {
    if ('is microbit?') {
      snapConnect_setMotorMakerbit (at 2 (v 'msg parts')) (at 3 (v 'msg parts'))
    } else {
      snapConnect_setMotorHyperduino (at 2 (v 'msg parts')) (at 3 (v 'msg parts'))
    }
  }
}

to snapConnect_sendPinState {
  local 'msg' (newList 9)
  atPut 1 msg 'pins'
  comment 'Add digital pin state'
  if ('is microbit?') {
    atPut 2 msg (snapConnect_digitalPins 0 16)
  } else {
    atPut 2 msg (snapConnect_digitalPins 0 13)
  }
  comment 'Update and add touch state'
  if (not _touch_initialized) {
    '_touch_init'
  }
  '_touch_update'
  atPut 3 msg _touch_state
  comment 'Add analog pin values'
  for i 6 {
    atPut (i + 3) msg (analogReadOp (i - 1))
  }
  sendBroadcast ('[data:joinStrings]' msg ',')
}

to snapConnect_setDigitalPin pin value {
  if (pinOutputValues == 0) {pinOutputValues = (newList 32 '')}
  digitalWriteOp pin value
  atPut (pin + 1) pinOutputValues value
}

to snapConnect_setMotorHyperduino motor power {
  comment 'Set motor (A or B) power (-100 to 100). The sign
of the power value determines motor direction.'
  comment 'HyperDuino pins: Motor A 3, 4, 5; Motor B 7, 8, 6'
  if (motor == 'A') {
    local 'p1' 3
    local 'p2' 4
    local 'pwrPin' 5
  } (motor == 'B') {
    local 'p1' 7
    local 'p2' 8
    local 'pwrPin' 6
  } else {
    return 0
  }
  comment 'Set the motor direction based on sign of power'
  if (power > 0) {
    snapConnect_setDigitalPin p1 false
    snapConnect_setDigitalPin p2 true
  } (power < 0) {
    snapConnect_setDigitalPin p1 true
    snapConnect_setDigitalPin p2 false
  } else {
    snapConnect_setDigitalPin p1 false
    snapConnect_setDigitalPin p2 false
  }
  comment 'Set the PWM duty cycle on the power pin'
  atPut (pwrPin + 1) pinOutputValues (power != 0)
  analogWriteOp pwrPin (minimum (((absoluteValue power) * 1023) / 100) 1023)
}

to snapConnect_setMotorMakerbit motor power {
  comment 'Set motor (A or B) power (-100 to 100). The sign
of the power value determines motor direction.'
  comment 'MakerBit pins: Motor A 11, 12, 13; Motor B 15, 16, 14'
  if (motor == 'A') {
    local 'p1' 11
    local 'p2' 12
    local 'pwrPin' 13
  } (motor == 'B') {
    local 'p1' 15
    local 'p2' 16
    local 'pwrPin' 14
  } else {
    return 0
  }
  comment 'Set the motor direction based on sign of power'
  if (power > 0) {
    snapConnect_setDigitalPin p1 false
    snapConnect_setDigitalPin p2 true
  } (power < 0) {
    snapConnect_setDigitalPin p1 true
    snapConnect_setDigitalPin p2 false
  } else {
    snapConnect_setDigitalPin p1 false
    snapConnect_setDigitalPin p2 false
  }
  comment 'Set the PWM duty cycle on the power pin'
  atPut (pwrPin + 1) pinOutputValues (power != 0)
  analogWriteOp pwrPin (minimum (((absoluteValue power) * 1023) / 100) 1023)
}

script 353 50 {
comment 'Click to test!'
sendBroadcast 'Set Digital Pin,2,false'
}

script 50 52 {
comment 'Click to test!'
sendBroadcast 'Set Digital Pin,2,true'
}

script 50 129 {
comment 'Click to test!'
sendBroadcast 'Set Motor,A,100'
}

script 358 129 {
comment 'Click to test!'
sendBroadcast 'Set Motor,A,0'
}

script 365 213 {
whenBroadcastReceived ''
comment 'Handle commands with arguments
(e.g. motor and pin control)'
snapConnect_processCommands
}

script 50 221 {
whenStarted
comment 'Send pin and sensor state'
forever {
  snapConnect_sendPinState
  if ('is microbit?') {
    'Send Sensors'
  }
  waitMillis 16
}
}

script 371 348 {
whenBroadcastReceived 'Get Info'
sendBroadcast ('[data:join]' 'info,SnapBridge 1.0 ' (boardType))
}

script 50 426 {
to snapConnect_sendPinState {}
}


module 'Basic Sensors' Input
author MicroBlocks
version 1 2 
tags tilt acceleration light sensor 
choices accelerometerRange '1' '2' '4' '8' 
description 'Provides blocks to read tilt in the three axes, acceleration, temperature and light level. Many boards come with this particular set of sensors, such as the micro:bit, the Circuit Playground Express, the Calliope or the Citilab ED1.'

  spec 'r' '[sensors:tiltX]' 'tilt x'
  spec 'r' '[sensors:tiltY]' 'tilt y'
  spec 'r' '[sensors:tiltZ]' 'tilt z'
  spec 'r' '[sensors:acceleration]' 'acceleration'
  spec 'r' '[display:lightLevel]' 'light level'
  spec 'r' '[sensors:temperature]' 'temperature (°C)'
  spec 'r' '[sensors:magneticField]' 'magnetic field'
  advanced
  spec ' ' 'setAccelRange' 'set acceleration range _ g = 100' 'menu.accelerometerRange' '1'

to setAccelRange n {
  '[sensors:setAccelerometerRange]' (0 + n)
}


module Touch Input
author MicroBlocks
version 1 14 
description 'Support for one or two MPR121 12-channel i2c touch sensors.
Detects MPR121 chips at I2C addresses 90 and, optionally, 92 to handle up to 24 touch pins.
'
variables _touch_pinCount _touch_state _touch_isTouched _touch_eventPending _touch_last_touched_pin _touch_last_released_pin 

  spec 'r' 'touch_isTouched' 'is pin _ touched?' 'menu.range:1-24' 1
  space
  spec 'r' 'touch_touch_event' 'pin touch event'
  spec 'r' 'touch_last_touched_pin' 'last touched pin'
  space
  spec 'r' 'touch_release_event' 'pin release event'
  spec 'r' 'touch_last_released_pin' 'last released pin'
  space
  spec 'r' 'touch_state_string' 'touch state string'
  space
  spec ' ' '_touch_init' '_touch_init'
  spec ' ' '_touch_update' '_touch_update'
  spec ' ' '_touch_setRegister' '_touch_setRegister _ to _' 'auto auto' 'hex register' 'hex value'
  spec 'r' '_touch_readState' '_touch_readState _' 'num' 90

to '_touch_init' {
  if (isType _touch_isTouched 'list') {
    comment 'Already initialized.'
    return 0
  }
  comment 'Set _touch_isTouched to a list to prevent
multiple calls to _touch_init at startup'
  _touch_isTouched = (newList 24 (booleanConstant false))
  _touch_pinCount = 0
  if ((i2cGet 90 0) >= 0) {
    _touch_pinCount = 12
  }
  if ((i2cGet 92 0) >= 0) {
    _touch_pinCount = 24
  }
  _touch_isTouched = (newList _touch_pinCount (booleanConstant false))
  _touch_eventPending = (newList _touch_pinCount (booleanConstant false))
  _touch_last_touched_pin = -1
  _touch_last_released_pin = -1
  comment 'Soft reset -- sets all registers to defaults
and turns off pin sensing'
  '_touch_setRegister' '0x80' '0x63'
  waitMillis 5
  comment 'Set filter parameters'
  '_touch_setRegister' '0x2B' '0x01'
  '_touch_setRegister' '0x2C' '0x01'
  '_touch_setRegister' '0x2D' '0x10'
  '_touch_setRegister' '0x2E' '0x20'
  '_touch_setRegister' '0x2F' '0x01'
  '_touch_setRegister' '0x30' '0x01'
  '_touch_setRegister' '0x31' '0x10'
  '_touch_setRegister' '0x32' '0x20'
  '_touch_setRegister' '0x33' '0x01'
  '_touch_setRegister' '0x34' '0x10'
  '_touch_setRegister' '0x35' '0xFF'
  comment 'Init debounce and config registers'
  '_touch_setRegister' '0x5B' '0x11'
  '_touch_setRegister' '0x5C' '0xFF'
  '_touch_setRegister' '0x5D' '0x30'
  comment 'Set touch/release thresholds'
  local 'touchThreshold' 40
  local 'releaseThreshold' 20
  for i 12 {
    local 'reg' ((hexToInt '40') + (2 * i))
    '_touch_setRegister' (reg - 1) touchThreshold
    '_touch_setRegister' reg releaseThreshold
  }
  comment 'Start tracking all inputs (proximity detection disabled)'
  '_touch_setRegister' '0x5E' '0xCC'
}

to '_touch_readState' addr {
  '[sensors:i2cWrite]' addr ('[data:makeList]' 0)
  local 'bytes' (newList 2)
  '[sensors:i2cRead]' addr bytes
  return (((at 2 bytes) << 8) | (at 1 bytes))
}

to '_touch_setRegister' reg value {
  local 'addr1' 90
  local 'addr2' 92
  if (isType reg 'string') {
    reg = (hexToInt reg)
  }
  if (isType value 'string') {
    value = (hexToInt value)
  }
  i2cSet addr1 reg value
  if (_touch_pinCount > 12) {
    i2cSet addr2 reg value
  }
}

to '_touch_update' {
  '_touch_init'
  _touch_state = 0
  if (_touch_pinCount > 0) {
    _touch_state = ('_touch_readState' 90)
  }
  if (_touch_pinCount > 12) {
    _touch_state = ((('_touch_readState' 92) << 12) | _touch_state)
  }
  for i _touch_pinCount {
    local 'isTouchedNow' ((_touch_state & (1 << (i - 1))) != 0)
    if ((at i _touch_isTouched) != isTouchedNow) {
      atPut i _touch_isTouched isTouchedNow
      atPut i _touch_eventPending (booleanConstant true)
    }
  }
  comment 'Leave some time between updates'
  waitMillis 30
}

to touch_isTouched pin {
  '_touch_init'
  if (or (pin < 1) (pin > _touch_pinCount)) {
    return (booleanConstant false)
  }
  '_touch_update'
  return ((_touch_state & (1 << (pin - 1))) != 0)
}

to touch_last_released_pin {
  comment 'Return the pin that triggered the last release event.'
  '_touch_init'
  return _touch_last_released_pin
}

to touch_last_touched_pin {
  comment 'Return the pin that triggered the last touch event.'
  '_touch_init'
  return _touch_last_touched_pin
}

to touch_release_event {
  '_touch_update'
  for i _touch_pinCount {
    if (and (at i _touch_eventPending) ((_touch_state & (1 << (i - 1))) == 0)) {
      atPut i _touch_eventPending (booleanConstant false)
      _touch_last_released_pin = i
      return (booleanConstant true)
    }
  }
  _touch_last_released_pin = -1
  return (booleanConstant false)
}

to touch_state_string {
  '_touch_update'
  local 'pin states' ('[data:makeList]')
  for i _touch_pinCount {
    if ((_touch_state & (1 << (i - 1))) != 0) {
      '[data:addLast]' '1' (v 'pin states')
    } else {
      '[data:addLast]' '0' (v 'pin states')
    }
  }
  return ('[data:joinStrings]' (v 'pin states'))
}

to touch_touch_event {
  '_touch_update'
  for i _touch_pinCount {
    if (and (at i _touch_eventPending) ((_touch_state & (1 << (i - 1))) != 0)) {
      atPut i _touch_eventPending (booleanConstant false)
      _touch_last_touched_pin = i
      return (booleanConstant true)
    }
  }
  _touch_last_touched_pin = -1
  return (booleanConstant false)
}

module main
author unknown
version 1 0 
description ''
variables snapshots selected 

  spec ' ' 'writeCentered' 'write _ centered at scale _ y _ color _' 'str auto auto color' 'Hello!' 3 '10'
  spec ' ' 'showMenu' 'show  menu'
  spec 'r' 'snapshotName' 'snapshot name _' 'str' ''
  spec ' ' 'updateSelection' 'update selection'

to showMenu {
  if (('[tft:getWidth]') == 0) {
    comment 'No TFT; show current selection'
    sendBroadcast 'scroll selection'
  } else {
    comment 'Draw menu on TFT'
    '[tft:clear]'
    writeCentered 'Menu' 4 10 (colorSwatch 180 180 180 255)
    local 'y' (('[tft:getHeight]') - 20)
    '[tft:text]' 'A <' 12 y (colorSwatch 180 180 180 255) 2 false
    '[tft:text]' '> B' (('[tft:getWidth]') - 45) y (colorSwatch 180 180 180 255) 2 false
    writeCentered 'A+B Run' 2 y (colorSwatch 180 180 180 255)
  }
}

to snapshotName filename {
  return ('[data:copyFromTo]' filename 2 ((size filename) - 6))
}

to updateSelection {
  'play tone' 'nt;c' 1 100
  'play tone' 'nt;g' 1 100
  if ((size snapshots) == 0) {
    return 0
  }
  if (('[tft:getWidth]') == 0) {
    comment 'No TFT display; use LED Display'
    sendBroadcast 'scroll selection'
  } else {
    comment 'Use TFT or OLED display'
    '[tft:rect]' 0 80 ('[tft:getWidth]') (('[tft:getHeight]') - 100) (colorSwatch 0 0 0 255)
    writeCentered (snapshotName (at selected snapshots)) 3 80 (colorSwatch 34 244 26 255)
    writeCentered ('[data:join]' '' selected ' of ' (size snapshots)) 2 160 (colorSwatch 34 244 26 255)
  }
}

to writeCentered text scale y color {
  local 'width' (((scale * 6) * (size text)) - scale)
  local 'x' (maximum 0 ((('[tft:getWidth]') - width) / 2))
  '[tft:text]' text x y color scale true
}

script 58 50 {
whenStarted
snapshots = ('[data:makeList]')
for filename ('file names') {
  if (('[data:find]' '.ucode' filename) > 0) {if (-1 == ('[data:find]' 'startup.ucode' filename)) {
    '[data:addLast]' filename snapshots
  }}
}
selected = 1
showMenu
updateSelection
}

script 530 51 {
whenButtonPressed 'A'
stopAll
selected += -1
if (selected < 1) {
  selected = 1
}
updateSelection
}

script 528 289 {
whenButtonPressed 'B'
stopAll
selected += 1
if (selected > (size snapshots)) {
  selected = (size snapshots)
}
updateSelection
}

script 59 471 {
whenButtonPressed 'A+B'
stopAll
if (selected > (size snapshots)) {
  showMenu
} else {
  '[display:mbDisplayOff]'
  '[tft:clear]'
  stopAll
  waitMillis 100
  '[misc:launchCodeSnapshot]' (at selected snapshots)
}
}

script 60 860 {
whenBroadcastReceived 'scroll selection'
scroll_text ('[data:join]' '' selected '-' (snapshotName (at selected snapshots))) 75
}


module Files Data
author MicroBlocks
version 1 5 
description 'Flash file system operations. Currently supports the LittleFS file system on ESP8266 and ESP32 boards. The GnuBlocks virtual machine (Linux and Raspberry Pi) supports the native system.'

  spec ' ' '[file:open]' 'open file _' 'str'
  spec ' ' '[file:close]' 'close file _' 'str'
  spec ' ' '[file:delete]' 'delete file _' 'str'
  space
  spec ' ' '[file:appendLine]' 'append line _ to file _' 'str str'
  spec ' ' '[file:appendBytes]' 'append bytes _ to file _' 'str str'
  space
  spec 'r' '[file:fileSize]' 'size of file _' 'str'
  spec 'r' 'file_contents' 'contents of file _ : binary _' 'str bool' '' false
  space
  spec 'r' '[file:readLine]' 'next line of file _' 'str'
  spec 'r' '[file:readBytes]' 'next _ bytes of file _ : starting at _' 'num str num' 100 '' 0
  spec 'r' '[file:readInto]' 'read into _ from file _' 'str str' 'a ByteArray' ''
  spec 'r' '[file:endOfFile]' 'end of file _' 'str'
  space
  spec 'r' '[file:readPosition]' 'read position of file _' 'str'
  spec ' ' '[file:setReadPosition]' 'set read position _ of file _' 'num str' 0 ''
  spec ' ' 'file_SkipBytes' 'skip _ bytes of file _' 'num str' 4 ''
  space
  spec 'r' 'file names' 'file names : in directory _' 'str'
  spec 'r' 'file directories' 'directory names : in directory _' 'str'
  space
  spec 'r' '[file:systemInfo]' 'file system info'

to 'file directories' dir {
  '[file:startList]' dir
  local 'result' ('[data:makeList]')
  local 'fileName' ('[file:nextDirInList]')
  repeatUntil (fileName == '') {
    '[data:addLast]' fileName result
    fileName = ('[file:nextDirInList]')
  }
  return result
}

to 'file names' dir {
  '[file:startList]' dir
  local 'result' ('[data:makeList]')
  local 'fileName' ('[file:nextInList]')
  repeatUntil (fileName == '') {
    '[data:addLast]' fileName result
    fileName = ('[file:nextInList]')
  }
  return result
}

to file_SkipBytes offset file {
  local 'newPosition' (('[file:readPosition]' file) + offset)
  '[file:setReadPosition]' newPosition file
}

to file_contents fileName optionBinary {
  local 'binary' (argOrDefault 2 (booleanConstant false))
  local 'byteCount' ('[file:fileSize]' fileName)
  local 'result' ('[data:newByteArray]' byteCount)
  local 'i' 1
  '[file:open]' fileName
  repeatUntil (i > byteCount) {
    i += ('[file:readInto]' result fileName)
  }
  '[file:close]' fileName
  return (ifExpression binary result ('[data:convertType]' result 'string'))
}


module 'LED Display' Output
author MicroBlocks
version 1 20 
choices led_imageMenu heart 'small heart' yes no happy sad confused angry asleep surprised silly fabulous meh 't-shirt' 'roller skate' duck house tortoise butterfly 'stick figure' ghost sword giraffe skull umbrella snake rabbit cow 'quarter note' 'eight note' pitchfork target triangle 'left triangle' 'chess board' diamond 'small diamond' square 'small square' scissors 
description 'Display primitives for the 5x5 LED display on the BBC micro:bit, Calliope mini and M5Atom Matrix. Boards with TFT displays (such as the Citilab ED1 or the M5Stack family) support these primitives with a simulated "fat pixel" display.
'
variables _stop_scrolling_text 

  spec ' ' '[display:mbDisplay]' 'display _' 'microbitDisplay' 15237440
  spec ' ' 'led_displayImage' 'display image _ : x _ y _' 'menu.led_imageMenu num num' 'happy' 1 1
  spec ' ' '[display:mbDisplayOff]' 'clear display'
  space
  spec ' ' '[display:mbPlot]' 'plot x _ y _' 'num num' 3 3
  spec ' ' '[display:mbUnplot]' 'unplot x _ y _' 'num num' 3 3
  space
  spec ' ' 'displayCharacter' 'display character _' 'str' 'A'
  spec ' ' 'scroll_text' 'scroll text _ : pausing _ ms' 'str num' 'HELLO ROSA!' 100
  spec ' ' 'stopScrollingText' 'stop scrolling'
  advanced
  spec ' ' 'set display color' 'set display color _' 'color'
  spec 'r' 'led_image' 'LED image #BR# _' 'microbitDisplay' 15237440
  spec ' ' 'display2x5Number' 'display number (0-99)  _' 'num' 10
  space
  spec 'r' '_led_namedImage' '_led_namedImage _' 'menu.led_imageMenu' 'happy'
  spec 'r' '_led_imageData' '_led_imageData'

to '_led_imageData' {
  return 'heart:4685802,small heart:145728,yes:2269696,no:18157905,happy:15237440,sad:18284864,confused:22348096,angry:23036241,asleep:459616,surprised:4526090,silly:25984017,fabulous:15008639,meh:2236443,t-shirt:15154043,roller skate:11534104,duck:489702,house:10976708,tortoise:359872,butterfly:29332475,stick figure:18158564,ghost:23068334,sword:4657284,giraffe:10946627,skull:15171246,umbrella:6460398,snake:469859,rabbit:16104613,cow:4685361,quarter note:7573636,eight note:7590276,pitchfork:4357813,target:4681156,triangle:1026176,left triangle:32805985,chess board:11184810,diamond:4539716,small diamond:141440,square:33080895,small square:469440,scissors:20287859,'
}

to '_led_namedImage' name {
  local 'data' ('_led_imageData')
  local 'i' ('[data:find]' name data)
  if (i == -1) {
    comment 'Name not found'
    return 0
  }
  local 'start' (('[data:find]' ':' data i) + 1)
  local 'end' (('[data:find]' ',' data i) - 1)
  return ('[data:convertType]' ('[data:copyFromTo]' data start end) 'number')
}

to display2x5Number number {
  local 'font' ('[data:makeList]' 3247203 2164802 3181635 3214403 2165793 3214371 3247139 2164803 3244131 3214435)
  local 'temp' ('[data:convertType]' number 'string')
  if ((size temp) == 1) {
    temp = ('[data:join]' '0' temp)
  }
  led_displayImage (at ((at 1 temp) + 1) font)
  led_displayImage (at ((at 2 temp) + 1) font) 4 1
}

to displayCharacter s {
  s = ('[data:join]' '' s)
  if ((size s) == 0) {
    '[display:mbDisplayOff]'
    return 0
  }
  '[display:mbDrawShape]' ('[display:mbShapeForLetter]' (at 1 s)) 1 1
}

to led_displayImage imageName optionalX optionalY {
  local 'image' imageName
  if (isType image 'string') {
    image = ('_led_namedImage' imageName)
  }
  '[display:mbDrawShape]' image (argOrDefault 2 1) (argOrDefault 3 1)
}

to led_image twentyFiveBitInt {
  comment 'An LED image is a 25-bit integer'
  return twentyFiveBitInt
}

to scroll_text text optionalDelay {
  text = ('[data:join]' '' text)
  local 'delay' 100
  if ((pushArgCount) > 1) {
    delay = optionalDelay
  }
  _stop_scrolling_text = (booleanConstant false)
  if ('Pico:ed' == (boardType)) {
    for position (((size text) * 6) + 18) {
      if _stop_scrolling_text {return 0}
      '[display:mbDisplayOff]'
      '[tft:text]' text (17 - position) 0 (colorSwatch 125 125 125 255) 1 true
      waitMillis (delay / 2)
    }
  } (or ('KidsIOT' == (boardType)) ('CodingBox' == (boardType))) {
    for position (((size text) * 6) + 21) {
      if _stop_scrolling_text {return 0}
      '[tft:deferUpdates]'
      '[tft:clear]'
      '[tft:text]' text (128 - (6 * position)) 6 (colorSwatch 255 255 255 255) 6 false
      '[tft:resumeUpdates]'
      waitMillis (delay / 8)
    }
  } else {
    for position (((size text) * 6) + 6) {
      if _stop_scrolling_text {return 0}
      for i (size text) {
        '[display:mbDrawShape]' ('[display:mbShapeForLetter]' ('[data:unicodeAt]' i text)) (((i * 6) + 2) - position) 1
      }
      waitMillis delay
    }
  }
}

to 'set display color' color {
  '[display:mbSetColor]' color
}

to stopScrollingText {
  _stop_scrolling_text = (booleanConstant true)
  waitMillis 10
  '[display:mbDisplayOff]'
}


module TFT Output
author MicroBlocks
version 1 20 
choices tft_orientation '0' '90' '180' '270' 
description 'Draw graphics and write text on boards with a TFT display, such as the M5Stack, M5Stick, Citilab ED1 or (discontinued) IoT-Bus.'

  spec ' ' '[tft:clear]' 'clear TFT display'
  space
  spec ' ' '[tft:rect]' 'draw rectangle on TFT at x _ y _ width _ height _ color _ : filled _' 'num num num num color bool' 10 10 40 30 nil true
  spec ' ' '[tft:roundedRect]' 'draw rounded rectangle on TFT at x _ y _ width _ height _ radius _ color _ : filled _' 'num num num num num color bool' 10 10 40 30 8 nil true
  spec ' ' '[tft:circle]' 'draw circle on TFT at x _ y _ radius _ color _ : filled _' 'num num num color bool' 40 40 30 nil true
  spec ' ' '[tft:triangle]' 'draw triangle on TFT at x _ y _ , x _ y _ , x _ y _ color _ : filled _' 'num num num num num num color bool' 20 20 30 80 60 5 nil true
  spec ' ' '[tft:line]' 'draw line on TFT from x _ y _ to x _ y _ color _' 'num num num num color' 12 8 25 15
  spec ' ' 'tft_drawVector' 'draw vector x _ y _ angle _ length _ color _' 'num num num num color' 40 40 45 40
  space
  spec ' ' '[tft:text]' 'write _ on TFT at x _ y _ color _ : scale _ wrap _ : bg color _' 'str num num color num bool color' 'Hello World!' 5 5 nil 2 true
  spec ' ' 'tft_drawText' 'draw text _ on TFT at x _ y _ color _ : scale _ : bg color _' 'str num num color num color' 'Line 1
Line 2' 50 20 nil 2
  space
  spec ' ' '[tft:setPixel]' 'set TFT pixel x _ y _ to _' 'num num color' 10 10
  spec ' ' '[tft:pixelRow]' 'draw pixel row _ x _ y _ : bytes per pixel _ : palette _' 'auto num num num str' 'aList' 0 0 4
  spec ' ' '[tft:drawBitmap]' 'draw bitmap _ palette _ on TFT at x _ y _' 'str str num num' 'aBitmap' 'a list of colors' 10 10
  space
  spec 'r' 'tft_colorSwatch' '_' 'color'
  spec 'r' 'makeColor' 'color r _ g _ b _ (0-255)' 'num num num' 0 100 100
  spec 'r' 'makeGray' 'gray _ %' 'num' 50
  spec 'r' 'randomColor' 'random color'
  space
  spec ' ' 'tft_drawImage' 'draw image _ on TFT at x _ y _ color _ : #BR# scale _' 'str num num color num' '' 0 0 nil 1
  spec 'r' 'tft_image' 'image _' 'str' '00000
01010
00000
10001
01110'
  space
  spec 'r' '[tft:getWidth]' 'TFT width'
  spec 'r' '[tft:getHeight]' 'TFT height'
  space
  spec ' ' '[tft:setBacklight]' 'set TFT backlight _ (0-10)' 'num' 10
  spec ' ' '[tft:invertDisplay]' 'invert TFT display _' 'bool' false
  spec ' ' 'tft_rotate' 'set TFT display rotation to _ °' 'menu.tft_orientation' 90
  advanced
  spec ' ' 'tft_deferOLEDDisplayUpdates' 'defer OLED display updates'
  spec ' ' 'tft_resumeOLEDDisplayUpdates' 'resume OLED display updates'
  space
  spec ' ' '_deferMonochromeDisplayUpdates' '_defer monochrome display updates'
  spec ' ' '_resumeMonochromeDisplayUpdates' '_resume monochrome display updates'

to '_deferMonochromeDisplayUpdates' {
  '[tft:deferUpdates]'
}

to '_resumeMonochromeDisplayUpdates' {
  '[tft:resumeUpdates]'
}

to makeColor r g b {
  r = (maximum 0 (minimum r 255))
  g = (maximum 0 (minimum g 255))
  b = (maximum 0 (minimum b 255))
  return ((r << 16) | ((g << 8) | b))
}

to makeGray percent {
  gray = ((percent * 255) / 100)
  gray = (maximum 0 (minimum gray 255))
  return ((gray << 16) | ((gray << 8) | gray))
}

to randomColor {
  local 'n1' (random 100 200)
  local 'n2' (random 0 100)
  if (1 == (random 1 3)) {
    return ((n1 << 16) | (n2 << 8))
  } (1 == (random 1 2)) {
    return ((n2 << 16) | n1)
  } else {
    return ((n1 << 8) | n2)
  }
}

to tft_colorSwatch color {
  return color
}

to tft_deferOLEDDisplayUpdates {
  '[tft:deferUpdates]'
}

to tft_drawImage imageString x y c optionalScale {
  comment 'Draw an image at the given position. An image is represented by a multi-line string
of 0 and 1 characters where each line is one row of the image. 1 means that pixel on (lit).'
  local 'scale' (argOrDefault 5 1)
  local 'left' x
  for ch ('[data:convertType]' imageString 'byte array') {
    if (ch == 10) {
      y += scale
      x = left
    } else {
      if (ch == 49) {'[tft:rect]' x y scale scale c}
      x += scale
    }
  }
}

to tft_drawText s x y color optionalScale optionalBGColor {
  s = ('[data:convertType]' s 'string')
  local 'scale' (argOrDefault 5 2)
  local 'bgColor' (argOrDefault 6 '')
  local 'lines' ('[data:split]' s ('[data:unicodeString]' 10))
  for line ('[data:split]' s ('[data:unicodeString]' 10)) {
    if (isType bgColor 'number') {
      '[tft:text]' line x y color scale false bgColor
    } else {
      '[tft:text]' line x y color scale false
    }
    y += (8 * scale)
  }
}

to tft_drawVector x y angle length color {
  local 'endX' (x + ((length * ('[misc:sin]' (100 * (angle + 90)))) >> 14))
  local 'endY' (y + ((length * ('[misc:sin]' (100 * angle))) >> 14))
  '[tft:line]' x y endX endY color
}

to tft_image s {
  return ('[data:convertType]' s 'string')
}

to tft_resumeOLEDDisplayUpdates {
  '[tft:resumeUpdates]'
}

to tft_rotate degrees {
  '[tft:rotateDisplay]' (degrees / 90)
}


module Tone Output
author MicroBlocks
version 1 11 
tags tone sound music audio note speaker 
choices tone_NoteName 'nt;c' 'nt;c#' 'nt;d' 'nt;d#' 'nt;e' 'nt;f' 'nt;f#' 'nt;g' 'nt;g#' 'nt;a' 'nt;a#' 'nt;b' 
description 'Audio tone generation. Make music with MicroBlocks!
'
variables _tonePin _toneInitalized _toneLoopOverhead _toneNoteNames _toneArezzoNotes _toneFrequencies 

  spec ' ' 'play tone' 'play note _ octave _ for _ ms' 'str.tone_NoteName num num' 'nt;c' 0 500
  spec ' ' 'playMIDIKey' 'play midi key _ for _ ms' 'num num' 60 500
  spec ' ' 'play frequency' 'play frequency _ for _ ms' 'num num' 261 500
  space
  spec ' ' 'startTone' 'start tone _ Hz' 'num' 440
  spec ' ' 'tone_startNote' 'start note _ octave _' 'str.tone_NoteName num' 'nt;c' 0
  spec ' ' 'tone_startMIDIKey' 'start midi key _' 'num' 60
  spec ' ' 'stopTone' 'stop tone'
  space
  spec ' ' 'attach buzzer to pin' 'attach buzzer to pin _' 'auto' ''
  space
  spec 'r' '_measureLoopOverhead' '_measureLoopOverhead'
  spec 'r' '_baseFreqForNote' '_baseFreqForNote _' 'auto' 'c'
  spec 'r' '_baseFreqForSemitone' '_baseFreqForSemitone _' 'num' 0
  spec ' ' '_toneLoop' '_toneLoop _ for _ ms' 'num num' 440000 100
  spec 'r' '_trimmedLowercase' '_trimmedLowercase _' 'str' 'A. b C...'
  spec ' ' '_tone init note names' '_tone init note names'

to '_baseFreqForNote' note {
  comment 'Return the frequency for the given note in the middle-C octave
scaled by 1000. For example, return 440000 (440Hz) for A.
Note names may be upper or lower case. Note names
may be followed by # for a sharp or b for a flat.'
  local 'normalized note' ('_trimmedLowercase' note)
  'normalized note' = (ifExpression ((at 1 (v 'normalized note')) == 'n') (v 'normalized note') ('[data:join]' 'nt;' (v 'normalized note')))
  '_tone init note names'
  if (('[data:find]' (v 'normalized note') _toneArezzoNotes) > 0) {
    return ('_baseFreqForSemitone' ('[data:find]' (v 'normalized note') _toneArezzoNotes))
  } else {
    return ('_baseFreqForSemitone' ('[data:find]' (v 'normalized note') _toneNoteNames))
  }
}

to '_baseFreqForSemitone' semitone {
  if (_toneFrequencies == 0) {_toneFrequencies = ('[data:makeList]' 261626 277183 293665 311127 329628 349228 369994 391995 415305 440000 466164 493883 246942 277183 277183 311127 311127 349228 329628 369994 369994 415305 415305 466164 466164 523252)}
  if (and (1 <= semitone) (semitone <= (size _toneFrequencies))) {
    return (at semitone _toneFrequencies)
  } else {
    comment 'Bad note name; return 10 Hz'
    return 10000
  }
}

to '_measureLoopOverhead' {
  comment 'Measure the loop overhead on this device'
  local 'halfCycle' 100
  local 'startT' (microsOp)
  repeat 100 {
    digitalWriteOp _tonePin false
    waitMicros halfCycle
    digitalWriteOp _tonePin false
    waitMicros halfCycle
  }
  local 'usecs' ((microsOp) - startT)
  return ((usecs - 20000) / 200)
}

to '_tone init note names' {
  if (_toneNoteNames == 0) {
    _toneNoteNames = ('[data:makeList]' 'nt;c' 'nt;c#' 'nt;d' 'nt;d#' 'nt;e' 'nt;f' 'nt;f#' 'nt;g' 'nt;g#' 'nt;a' 'nt;a#' 'nt;b' 'nt;c_' 'nt;db' 'nt;d_' 'nt;eb' 'nt;e_' 'nt;e#' 'nt;f_' 'nt;gb' 'nt;g_' 'nt;ab' 'nt;a_' 'nt;bb' 'nt;b_' 'nt;b#')
    _toneArezzoNotes = ('[data:makeList]' 'nt;do' 'nt;do#' 'nt;re' 'nt;re#' 'nt;mi' 'nt;fa' 'nt;fa#' 'nt;sol' 'nt;sol#' 'nt;la' 'nt;la#' 'nt;si' 'nt;do_' 'nt;dob' 'nt;re_' 'nt;reb' 'nt;mi_' 'nt;mi#' 'nt;fa_' 'nt;solb' 'nt;sol_' 'nt;lab' 'nt;la_' 'nt;sib' 'nt;si_' 'nt;si#')
  }
}

to '_toneLoop' scaledFreq ms {
  if (_toneInitalized == 0) {'attach buzzer to pin' ''}
  if ('[io:hasTone]') {
    '[io:playTone]' _tonePin (scaledFreq / 1000)
    waitMillis ms
    '[io:playTone]' _tonePin 0
  } else {
    local 'halfCycle' ((500000000 / scaledFreq) - _toneLoopOverhead)
    local 'cycles' ((ms * 500) / halfCycle)
    repeat cycles {
      digitalWriteOp _tonePin true
      waitMicros halfCycle
      digitalWriteOp _tonePin false
      waitMicros halfCycle
    }
  }
}

to '_trimmedLowercase' s {
  comment 'Return a copy of the given string without whitespace
or periods and all lowercase.'
  local 'result' (newList (size s))
  '[data:delete]' 'all' result
  for i (size s) {
    local 'ch' ('[data:unicodeAt]' i s)
    if (and (ch > 32) (ch != 46)) {
      if (and (65 <= ch) (ch <= 90)) {ch = (ch + 32)}
      '[data:addLast]' ch result
    }
  }
  return ('[data:unicodeString]' result)
}

to 'attach buzzer to pin' pinNumber {
  if (pinNumber == '') {
    comment 'Pin number not specified; use default pin for this device'
    if ((boardType) == 'Citilab ED1') {
      _tonePin = 26
    } ((boardType) == 'M5Stack-Core') {
      _tonePin = 25
    } ((boardType) == 'M5StickC') {
      _tonePin = 26
    } ((boardType) == 'Calliope') {
      digitalWriteOp 23 true
      digitalWriteOp 24 true
      _tonePin = 25
    } ((boardType) == 'D1-Mini') {
      _tonePin = 12
    } ((boardType) == 'CodingBox') {
      _tonePin = 32
    } else {
      _tonePin = -1
    }
  } else {
    _tonePin = pinNumber
  }
  _toneLoopOverhead = ('_measureLoopOverhead')
  _toneInitalized = (booleanConstant true)
}

to 'play frequency' freq ms {
  '_toneLoop' (freq * 1000) ms
}

to 'play tone' note octave ms {
  local 'freq' ('_baseFreqForNote' note)
  if (freq <= 10000) {
    waitMillis ms
    return 0
  }
  if (octave < 0) {
    repeat (absoluteValue octave) {
      freq = (freq / 2)
    }
  }
  repeat octave {
    freq = (freq * 2)
  }
  '_toneLoop' freq ms
}

to playMIDIKey key ms {
  local 'freq' ('_baseFreqForSemitone' ((key % 12) + 1))
  local 'octave' ((key / 12) - 5)
  if (octave < 0) {
    repeat (absoluteValue octave) {
      freq = (freq / 2)
    }
  }
  repeat octave {
    freq = (freq * 2)
  }
  '_toneLoop' freq ms
}

to startTone freq {
  if (_toneInitalized == 0) {'attach buzzer to pin' ''}
  if ('[io:hasTone]') {'[io:playTone]' _tonePin freq}
}

to stopTone {
  startTone 0
}

to tone_startMIDIKey key {
  local 'freq' ('_baseFreqForSemitone' ((key % 12) + 1))
  local 'octave' ((key / 12) - 5)
  if (octave < 0) {
    repeat (absoluteValue octave) {
      freq = (freq / 2)
    }
  }
  repeat octave {
    freq = (freq * 2)
  }
  startTone ((freq + 500) / 1000)
}

to tone_startNote note octave {
  local 'freq' ('_baseFreqForNote' note)
  if (freq <= 10000) {
    return 0
  }
  if (octave < 0) {
    repeat (absoluteValue octave) {
      freq = (freq / 2)
    }
  }
  repeat octave {
    freq = (freq * 2)
  }
  startTone ((freq + 500) / 1000)
}
module main
author MicroBlocks
version 1 0 
description 'Measure how fast a board is vibrating or wobbling. Needs a board with an accelerometer, such as the micro:bit v2.'

script 75 83 {
comment 'Vibration spectrum. Hold the board against something
that vibrates or wobbles: a washing machine, a fan, a
ruler twanged on a table edge. Every 2.5 seconds this
reports the strongest vibration in Hz and graphs the
spectrum. (Click the graph icon to see the graph.)'
}

script 75 213 {
whenStarted
forever {
  local 'samples' (newList 256 0)
  local 'next' (millisOp)
  for i 256 {
    waitUntil ((millisOp) >= next)
    atPut i samples ('[sensors:acceleration]')
    next += 10
  }
  local 'spectrum' (dsp_fft samples)
  for i ('[data:range]' 3 128) {
    graphIt (at i spectrum)
  }
  local 'hz100' (dsp_peakFrequency samples 100)
  sayIt ('[data:join]' (hz100 / 100) '.' ((hz100 % 100) / 10) ' Hz')
}
}


