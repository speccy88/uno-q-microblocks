msgid "Invalid URL"
msgstr "URL tidak valid"

#. String in file picker and library dialogs
msgid "Could not fetch library."
msgstr "Tidak dapat mengambil pustaka."

#. String in file picker and library dialogs
msgid "Host does not exist or is currently down."
msgstr "Host tidak ada atau sedang tidak aktif."

#. String in file picker and library dialogs
