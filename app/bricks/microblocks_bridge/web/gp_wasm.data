msgid "asy;pin"
msgstr "அனலாக்ச் முள்"

#. Analog Synthesis library block menu option
msgid "asy;MCP4725"
msgstr "MCP4725 I2C DAC"

#. Barometer (LPS331AP) library dropdown menu option
msgid "lps331;ºC"
msgstr ". சி"

#. Calliope NeoPixel library block
msgid "Calliope clear all NeoPixels"
msgstr "காலியோப் அனைத்து நியோபிக்சல்களையும் அழிக்கவும்"

