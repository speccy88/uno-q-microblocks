msgstr "tampilkan ukuran program di papan"

#. Program size information
msgid "Using %1 out of %2 bytes"
msgstr "Menggunakan %1 dari %2 byte"

#. Firmware install board type confirmation. As in "Use board type micro:bit?"
msgid "Use board type"
msgstr "Gunakan jenis papan"

#. Successful firmware installation confirmation window title
msgid "Firmware Install"
msgstr "Instal Firmware"

#. Successful firmware installation confirmation window message
msgid "Firmware Installed"
msgstr "Firmware Terinstal"

#. MicroBlocks IDE information
msgid "Reconnect to the board by clicking the \"Connect\" button."
msgstr "Sambungkan kembali ke papan dengan mengklik tombol \"Sambungkan\"."

#. MicroBlocks IDE information
msgid "Connect USB cable while holding down the white BOOTSEL button before proceeding."
msgstr ""
"Sambungkan kabel USB sambil menahan tombol BOOTSEL putih sebelum melanjutkan."

#. MicroBlocks IDE information
msgid "You will be asked to save the firmware file."
msgstr "Anda akan diminta untuk menyimpan file firmware."

#. MicroBlocks IDE information
msgid "If your micro:bit shows a sad face, save the firmware.hex file to your disk then drop it onto the MICROBIT drive."
msgstr ""
"Jika micro:bit Anda menunjukkan wajah sedih, simpan file firmware.hex ke "
"disk Anda lalu letakkan ke drive MICROBIT."

#. MicroBlocks IDE information
msgid "Save the firmware file when prompted."
msgstr "Simpan file firmware saat diminta."

# %1 holds the drive name
#. MicroBlocks IDE information
msgid "Drag the firmware file you just saved to the %1 drive."
msgstr "Seret file firmware yang baru saja Anda simpan ke drive %1."

#. Firmware installation process information
msgid "Installing firmware..."
msgstr "Menginstal firmware..."

#. MicroBlocks IDE information
msgid "Board not connected"
msgstr "Papan tidak terhubung"

#. Board wiping process information
msgid "Wiping board..."
msgstr "Membersihkan papan..."

#. Firmware install instruction
msgid "Connecting..."
msgstr "Menyambungkan..."

#. Firmware install instruction
msgid "(press ESC to cancel)"
msgstr "(tekan ESC untuk membatalkan)"

#. Firmware install instruction
