	setGutenburgText ed (readFile '20000Leagues.txt')
	return ed
}

method checkLines TextEditor1 {
	i = 1
	pos = 0
	for line lines {
		if (pos != (lineStart line)) {
			error 'Mismatch at:' i ';' pos '!=' (lineStart line)
		}
		pos += (count (contents line))
		if (endsParagraph line) { pos += 1 }
		i += 1
	}
}

