method makeGPLogo Project {
	bm = (newBitmap 100 100)
	fillRoundedRect (newVectorPen bm) (rect 1 1 99 99) 10 (gray 250) 2 (gray 0)
	setFont 'Verdana' 66
	c = (color 56 191 40)
	drawString bm 'G' c 6 8
	drawString bm 'P' c 55 8
	setName bm 'GP'
	return bm
}

