#. "Output" blocks category label
msgid "cat;Output"
msgstr "Sortida"

#. Block in Output category
msgid "set user LED _"
msgstr "encén led integrat _"

#. Block in Output category
msgid "say _"
msgstr "digues _"

#. Block in Output category
msgid "graph _"
msgstr "afegeix a la gràfica _"

#. "Input" blocks category label
msgid "cat;Input"
msgstr "Entrada"

#. Block in Input category
msgid "button A"
msgstr "botó A"

#. Block in Input category
msgid "button B"
msgstr "botó B"

#. Block in Input category
msgid "timer"
msgstr "cronòmetre"

#. Block in Input category
msgid "reset timer"
msgstr "reinicia el cronòmetre"

#. Block in Input category
msgid "microseconds"
msgstr "microsegons"

#. Block in Input category
msgid "milliseconds"
msgstr "mil·lisegons"

#. Block in Input category
msgid "board type"
msgstr "tipus de placa"

#. Block in Input category
msgid "milliseconds since _"
msgstr "mil·lisegons des de _"

#. Block in Input category
msgid "end time _"
msgstr "fins a _"

#. Block in Input category
msgid "microseconds since _"
msgstr "microsegons des de _"

#. Block in Input category
msgid "connected to IDE"
msgstr "connectat a la IDE"

#. "Pins" blocks category label
msgid "cat;Pins"
msgstr "Pins"

#. Block in Pins category
msgid "read digital pin _"
msgstr "lectura digital _"

#. Block in Pins category
msgid "read analog pin _"
msgstr "lectura analògica _"

#. Block in Pins category
msgid "pullup _"
msgstr "amb resistència interna _"

#. Block in Pins category
msgid "set digital pin _ to _"
msgstr "posa el pin digital _ a _"

#. Block in Pins category
msgid "set pin _ to _"
msgstr "posa el pin _ a _"

#. Block in Pins category
msgid "analog pins"
msgstr "pins analògics"

#. Block in Pins category
msgid "digital pins"
msgstr "pins digitals"

#. "Control" blocks category label
msgid "cat;Control"
msgstr "Control"

#. Block in Control category
msgid "when started"
msgstr "en començar"

#. Block in Control category
msgid "when button _ pressed"
msgstr "quan es premi el botó _"

#. Block in Control category
msgid "forever _"
msgstr "per sempre _"

#. Block in Control category
msgid "repeat _ _"
msgstr "repeteix _ vegades _"

#. Block in Control category
msgid "wait _ millisecs"
msgstr "espera _ mil·lisegons"

#. Block in Control category
msgid "if _ _"
msgstr "si _ _"

#. Block in Control category
