#. Block part type, while making a new block
msgid "input"
msgstr "casilla"

#. Block size button tooltip
msgid "Restore block size to 100%"
msgstr "Restaura el tamaño de los bloques al 100%"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Input"
msgstr "Entrada"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Library"
msgstr "Biblioteca"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Palette"
msgstr "Paleta"

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Turn a pin on or off ( (-o) or (o-) )."
msgstr "Activa o desactiva un pin digital ( (-o) o (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Close the serial port."
msgstr "Cierra el puerto serie."

#. "Output" blocks category label
msgid "cat;Output"
msgstr "Salida"

#. Block in Input category
msgid "connected to IDE"
msgstr "conectado a la IDE"

#. Block in Pins category
msgid "set pin _ to _"
msgstr "pon pin _ a _"

#. Block in Control category
msgid "if _ _ else _"
msgstr "si _ _ si no _"

#. Block in Control category
msgid "broadcast _"
msgstr "envía _"

#. Block in Control category
msgid "comment _"
msgstr "comentario _"

#. Block in Control category
msgid "for _ in _ _"
msgstr "por cada _ en _ _"

#. Example default value for the ( arg _ default _ ) block
msgid "default"
msgstr "defecto"

#. Block in Operators category
msgid "min _ _"
msgstr "mínimo entre _ y _"

#. Block in Operators category
msgid "rescale _ from ( _ , _ ) to ( _ , _ )"
msgstr "reescalar _ de ( _ , _ ) a ( _ , _ )"

#. Button on top of "Variables" category
msgid "Add a variable"
msgstr "Crea una variable"

#. Button on top of "Variables" category
msgid "Delete a variable"
msgstr "Elimina una variable"

#. New variable dialog
msgid "New variable name?"
msgstr "¿Nombre de la variable?"

#. Block in Variables category
msgid "set _ to _"
msgstr "asigna a _ el valor _"

#. Block in Variables category
msgid "change _ by _"
msgstr "aumenta _ en _"

#. Block in Variables category
msgid "initialize local _ to _"
msgstr "inicializa variable local _ a _"

