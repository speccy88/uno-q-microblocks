module Ringtone Output
author MicroBlocks
version 1 3 
depends _Tone 
description 'Plays tunes in RTTTL (Ringtone Text Transfer Language) a language developed by Nokia to store ringtones.
Also known as Nokring.'
variables '_RTTTL default duration' '_RTTTL default octave' '_RTTTL bpm' '_RTTTL song name' 

	spec 'r' '_RTTTL parse control from' '_RTTTL parse control from _' 'str' ''
	spec ' ' 'play ringtone' 'play ringtone _' 'str' 'Pacman:d=16,o=6,b=140:
b5,b,f#,d#,8b,8d#,c,c7,g,f,8c7,8e,b5,b,f#,d#,8b,8d#,32d#,32e,f,32f,32f#,g,32g,32g#,a,8b'
	spec 'r' 'current song name' 'current song name'
	spec ' ' '_RTTTL play note' '_RTTTL play note _' 'str' '8c#'

to '_RTTTL parse control from' 'control section' {
  comment 'Extract control section'
  local 'd' 4
  local 'o' 6
  local 'b' 63
  repeatUntil ((size (v 'control section')) == 0) {
    local 'next separator' ('[data:find]' ',' (v 'control section'))
    if ((v 'next separator') == -1) {
      'next separator' = (size (v 'control section'))
    }
    local 'to process' ('[data:copyFromTo]' (v 'control section') 1 (v 'next separator'))
    'control section' = ('[data:copyFromTo]' (v 'control section') ((v 'next separator') + 1))
    'next separator' = ('[data:find]' ',' (v 'to process'))
    if ((v 'next separator') == -1) {
      'next separator' = ((size (v 'to process')) + 1)
    }
    if (('[data:find]' 'd' (v 'to process')) > 0) {
      d = ('[data:copyFromTo]' (v 'to process') (('[data:find]' '=' (v 'to process')) + 1) ((v 'next separator') - 1))
    } (('[data:find]' 'b' (v 'to process')) > 0) {
      b = ('[data:copyFromTo]' (v 'to process') (('[data:find]' '=' (v 'to process')) + 1) ((v 'next separator') - 1))
    } (('[data:find]' 'o' (v 'to process')) > 0) {
      o = ('[data:copyFromTo]' (v 'to process') (('[data:find]' '=' (v 'to process')) + 1) ((v 'next separator') - 1))
    }
  }
  return ('[data:makeList]' d o b)
}

to '_RTTTL play note' note {
  local 'duration' ''
  local 'note name' ''
  local 'octave' (v '_RTTTL default octave')
  local 'ms / whole note' (240000 / (v '_RTTTL bpm'))
  local 'isDotted' (('[data:find]' '.' note) > -1)
  note = ('_trimmedLowercase' note)
  if (note == '') {
    comment 'empty note string; skip'
    return 0
  }
  comment 'parse duration value, if there is one'
  repeatUntil (or (('[data:unicodeAt]' 1 note) < 48) (('[data:unicodeAt]' 1 note) > 57)) {
    duration = ('[data:join]' duration (at 1 note))
    note = ('[data:copyFromTo]' note 2)
  }
  if (duration == '') {
    duration = (v '_RTTTL default duration')
  }
  comment 'parse note name'
  if (or (('[data:find]' '#' note) > -1) (('[data:find]' '_' note) > -1)) {
    'note name' = ('[data:copyFromTo]' note 1 2)
  } else {
    'note name' = (at 1 note)
  }
  note = ('[data:copyFromTo]' note ((size (v 'note name')) + 1))
  comment 'deal with dotted notes'
  if isDotted {
    duration = ((((v 'ms / whole note') / duration) * 15) / 10)
  } else {
    duration = ((v 'ms / whole note') / duration)
  }
  comment 'parse octave, if there is one'
  if (note != '') {
    octave = (at 1 note)
  }
  'play tone' (v 'note name') (octave - 4) duration
}

to 'current song name' {
  return (v '_RTTTL song name')
}

to 'play ringtone' RTTTL {
  comment 'Initialize frequency map.'
  ignoreArgs ('_baseFreqForNote' 'c')
  comment 'Remove song name'
  '_RTTTL song name' = ('[data:copyFromTo]' RTTTL 1 (('[data:find]' ':' RTTTL) - 1))
  RTTTL = ('[data:copyFromTo]' RTTTL ((size (v '_RTTTL song name')) + 2))
  local 'control' ('_RTTTL parse control from' ('[data:copyFromTo]' RTTTL 1 (('[data:find]' ':' RTTTL) - 1)))
  '_RTTTL default duration' = (at 1 control)
  '_RTTTL default octave' = (at 2 control)
  '_RTTTL bpm' = (at 3 control)
  RTTTL = ('[data:copyFromTo]' RTTTL (('[data:find]' ':' RTTTL) + 1))
  repeatUntil ((size RTTTL) == 0) {
    local 'next separator' ('[data:find]' ',' RTTTL)
    if ((v 'next separator') == -1) {
      'next separator' = ((size RTTTL) + 1)
    }
    local 'next note' ('[data:copyFromTo]' RTTTL 1 ((v 'next separator') - 1))
    RTTTL = ('[data:copyFromTo]' RTTTL ((v 'next separator') + 1))
    '_RTTTL play note' (v 'next note')
  }
  '_RTTTL song name' = ''
}

module '3dBot'
author 'Josep Ferràndiz'
version 1 1 
depends _Imagina 
tags imagina '3dbot' robot 
choices lineSensor 'right sensor' 'left sensor' 'both sensors' 
choices direction stop forward backward 'turn right' 'turn left' 
description 'Blocks for Imagina 3dBot robot with ESP32 board (from Innova Didàctic)
https://shop.innovadidactic.com/es/placas-kits-y-robots/1604-kit-3dbot-iot-esp32-steamakers-arduinoblocks-blynk-bachillerato.html'
variables _3dBotPower _3dBotDirection _3dBotInitialized 

  spec ' ' 'bot3D_move' '3dBot _ : _ steps : at _ % speed' 'menu.direction num num' 'forward' 10 100
  spec ' ' 'bot3D_set_speed' '3dBot set speed at _ %' 'num' 100
  space
  spec 'r' 'bot3D_obstacle_detected' '3dBot obstacle < _ cm?' 'auto' '10'
  spec 'r' 'bot3D_sees_line' '3dBot line on _ ?' 'menu.lineSensor' 'right sensor'
  space
  spec ' ' '_bot3D_set_direction' '_bot3D_set_direction _' 'menu.direction' 'stop'
  spec ' ' '_bot3D_move' '_bot3D_move _ steps' 'num' 10

to '_bot3D_move' steps {
  local 'initialState' 0
  bot3D_move _3dBotDirection
  repeat steps {
    initialState = ((imagina_read_A1) > 800)
    waitUntil (not (((imagina_read_A1) > 800) == initialState))
  }
  imagina_set_motor_rotation 'Motor A' 'stop'
  imagina_set_motor_rotation 'Motor B' 'stop'
}

to '_bot3D_set_direction' direction {
  for item ('[data:makeList]' 'forward' 'backward' 'stop' 'turn right' 'turn left') {
    if (direction == item) {_3dBotDirection = direction}
  }
  imagina_set_motor_speed 'Motor A' _3dBotPower
  imagina_set_motor_speed 'Motor A' _3dBotPower
  if (_3dBotDirection == 'turn right') {
    imagina_set_motor_rotation 'Motor A' 'forward'
    imagina_set_motor_rotation 'Motor B' 'backward'
  } (_3dBotDirection == 'turn left') {
    imagina_set_motor_rotation 'Motor A' 'backward'
    imagina_set_motor_rotation 'Motor B' 'forward'
  } else {
    imagina_set_motor_rotation 'Motor A' _3dBotDirection
    imagina_set_motor_rotation 'Motor B' _3dBotDirection
  }
}

to bot3D_move direction steps power {
  _3dBotDirection = direction
  if (not _3dBotInitialized) {
    _3dBotPower = 100
    _3dBotInitialized = (booleanConstant true)
  }
  if ((pushArgCount) == 3) {
    _3dBotPower = power
  }
  if ((pushArgCount) > 1) {
    '_bot3D_move' steps
    return 0
  }
  '_bot3D_set_direction' direction
}

to bot3D_obstacle_detected distance {
  local 'aux_dist' (imagina_distance)
  waitMillis 50
  if ((imagina_distance) <= distance) {
    return (booleanConstant true)
  }
  return (booleanConstant false)
}

to bot3D_sees_line sensor {
  if (sensor == 'right sensor') {
    return (digitalReadOp 27)
  } (sensor == 'left sensor') {
    return (digitalReadOp 16)
  } (sensor == 'both sensors') {
    return (and (digitalReadOp 27) (digitalReadOp 16))
  } else {
    return (booleanConstant false)
  }
}

to bot3D_set_speed power {
  _3dBotPower = power
  imagina_set_motor_speed 'Motor A' _3dBotPower
  imagina_set_motor_speed 'Motor B' _3dBotPower
}

module 'CoCube Emoji'
author 'Shuai Liang'
version 1 1 
depends '_Graphics and Displays/8 Bit Graphics' 
choices emoji_Menu happy naughty 'star-struck' kiss laughing neutral smug crying sleeping awkward shocked nerdy cool scared angry cold hot nauseated vomiting dizzy 
description 'Show emojis on the TFT Screen. The emojis are stored in BMP format in the _emoji/ directory.'

  spec ' ' 'set emoji' 'set emoji _ scale _' 'menu.emoji_Menu menu.range:1-5' 'happy' 4

to 'set emoji' emoji scale {
  '8bit_set scale _' (scale + 3)
  local 'file' ('[data:join]' '_emoji/' emoji '.bmp')
  '8bit_set palette' ('8bit_palette from BMP file' file)
  local 'offset' 3
  if (scale == 1) {
    offset = 18
  } (scale == 2) {
    offset = 12
  } (scale == 3) {
    offset = 8
  } (scale == 4) {
    offset = 5
  }
  '8bit_merge' ('8bit_bitmap from BMP file' file) offset offset
  '8bit_draw buffer'
  '[file:close]' file
}

module 'CoCube Module'
author 'Liang Shuai'
version 1 15
depends _Servo NeoPixel
choices trackerMenu '1' '2' '3' '4' '5' all
choices adc_channel A0 A1 A2
description 'External modules of CoCube.

CoCube is a tabletop modular multi-robot platform for education and research.
https://www.cocubefun.com/
https://wiki.cocube.fun/
sliang23@m.fudan.edu.cn

Note: All functions start by turning on pin 13 to power the module.
The power pin is off by default and is also turned off by the IDE stop button.'
variables _cc_cam_init_flag _cc_asr_snc _cc_PCF8574_address

  spec ' ' 'ccmodule_gripper open' 'gripper open'
  spec ' ' 'ccmodule_gripper close' 'gripper close'
  spec ' ' 'ccmodule_gripper degree' 'gripper degrees _ (0 to 70)' 'num' 0
  spec ' ' 'ccmodule_gripper stop' 'gripper stop'
  space
  spec ' ' 'ccmodule_attach NeoPixels' 'attach NeoPixels'
  spec ' ' 'ccmodule_set all NeoPixels color' 'set all NeoPixels color _' 'color'
  spec ' ' 'ccmodule_clear NeoPixels' 'clear NeoPixels'
  space
  spec 'r' 'ccmodule_ToF connected' 'ToF connected'
  spec 'r' 'ccmodule_ToF distance' 'ToF distance (mm)'
  space
  spec 'r' 'ccmodule_DLight level' 'DLight level'
  space
  spec 'r' 'ccmodule_ASR get command' 'ASR get command'
  spec ' ' 'ccmodule_ASR play command' 'ASR play command _' 'num' 19
  space
  spec 'r' 'ccmodule_tracker on black' 'Tracker _ on black' 'menu.trackerMenu' 1
  spec 'r' 'ccmodule_tracker on white' 'Tracker _ on white' 'menu.trackerMenu' 1
  space
  spec 'r' 'ccmodule_adc_connected' 'ADC connected'
  spec 'r' 'ccmodule_adc_voltage' 'ADC _ voltage (mV)' 'menu.adc_channel' 'A0'
  space
  spec ' ' 'ccmodule_power on module' 'power on module'
  space
  spec ' ' '_ccmodule_check_camera' 'check_camera'

to 'ccmodule_adc_connected' {
  digitalWriteOp 13 true
  return ('[sensors:i2cExists]' (hexToInt '48'))
}

to 'ccmodule_adc_voltage' channel {
  if (not ('ccmodule_adc_connected')) {return 0}
  local 'config_high' (hexToInt 'C1')
  if (channel == 'A1') {
    config_high = (hexToInt 'D1')
  } (channel == 'A2') {
    config_high = (hexToInt 'E1')
  }
  '[sensors:i2cWrite]' (hexToInt '48') ('[data:makeList]' 1 config_high (hexToInt '83'))
  waitMillis 9
  '[sensors:i2cWrite]' (hexToInt '48') ('[data:makeList]' 0)
  local 'buffer' ('[data:newByteArray]' 2)
  '[sensors:i2cRead]' (hexToInt '48') buffer
  local 'raw' (((at 1 buffer) << 8) | (at 2 buffer))
  if (raw >= 32768) {
    raw = (raw - 65536)
  }
  return (((maximum 0 raw) * 3) / 16)
}

to '_ccmodule_check_camera' {
  if (_cc_cam_init_flag == 1) {
    '[sensors:i2cWrite]' (hexToInt '58') ('[data:asByteArray]' ('[data:makeList]' (hexToInt '3') 255))
  } else {
    stopServo 22
    digitalWriteOp 13 true
  }
}

to 'ccmodule_ASR get command' {
  '_ccmodule_check_camera'
  waitMillis 30
  '[sensors:i2cWrite]' (hexToInt '64') (hexToInt '2') false
  local 'data' (newList 2)
  '[sensors:i2cRead]' (hexToInt '64') data
  local 'new_asr_snc' (at 1 data)
  if (_cc_asr_snc != new_asr_snc) {
    _cc_asr_snc = new_asr_snc
    return (at 2 data)
  } else {
    return 0
  }
}

to 'ccmodule_ASR play command' id {
  '_ccmodule_check_camera'
  '[sensors:i2cWrite]' (hexToInt '64') ('[data:asByteArray]' ('[data:makeList]' (hexToInt '3') id (id + 3) (hexToInt '5A')))
}

to 'ccmodule_DLight level' {
  if (_cc_cam_init_flag == 1) {
    '[sensors:i2cWrite]' (hexToInt '58') ('[data:asByteArray]' ('[data:makeList]' (hexToInt '3') 255))
  } else {
    stopServo 22
    digitalWriteOp 13 true
  }
  i2cSet (hexToInt '23') 23 (hexToInt '21')
  read = (newList 2)
  '[sensors:i2cRead]' (hexToInt '23') read
  return (((at 1 read) << 8) | (at 2 read))
}

to 'ccmodule_ToF connected' {
  '_ccmodule_check_camera'
  return ((i2cGet 41 (hexToInt 'C0')) == (hexToInt 'EE'))
}

to 'ccmodule_ToF distance' {
  '_ccmodule_check_camera'
  i2cSet 41 0 1
  waitMillis 70
  if (((i2cGet 41 (hexToInt '14')) & 1) == 1) {
    '[sensors:i2cWrite]' 41 ('[data:makeList]' (hexToInt '14'))
    local 'buf' (newList 12)
    '[sensors:i2cRead]' 41 buf
    if ((at 1 buf) == 95) {
      return (((at 11 buf) << 8) | (at 12 buf))
    } else {
      return -1
    }
  } else {
    return -2
  }
}

to 'ccmodule_attach NeoPixels' {
  if (_cc_cam_init_flag == 1) {
    sayIt 'AI camera doesn''t support this module. Please connect directly.'
  } else {
    stopServo 22
    digitalWriteOp 13 true
    waitMillis 10
    neoPixelAttach 48 22
  }
}

to 'ccmodule_clear NeoPixels' {
  digitalWriteOp 13 true
  clearNeoPixels
}

to 'ccmodule_gripper close' {
  if (_cc_cam_init_flag == 1) {
    '[sensors:i2cWrite]' (hexToInt '58') ('[data:asByteArray]' ('[data:makeList]' (hexToInt '2') 0 28))
  } else {
    digitalWriteOp 13 true
    setServoAngle 22 -70
  }
}

to 'ccmodule_gripper degree' degree {
  if (_cc_cam_init_flag == 1) {
    stopServo 22
    local 'hex' (7168 - ((degree * 2048) / 70))
    '[sensors:i2cWrite]' (hexToInt '58') ('[data:asByteArray]' ('[data:makeList]' (hexToInt '2') (hex & (hexToInt 'FF')) (hex >> 8)))
  } else {
    digitalWriteOp 13 true
    local 'var' (degree - 70)
    if (var < -70) {
      setServoAngle 22 -70
    } (var > 0) {
      setServoAngle 22 0
    } else {
      setServoAngle 22 var
    }
  }
}

to 'ccmodule_gripper open' {
  if (_cc_cam_init_flag == 1) {
    '[sensors:i2cWrite]' (hexToInt '58') ('[data:asByteArray]' ('[data:makeList]' (hexToInt '2') 0 20))
  } else {
    digitalWriteOp 13 true
    setServoAngle 22 0
  }
}

to 'ccmodule_gripper stop' {
  if (_cc_cam_init_flag == 1) {
    '[sensors:i2cWrite]' (hexToInt '58') ('[data:asByteArray]' ('[data:makeList]' (hexToInt '2') 0 0))
  } else {
    digitalWriteOp 13 true
    stopServo 22
  }
}

to 'ccmodule_power on module' {
  digitalWriteOp 13 true
}

to 'ccmodule_set all NeoPixels color' color {
  digitalWriteOp 13 true
  neoPixelSetAllToColor color
}

to 'ccmodule_tracker on black' which {
  if (_cc_PCF8574_address != 32) {
    stopServo 22
    digitalWriteOp 13 true
    waitMillis 100
    _cc_PCF8574_address = 32
    if ((i2cGet _cc_PCF8574_address 0) < 0) {
      sayIt 'init fail, please check i2c address and try again.'
      return 0
    }
    '[sensors:i2cWrite]' _cc_PCF8574_address ('[data:makeList]' (hexToInt 'FF'))
  }
  local 'var' (newList 1)
  '[sensors:i2cRead]' _cc_PCF8574_address var
  if ('all' == which) {
    if ((at 1 var) == 7) {return (booleanConstant true)}
  } else {
    return (not ('[data:convertType]' (1 & ((at 1 var) >> (8 - which))) 'boolean'))
  }
}

to 'ccmodule_tracker on white' which {
  if (_cc_PCF8574_address != 32) {
    stopServo 22
    digitalWriteOp 13 true
    waitMillis 100
    _cc_PCF8574_address = 32
    if ((i2cGet _cc_PCF8574_address 0) < 0) {
      sayIt 'init fail, please check i2c address and try again.'
      return 0
    }
    '[sensors:i2cWrite]' _cc_PCF8574_address ('[data:makeList]' (hexToInt 'FF'))
  }
  local 'var' (newList 1)
  '[sensors:i2cRead]' _cc_PCF8574_address var
  if ('all' == which) {
    if ((at 1 var) == 255) {return (booleanConstant true)}
  } else {
    return ('[data:convertType]' (1 & ((at 1 var) >> (8 - which))) 'boolean')
  }
}
module 'CoCube Sengo1' Input
author 'You Zhongrui, Liang Shuai'
version 1 0 
depends 'Robots/CoCube' _Servo 
tags 'cocube robot' 
choices sg1_result_Menu x y w h 
choices sg1_line_menu x1 y1 x2 y2 degree 
choices sg1_color_Menu black white red green blue yellow 
choices sg1_rgb_Menu R G B 
choices sg1_algo_Menu 'Color Recog' 'Blob Detect' 'Ball Detect' 'Line Detect' 'Card Recog' 'Face Recog' QRcode 
description 'Sengo1 AI Camera Module for CoCube robot

CoCube is a tabletop modular multi-robot platform for education and research.
https://www.cocubefun.com/
https://wiki.cocube.fun/
sliang23@m.fudan.edu.cn

'
variables _cc_cam_init_flag _sg1_i2c_address _sg1_color_classes _sg1_algo_list _sg1_card_classes _sg1_current_algo 

  spec ' ' 'Sengo1 init' 'Sengo1 init'
  spec ' ' 'Sengo1 change algorithm' 'Sengo1 change algorithm _' 'menu.sg1_algo_Menu' 'Card Recog'
  spec ' ' 'Sengo1 reset' 'Sengo1 reset'
  space
  spec ' ' 'Sengo1 set color recog area' 'Sengo1 set color recog area x _ y _ width _ height _ (0-100)' 'num num num num' 50 50 3 4
  spec 'r' 'Sengo1 read color' 'Sengo1 read color'
  spec 'r' 'Sengo1 get color RGB' 'Sengo1 get color _' 'menu.sg1_rgb_Menu' 'R'
  space
  spec ' ' 'Sengo1 set blob detect property' 'Sengo1 set blob detect property color _ width _ height _' 'menu.sg1_color_Menu num num' 'red' 3 4
  spec 'r' 'Sengo1 read blob' 'Sengo1 read blob'
  spec 'r' 'Sengo1 get blob' 'Sengo1 get blob _' 'menu.sg1_result_Menu' 'x'
  space
  spec 'r' 'Sengo1 detect ball' 'Sengo1 detect ball (ping pong or tennis)'
  spec 'r' 'Sengo1 get ball' 'Sengo1 get ball _' 'menu.sg1_result_Menu' 'x'
  space
  spec 'r' 'Sengo1 get line' 'Sengo1 get line _' 'menu.sg1_line_menu' 'degree'
  space
  spec 'r' 'Sengo1 read card' 'Sengo1 read card'
  spec 'r' 'Sengo1 get card' 'Sengo1 get card _' 'menu.sg1_result_Menu' 'x'
  space
  spec ' ' 'Sengo1 record face ID' 'Sengo1 record face ID _ (1-10)' 'num' 1
  spec ' ' 'Sengo1 delete face ID' 'Sengo1 delete face ID _ (1-10)' 'num' 1
  spec 'r' 'Sengo1 get face ID' 'Sengo1 get face ID'
  spec 'r' 'Sengo1 get face' 'Sengo1 get face _' 'menu.sg1_result_Menu' 'x'
  space
  spec 'r' 'Sengo1 QRcode' 'Sengo1 read QRcode'
  spec 'r' 'Sengo1 get QRcode' 'Sengo1 get QRcode _' 'menu.sg1_result_Menu' 'x'
  space
  spec ' ' '_sg1_init' '_sg1_init'
  spec ' ' '_sg1_reset_current_algo' '_sg1_reset_current_algo'
  spec 'r' '_sg1_read_reg_byte' '_sg1_read_reg_byte _' 'num' 0
  spec 'r' '_sg1_get_param' '_sg1_get_param algo _ tag _' 'num menu.sg1_result_Menu' 1 'x'

to 'Sengo1 QRcode' {
  if (_sg1_current_algo != 9) {
    return 'Mode Error'
  } ((i2cGet _sg1_i2c_address (hexToInt '34')) != 0) {
    i2cSet _sg1_i2c_address (hexToInt '20') 9
    i2cSet _sg1_i2c_address (hexToInt '35') 1
    local 'qr_length' ('_sg1_read_reg_byte' (hexToInt '88'))
    local 'ret' ''
    for i qr_length {
      local 'result_id' (((i - 1) / 5) + 2)
      local 'offset' ((i - 1) % 5)
      if (((i - 1) % 5) == 0) {
        i2cSet _sg1_i2c_address (hexToInt '35') result_id
      }
      ret = ('[data:join]' ret ('[data:unicodeString]' (i2cGet _sg1_i2c_address ((hexToInt '81') + (offset * 2)))))
    }
    return ret
  }
}

to 'Sengo1 change algorithm' mode {
  if (_cc_cam_init_flag == 0) {'Sengo1 init'}
  '_sg1_reset_current_algo'
  _sg1_current_algo = ('[data:find]' mode _sg1_algo_list)
  i2cSet _sg1_i2c_address (hexToInt '20') _sg1_current_algo
  i2cSet _sg1_i2c_address (hexToInt '21') 1
  waitMillis 5
}

to 'Sengo1 delete face ID' id {
  if (_sg1_current_algo != 8) {
    sayIt 'Mode Error'
    return 0
  }
  i2cSet _sg1_i2c_address (hexToInt '20') 8
  i2cSet _sg1_i2c_address (hexToInt '24') id
  waitMillis 5
  i2cSet _sg1_i2c_address (hexToInt '79') (0 & (hexToInt 'FF'))
}

to 'Sengo1 detect ball' {
  if (_sg1_current_algo != 3) {
    return 'Mode Error'
  } ((i2cGet _sg1_i2c_address (hexToInt '34')) != 0) {
    i2cSet _sg1_i2c_address (hexToInt '20') 3
    i2cSet _sg1_i2c_address (hexToInt '35') 1
    if (('_sg1_read_reg_byte' (hexToInt '88')) == 1) {
      return 'ping pong'
    } (('_sg1_read_reg_byte' (hexToInt '88')) == 2) {
      return 'tennis ball'
    } else {
      return (booleanConstant false)
    }
  }
}

to 'Sengo1 get QRcode' tag {
  return ('_sg1_get_param' 9 tag)
}

to 'Sengo1 get ball' tag {
  return ('_sg1_get_param' 3 tag)
}

to 'Sengo1 get blob' tag {
  return ('_sg1_get_param' 2 tag)
}

to 'Sengo1 get card' tag {
  return ('_sg1_get_param' 6 tag)
}

to 'Sengo1 get color RGB' tag {
  if (_sg1_current_algo != 1) {
    return 'Mode Error'
  } ((i2cGet _sg1_i2c_address (hexToInt '34')) != 0) {
    i2cSet _sg1_i2c_address (hexToInt '20') 1
    i2cSet _sg1_i2c_address (hexToInt '35') 1
    if (tag == 'R') {
      return ('_sg1_read_reg_byte' (hexToInt '80'))
    }
    if (tag == 'G') {
      return ('_sg1_read_reg_byte' (hexToInt '82'))
    }
    if (tag == 'B') {
      return ('_sg1_read_reg_byte' (hexToInt '84'))
    }
  } else {
  }
}

to 'Sengo1 get face' tag {
  return ('_sg1_get_param' 8 tag)
}

to 'Sengo1 get face ID' {
  if (_sg1_current_algo != 8) {
    return 'Mode Error'
  } ((i2cGet _sg1_i2c_address (hexToInt '34')) != 0) {
    i2cSet _sg1_i2c_address (hexToInt '20') 8
    i2cSet _sg1_i2c_address (hexToInt '35') 1
    return ('_sg1_read_reg_byte' (hexToInt '88'))
  } else {
  }
}

to 'Sengo1 get line' tag {
  if (_sg1_current_algo != 4) {
    return 'Mode Error'
  } ((i2cGet _sg1_i2c_address (hexToInt '34')) != 0) {
    i2cSet _sg1_i2c_address (hexToInt '20') 4
    i2cSet _sg1_i2c_address (hexToInt '35') 1
    if (tag == 'x1') {
      return ('_sg1_read_reg_byte' (hexToInt '80'))
    }
    if (tag == 'y1') {
      return ('_sg1_read_reg_byte' (hexToInt '82'))
    }
    if (tag == 'x2') {
      return ('_sg1_read_reg_byte' (hexToInt '84'))
    }
    if (tag == 'y2') {
      return ('_sg1_read_reg_byte' (hexToInt '86'))
    }
    if (tag == 'degree') {
      return ('_sg1_read_reg_byte' (hexToInt '88'))
    }
  }
}

to 'Sengo1 init' {
  stopServo 22
  digitalWriteOp 13 true
  '_sg1_init'
  repeatUntil ((i2cGet _sg1_i2c_address 1) == 6) {
    _cc_cam_init_flag = 1
  }
}

to 'Sengo1 read blob' {
  if (_sg1_current_algo != 2) {
    return 'Mode Error'
  } ((i2cGet _sg1_i2c_address (hexToInt '34')) != 0) {
    i2cSet _sg1_i2c_address (hexToInt '20') 2
    i2cSet _sg1_i2c_address (hexToInt '35') 1
    local 'var' ('_sg1_read_reg_byte' (hexToInt '88'))
    if (var <= 6) {
      return (at var _sg1_color_classes)
    } else {
      return (booleanConstant false)
    }
  }
}

to 'Sengo1 read card' {
  if (_sg1_current_algo != 6) {
    return 'Mode Error'
  } ((i2cGet _sg1_i2c_address (hexToInt '34')) != 0) {
    i2cSet _sg1_i2c_address (hexToInt '20') 6
    i2cSet _sg1_i2c_address (hexToInt '35') 1
    local 'var' ('_sg1_read_reg_byte' (hexToInt '88'))
    if (and (var <= 10) (var >= 1)) {
      return (at var _sg1_card_classes)
    }
  }
}

to 'Sengo1 read color' {
  if (_sg1_current_algo != 1) {
    return 'Mode Error'
  } ((i2cGet _sg1_i2c_address (hexToInt '34')) != 0) {
    i2cSet _sg1_i2c_address (hexToInt '20') 1
    i2cSet _sg1_i2c_address (hexToInt '35') 1
    local 'var' ('_sg1_read_reg_byte' (hexToInt '88'))
    if (var == 0) {
      return (at 'last' _sg1_color_classes)
    } else {
      return (at var _sg1_color_classes)
    }
  }
}

to 'Sengo1 record face ID' id {
  if (_sg1_current_algo != 8) {
    sayIt 'Mode Error'
    return 0
  }
  i2cSet _sg1_i2c_address (hexToInt '20') 8
  i2cSet _sg1_i2c_address (hexToInt '24') id
  waitMillis 5
  i2cSet _sg1_i2c_address (hexToInt '79') (100 & (hexToInt 'FF'))
}

to 'Sengo1 reset' {
  for i 9 {
    i2cSet _sg1_i2c_address (hexToInt '20') i
    i2cSet _sg1_i2c_address (hexToInt '21') 0
    waitMillis 5
  }
  waitMillis 100
}

to 'Sengo1 set blob detect property' color w h {
  if (_sg1_current_algo != 2) {
    sayIt 'Mode Error'
    return 0
  }
  i2cSet _sg1_i2c_address (hexToInt '20') 2
  i2cSet _sg1_i2c_address (hexToInt '24') 1
  waitMillis 5
  i2cSet _sg1_i2c_address (hexToInt '75') (w & (hexToInt 'FF'))
  i2cSet _sg1_i2c_address (hexToInt '77') (h & (hexToInt 'FF'))
  i2cSet _sg1_i2c_address (hexToInt '79') (('[data:find]' color _sg1_color_classes) & (hexToInt 'FF'))
}

to 'Sengo1 set color recog area' x y w h {
  if (_sg1_current_algo != 1) {
    sayIt 'Mode Error'
    return 0
  }
  if (or (x <= (w / 2)) (or (y <= (h / 2)) (or (x >= (100 - (w / 2))) (y >= (100 - (h / 2)))))) {
    sayIt 'range error'
  } else {
    i2cSet _sg1_i2c_address (hexToInt '20') 1
    i2cSet _sg1_i2c_address (hexToInt '24') 1
    waitMillis 5
    i2cSet _sg1_i2c_address (hexToInt '71') (x & (hexToInt 'FF'))
    i2cSet _sg1_i2c_address (hexToInt '73') (y & (hexToInt 'FF'))
    i2cSet _sg1_i2c_address (hexToInt '75') (w & (hexToInt 'FF'))
    i2cSet _sg1_i2c_address (hexToInt '77') (h & (hexToInt 'FF'))
  }
}

to '_sg1_get_param' algo tag {
  if (_sg1_current_algo != algo) {return 'Mode Error'}
  if ((i2cGet _sg1_i2c_address (hexToInt '34')) != 0) {
    i2cSet _sg1_i2c_address (hexToInt '20') algo
    i2cSet _sg1_i2c_address (hexToInt '35') 1
    if (tag == 'x') {
      return ('_sg1_read_reg_byte' (hexToInt '80'))
    }
    if (tag == 'y') {
      return ('_sg1_read_reg_byte' (hexToInt '82'))
    }
    if (tag == 'w') {
      return ('_sg1_read_reg_byte' (hexToInt '84'))
    }
    if (tag == 'h') {
      return ('_sg1_read_reg_byte' (hexToInt '86'))
    }
  }
}

to '_sg1_init' {
  comment 'default i2c address 0x60 96'
  _sg1_i2c_address = 96
  _sg1_algo_list = ('[data:makeList]' 'Color Recog' 'Blob Detect' 'Ball Detect' 'Line Detect' 'none' 'Card Recog' 'Body Detect' 'Face Recog' 'QRcode')
  _sg1_color_classes = ('[data:makeList]' 'black' 'white' 'red' 'green' 'blue' 'yellow')
  _sg1_card_classes = ('[data:makeList]' 'forward' 'left' 'right' 'back' 'park')
}

to '_sg1_read_reg_byte' reg {
  local 'LOW' (i2cGet _sg1_i2c_address (reg + 1))
  local 'HIGH' (i2cGet _sg1_i2c_address reg)
  local 'ret' ((HIGH << 4) | LOW)
  return ret
}

to '_sg1_reset_current_algo' {
  i2cSet _sg1_i2c_address (hexToInt '20') _sg1_current_algo
  i2cSet _sg1_i2c_address (hexToInt '21') 0
  waitMillis 5
}

module 'CoCube Sengo2' Input
author 'You Zhongrui, Liang Shuai'
version 1 1 
depends 'Robots/CoCube' _Servo '_Distance (VL53L0X)' 
tags 'cocube robot' 
choices sg2_result_Menu x y w h 
choices sg2_rgb_Menu R G B 
choices sg2AprilTagMenu '16H5' '25H9' '36H11' 
choices sg2_algo_Menu 'Color Recog' 'Blob Detect' AprilTag 'Line Detect' 'Deep Learning' 'Card Recog' 'Face Recog' Obj20Class QRcode 'Motion Detect' 
choices sg2_color_Menu black white red green blue yellow 
choices sg2_line_menu x1 y1 x2 y2 degree 
description 'Sengo2 AI Camera Module for CoCube robot

CoCube is a tabletop modular multi-robot platform for education and research.
https://www.cocubefun.com/
https://wiki.cocube.fun/
sliang23@m.fudan.edu.cn

v1.0 Basic functions 2025.04.27
v1.1 Delete Sengo2 + CoCube Module function 2025.04.28
'
variables _sg2_i2c_address _sg2_algo_list _sg2_current_algo _cc_cam_init_flag _sg2_color_classes _sg2_card_classes _sg2_20class_classes 

  spec ' ' 'Sengo2 init' 'Sengo2 init'
  spec ' ' 'Sengo2 change algorithm' 'Sengo2 change algorithm _' 'menu.sg2_algo_Menu' 'Color Recog'
  spec ' ' 'Sengo2 reset' 'Sengo2 reset'
  space
  spec ' ' 'Sengo2 set color recog area' 'Sengo2 set color recog area x _ y _ width _ height _ (0-100)' 'num num num num' 50 50 3 4
  spec 'r' 'Sengo2 read color' 'Sengo2 read color'
  spec 'r' 'Sengo2 get color RGB' 'Sengo2 get color _' 'menu.sg2_rgb_Menu' 'R'
  space
  spec ' ' 'Sengo2 set blob detect property' 'Sengo2 set blob detect property color _ width _ height _' 'menu.sg2_color_Menu num num' 'red' 3 4
  spec 'r' 'Sengo2 read blob' 'Sengo2 read blob'
  spec 'r' 'Sengo2 get blob' 'Sengo2 get blob _' 'menu.sg2_result_Menu' 'x'
  space
  spec ' ' 'Sengo2 set AprilTag type' 'Sengo2 set AprilTag type _' 'menu.sg2AprilTagMenu' '36H11'
  spec 'r' 'Sengo2 read AprilTag' 'Sengo2 read AprilTag'
  spec 'r' 'Sengo2 get AprilTag' 'Sengo2 get AprilTag _' 'menu.sg2_result_Menu' 'x'
  space
  spec 'r' 'Sengo2 get line' 'Sengo2 get line _' 'menu.sg2_line_menu' 'degree'
  space
  spec ' ' 'Sengo2 record learning ID' 'Sengo2 record learning ID _ (1-15)' 'num' 1
  spec ' ' 'Sengo2 delete learning ID' 'Sengo2 delete learning ID _ (1-15)' 'num' 1
  spec 'r' 'Sengo2 get learning ID' 'Sengo2 get learning ID'
  space
  spec 'r' 'Sengo2 read card' 'Sengo2 read card'
  spec 'r' 'Sengo2 get card' 'Sengo2 get card _' 'menu.sg2_result_Menu' 'x'
  space
  spec ' ' 'Sengo2 record face ID' 'Sengo2 record face ID _ (1-10)' 'num' 1
  spec ' ' 'Sengo2 delete face ID' 'Sengo2 delete face ID _ (1-10)' 'num' 1
  spec 'r' 'Sengo2 get face ID' 'Sengo2 get face ID'
  space
  spec 'r' 'Sengo2 read Obj20Class' 'Sengo2 read Obj20Class'
  spec 'r' 'Sengo2 get Obj20Class' 'Sengo2 get Obj20Class _' 'menu.sg2_result_Menu' 'x'
  space
  spec 'r' 'Sengo2 QRcode' 'Sengo2 read QRcode'
  spec 'r' 'Sengo2 get QRcode' 'Sengo2 get QRcode _' 'menu.sg2_result_Menu' 'x'
  space
  spec 'r' 'Sengo2 get motion' 'Sengo2 get motion _' 'menu.sg2_result_Menu' 'x'
  space
  spec ' ' '_sg2_init' '_sg2_init'
  spec 'r' '_sg2_read_reg_byte' '_sg2_read_reg_byte _' 'num' 0
  spec ' ' '_sg2_reset_current_algo' '_sg2_reset_current_algo'

to 'Sengo2 QRcode' {
  if ((i2cGet _sg2_i2c_address (hexToInt '34')) != 0) {
    i2cSet _sg2_i2c_address (hexToInt '20') 9
    i2cSet _sg2_i2c_address (hexToInt '35') 1
    local 'qr_length' ('_sg2_read_reg_byte' (hexToInt '88'))
    local 'ret' ''
    for i qr_length {
      local 'result_id' (((i - 1) / 5) + 2)
      local 'offset' ((i - 1) % 5)
      if (((i - 1) % 5) == 0) {
        i2cSet _sg2_i2c_address (hexToInt '35') result_id
      }
      ret = ('[data:join]' ret ('[data:unicodeString]' (i2cGet _sg2_i2c_address ((hexToInt '81') + (offset * 2)))))
    }
    return ret
  }
}

to 'Sengo2 change algorithm' mode {
  if (_cc_cam_init_flag == 0) {'Sengo2 init'}
  '_sg2_reset_current_algo'
  _sg2_current_algo = ('[data:find]' mode _sg2_algo_list)
  i2cSet _sg2_i2c_address (hexToInt '20') _sg2_current_algo
  i2cSet _sg2_i2c_address (hexToInt '21') 1
  waitMillis 5
}

to 'Sengo2 delete face ID' id {
  i2cSet _sg2_i2c_address (hexToInt '20') 7
  i2cSet _sg2_i2c_address (hexToInt '24') id
  waitMillis 5
  i2cSet _sg2_i2c_address (hexToInt '79') (0 & (hexToInt 'FF'))
}

to 'Sengo2 delete learning ID' id {
  i2cSet _sg2_i2c_address (hexToInt '20') 5
  i2cSet _sg2_i2c_address (hexToInt '24') id
  waitMillis 5
  i2cSet _sg2_i2c_address (hexToInt '79') (0 & (hexToInt 'FF'))
}

to 'Sengo2 get AprilTag' tag {
  if ((i2cGet _sg2_i2c_address (hexToInt '34')) != 0) {
    i2cSet _sg2_i2c_address (hexToInt '20') 3
    i2cSet _sg2_i2c_address (hexToInt '35') 1
    if (tag == 'x') {
      return ('_sg2_read_reg_byte' (hexToInt '80'))
    }
    if (tag == 'y') {
      return ('_sg2_read_reg_byte' (hexToInt '82'))
    }
    if (tag == 'w') {
      return ('_sg2_read_reg_byte' (hexToInt '84'))
    }
    if (tag == 'h') {
      return ('_sg2_read_reg_byte' (hexToInt '86'))
    }
  }
}

