msgstr "NeoPanel dessiner une ligne de x _ y _ à x _ y _ couleur _"

#. NeoPanel library block
msgid "NeoPanel draw circle at x _ y _ radius _ color _"
msgstr "NeoPanel dessiner un cercle à x _ y _ rayon _ couleur _"

#. NeoPanel library block
msgid "NeoPanel draw rectangle at x _ y _ width _ height _ color _"
msgstr "NeoPanel dessiner un rectangle à x _ y _ largeur _ hauteur _ couleur _"

#. Microphone library block
msgid "turn off microphone"
msgstr "éteindre le micro"

#. Lists library block. It takes a list and replaces a few, some, most or (list of indices) items with some other element
msgid "_ with _ items replaced by _"
msgstr "_ avec _ éléments remplacés par _"

#. Radio library block
msgid "radio last sender ID"
msgstr "radio ID du dernier expéditeur"

#. Radio library block
msgid "radio my ID"
msgstr "radio mon ID"

#. 5x5 LED Display library block
msgid "LED image #BR# _"
msgstr "Image LED #BR# _"

#. OLED Graphics library block
msgid "initialize i2c(auto) reset pin# _ flip _"
msgstr "initialiser i2c(auto) broche de réinit# _ retourner _"

#. TFT Display library block
msgid "draw pixel row _ x _ y _"
msgstr "dessiner ligne de pixels _ x _ y _"

#. TFT Display library block
msgid "draw image _ on TFT at x _ y _ color _"
msgstr "dessiner l'image _ sur TFT à x _ y _ couleur _"

#. TFT Display library block
msgid "#BR# scale _"
msgstr "#BR# échelle _"

#. TFT Display library block
msgid "image _"
msgstr "image _"

#. TFT Display library block
msgid "invert TFT display _"
msgstr "inverser l'affichage TFT _"

#. External Displays Library block
