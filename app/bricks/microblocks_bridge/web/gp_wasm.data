msgid "Save the firmware file when prompted."
msgstr "Guarda el archivo de firmware cuando se te pida."

#. Settings menu option
msgid "dark mode"
msgstr "modo oscuro"

#. String in file picker and library dialogs
msgid "Could not fetch library."
msgstr "No se pudo obtener la biblioteca."

#. String in file picker and library dialogs
msgid "Host does not exist or is currently down."
msgstr "El servidor no existe o está fuera de servicio."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Block Category"
msgstr "Categoría de bloques"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Drag blocks from here to build scripts. Drop scripts here to delete them."
msgstr ""
"Arrastra bloques des de aquí hasta la zona de programación para construir "
"programas. Arrastra programas hasta aquí para eliminarlos."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Turn the user LED on or off."
msgstr "Enciende o apaga el LED de usuario."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Report the state of button A ( (-o) or (o-) )."
msgstr "Reporta el estado del botón A ( (-o) o (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the milliseconds since power up."
msgstr "Reporta los milisegundos des de que se encendió la placa."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a number proportional to the voltage on an analog pin (0 = ground, 1023 = supply voltage)."
msgstr ""
"Reporta un número proporcional al voltaje en un pin analógico (0 = tierra, "
"1023 = voltaje suministrado)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send multiple bytes to an I2C device."
msgstr "Envía múltiples bytes a un dispositivo I2C."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Read a byte from an SPI device while sending a zero byte. Report the byte received."
msgstr ""
"Lee un byte de un dispositivo SPI, y envía un byte cero. Reporta el byte "
"recibido."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Run the first set of blocks whose test condition is (-o) ."
msgstr ""
"Ejecuta el primer grupo de bloques para los cuales la condición sea (-o) ."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Run when the condition becomes (-o) ."
msgstr "Ejecuta cuando la condición sea (-o) ."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Return (report) the given value from a function or script."
msgstr "Retorna (reporta) el valor especificado des de una función o programa."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Broadcast the given message."
msgstr "Emite el mensaje especificado."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Stop this task."
msgstr "Detén esta tarea."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Call the function with the given name and optional parameter list."
msgstr ""
"Ejecuta la función con el nombre especificado con la lista de parámetros "
"opcional proporcionada."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the sum of the given numbers."
msgstr "Reporta la suma de los números especificados."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the remainder of dividing the first number by the second."
msgstr "Reporta el residuo de dividir el primer número entre el segundo."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the maximum of the values."
msgstr "Reporta el mayor de los valores especificados."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the given number shifted left by the given number of bits."
msgstr ""
"Reporta el número especificado desplazado aritméticamente hacia la izquierda "
"el número de bits especificado."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the Nth item of a list, string, or byte array."
msgstr ""
"Reporta el elemento en la posición especificada de una lista, cadena de "
"texto o lista de bytes."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Delete the Nth item (or all items) of a list."
msgstr ""
"Elimina el elemento en la posición especificada (o todos los elementos) de "
"una lista."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a new list of the given length filled with zero or the optional value."
msgstr ""
"Reporta una nueva lista del tamaño especificado que contenga ceros (o el "
"valor opcional especificado) en todas sus posiciones."

