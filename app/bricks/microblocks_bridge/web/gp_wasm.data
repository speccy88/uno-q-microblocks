msgid "about;by %1, %2 & %3."
msgstr "por %1, %2 y %3."

#. MicroBlocks IDE information
msgid "For AdaFruit boards, double-click reset button and try again."
msgstr ""
"En placas AdaFruit, pulsa el botón de reseteo dos veces rápidamente y vuelve "
"a probar."

#. MicroBlocks IDE error message.
msgid "Only recent Chrome and Edge browsers support WebSerial."
msgstr ""
"WebSerial solo está suportado por las últimas versiones de Chrome y Edge."

#. MicroBlocks IDE information
msgid "Try to Install MicroBlocks on the board?"
msgstr "¿Quieres intentar instalar MicroBlocks en la placa?"

#. MicroBlocks IDE information
msgid "Try to update MicroBlocks on the board?"
msgstr "¿Quieres intentar actualizarlo?"

#. Scripting area right-click context menu
msgid "undrop (ctrl-Z)"
msgstr "deshaz el último movimiento (ctrl-Z)"

#. Scripting area right-click context menu
msgid "paste script from clipboard"
msgstr "pega el programa del portapapeles"

#. Scripting area right-click context menu
msgid "save a picture of all visible scripts"
msgstr "guarda una imagen de todos los programas visibles"

#. Scripting area right-click context menu
msgid "set exported script scale"
msgstr "fija la escala de la imagen a exportar"

#. Block size option
msgid "printable (200%)"
msgstr "para impresión (200%)"

#. Block selection right-click context menu
msgid "drag selection"
msgstr "arrastra selección"

#. Window title
msgid "About MicroBlocks"
msgstr "Acerca de MicroBlocks"

#. Graph context menu option
msgid "set serial delay"
msgstr "ajusta la latencia del puerto serie"

#. MicroBlocks IDE information
msgid "MicroBlocks HTTP Server listening on port 6473"
msgstr "El servidor HTTP de MicroBlocks está activo en el puerto 6473"

#. config confirmation
msgid "Allow the attached board to be connected via BLE?"
msgstr "¿Permitir que la placa conectada se pueda programar por BLE?"

#. Settings menu option
msgid "compact code store"
msgstr "compacta el código almacenado"

#. Settings menu option
msgid "install ESP firmware from URL"
msgstr "instalar firmware ESP desde una URL"

#. MicroBlocks IDE information
msgid "Drag the firmware file you just saved to the %1 drive."
msgstr ""
"Arrastra el archivo de firmware qua acabas de guardar hacia la unidad %1."

#. MicroBlocks IDE information
msgid "Board not connected"
msgstr "Placa no conectada"

#. Board wiping process information
msgid "Wiping board..."
msgstr "Borrando placa..."

#. Settings menu option
msgid "hide advanced blocks"
msgstr "oculta los bloques avanzados"

#. Graph context menu option
msgid "export data to CSV file"
msgstr "exportar datos a archivo CSV"

#. Graph context menu option
msgid "copy graph data to clipboard"
msgstr "copiar datos del gráfico al portapapeles"

#. Block right-click context menu
msgid "expand"
msgstr "expande"

#. Variable right-click context menu
msgid "find variable accessors"
msgstr "busca accesos a la variable"

#. Block right-click context menu
msgid "find uses of this block"
msgstr "busca usos de este bloque"

#. Block right-click context menu tooltip
msgid "find scripts or block definitions using this block"
msgstr ""
"busca programas o definiciones de bloque en qué se esté usando este bloque"

#. Block right-click context menu
msgid "help"
msgstr "ayuda"

#. Block right-click context menu
msgid "delete block"
msgstr "elimina bloque"

#. Block right-click context menu
msgid "copy to clipboard"
msgstr "copia al portapapeles"

#. Block right-click context menu
msgid "copy to clipboard as URL"
msgstr "copia al portapapeles como URL"

#. Block right-click context menu tooltip
msgid "show help for this block in a browser"
msgstr "muestra ayuda para este bloque en tu navegador"

#. Script right-click context menu
msgid "save picture of script"
msgstr "guarda la imagen del programa"

#. Script right-click context menu
msgid "save picture of script with result"
msgstr "guarda la imagen del programa con su resultado"

#. Script right-click context menu tooltip
msgid "save a picture of these blocks as a PNG file"
msgstr "guarda una imagen de estos bloques en formato PNG"

#. Script right-click context menu tooltip
msgid "save a picture of these blocks and their result as a PNG file"
msgstr "guarda una imagen de estos bloques y su resultado en formato PNG"

#. Block input right-click context menu
msgid "Input type:"
msgstr "Tipo de casilla:"

#. Block input right-click context menu option
msgid "string only"
msgstr "solo texto"

#. Block input right-click context menu option
msgid "number only"
msgstr "solo número"

#. Text right-click context menu option
msgid "stop editing"
msgstr "detén la edición"

#. Text right-click context menu option
msgid "accept"
msgstr "acepta"

#. Block definition right-click context menu option
msgid "hide block definition"
msgstr "oculta la definición de este bloque"

#. Library folder
msgid "LIBRARIES"
msgstr "BIBLIOTECAS"

#. Library label right click context menu option
msgid "export this library"
msgstr "exporta esta biblioteca"

#. Library folder
msgid "folder;Libraries"
msgstr "Bibliotecas"

#. Library folder
msgid "folder;Network"
msgstr "Red"

#. String in file picker and library dialogs
msgid "File Open"
msgstr "Abre fichero"

#. String in file picker and library dialogs
msgid "File Save"
msgstr "Guarda fichero"

#. String in file picker and library dialogs
msgid "File name:"
msgstr "Nombre del fichero:"

#. String in file picker and library dialogs
msgid "New Folder"
msgstr "Nueva carpeta"

#. String in file picker and library dialogs
msgid "File not found in server."
msgstr "No se ha encontrado el archivo en el servidor."

#. String in file picker and library dialogs
msgid "Server expects HTTPS, and MicroBlocks doesn't currently support it."
msgstr "El servidor requiere HTTPS, y MicroBlocks no lo soporta."

#. String in file picker and library dialogs
msgid "built-in library"
msgstr "biblioteca integrada"

#. String in file picker and library dialogs
msgid "Dependency path, name or URL?"
msgstr "¿Ruta, nombre o URL de la dependencia?"

#. String in file picker and library dialogs
msgid "If your library is in the Libraries folder in your local MicroBlocks project folder, you need to prefix it with a slash (/)."
msgstr ""
"Si la biblioteca está en la carpeta \"Libraries\" de tu carpeta local de "
"MicroBlocks, deberás prefijarla con una barra (/)."

#. String in file picker and library dialogs
msgid "user library"
msgstr "biblioteca de usuario"

#. String in file picker and library dialogs
msgid "Add Library"
msgstr "Añadir biblioteca"

#. Block size button tooltip
msgid "Decrease block size"
msgstr "Reduce el tamaño de los bloques"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Button"
msgstr "Botón"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Color Input"
msgstr "Casilla de color"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
msgid "[l] edit its value, or drop a reporter into it."
msgstr "[l] edita su valor, o arrastra un reportador encima."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Block Extension"
msgstr "Flecha de expansión"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Command Block"
msgstr "Bloque de comando"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Hat Block"
msgstr "Bloque de sombrero"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Reporter Block"
msgstr "Bloque reportador"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Script"
msgstr "Programa"

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
#. The [r] tag turns into an icon of a mouse with the right button pressed
msgid "[l] to run. [r] menu."
msgstr "[l] para ejecutarlo. [r] menú."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
msgid "Drag to change pane width."
msgstr "Arrástralo para modificar la anchura del área."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
#. The [r] tag turns into an icon of a mouse with the right button pressed
msgid "[l] to show the blocks in this library. [r] menu."
msgstr "[l] para mostrar los bloques de esta biblioteca. [r] menú."

#. Tip Bar label or text (at the bottom of the IDE, gives info on the currently hovered element)
#. The [l] tag turns into an icon of a mouse with the left button pressed
msgid "[l] to show the blocks in this category."
msgstr "[l] para mostrar los bloques de esta categoría."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Graph the value."
msgstr "Añade el valor al gráfico."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
#. The (o-) tag turns into an icon of a boolean input set to off, or false (red)
msgid "Report the state of button B ( (-o) or (o-) )."
msgstr "Reporta el estado del botón B ( (-o) o (o-) )."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the milliseconds since the timer was last reset."
msgstr ""
"Reporta los milisegundos des de la última inicialización del temporizador."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the microseconds since power up."
msgstr "Reporta los microsegundos des de que se encendió la placa."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the board type."
msgstr "Reporta el tipo de placa."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report number of digital pins on this device."
msgstr "Reporta el número de pines digitales en este dispositivo."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the value of a register (0-255) of an I2C device (0-127)."
msgstr "Reporta el valor de un registro (0-255) de un dispositivo I2C (0-127)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send a byte (0-255) to an SPI device."
msgstr "Envía un byte (0-255) a un dispositivo SPI."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report data received from the serial port (a byte array)."
msgstr "Reporta los datos recibidos por el puerto serie (una lista de bytes)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Receive multiple bytes from an I2C device."
msgstr "Recibe múltiples bytes de un dispositivo I2C."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Send a byte array to the serial port."
msgstr "Envía una lista de bytes por el puerto serie."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Run when the board powers up or when the IDE start button is clicked."
msgstr ""
"Ejecuta cuando la placa se encienda o al hacer click sobre el botón de "
"inicio."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Run when buttons A, B, or A+B are pressed."
msgstr "Ejecuta cuando se pulsen los botones A, B, o ambos a la vez."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Wait until the condition becomes (-o) ."
msgstr "Espera hasta que la condición sea (-o) ."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Do nothing. Used to add notes and documentation."
msgstr "No hagas nada. Se usa para añadir notas y documentación."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Repeat the enclosed blocks until the condition becomes (-o) ."
msgstr ""
"Repite la ejecución de los bloques que contiene, hasta que la condición sea "
"(-o) ."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Wait the given number of microseconds."
msgstr "Espera el numero de microsegundos especificado."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the last broadcast message received."
msgstr "Reporta el último mensaje emitido y recibido."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Call the function with the given name and optional parameter list and report its return value."
msgstr ""
"Llama la función con el nombre especificado con la lista de parámetros "
"opcional proporcionada, y reporta su valor de retorno."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Stop all tasks except this one."
msgstr "Detén todas las tareas excepto esta."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the absolute value of the given number (always >= 0)."
msgstr "Reporta el valor absoluto del número especificado (siempre >= 0)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the minimum of the values."
msgstr "Reporta el menor de los valores especificados."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a randomly chosen number in the given range."
msgstr "Reporta un número al azar dentro del rango especificado."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the first value is less than the second one."
msgstr "Reporta (-o) si el primer valor es menor que el segundo."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the first value is less than or equal to the second one."
msgstr "Reporta (-o) si el primer valor es menor o igual que el segundo."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the two values are not equal."
msgstr "Reporta (-o) si los dos valores son distintos."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if the first value is greater than or equal to the second one."
msgstr "Reporta (-o) si el primer valor es mayor o igual que el segundo."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if both values are (-o)"
msgstr "Reporta (-o) si ambos valores son (-o)"

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the numerical value of a hexadecimal string (range: -0x1FFFFFFF to 0x1FFFFFFF)"
msgstr ""
"Reporta el valor numérico decimal de una cadena de texto hexadecimal (rango: "
"-0x1FFFFFFF a 0x1FFFFFFF)"

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report bitwise AND of two numbers."
msgstr "Reporta la operación bit a bit \"y\" (AND) entre dos números."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report bitwise XOR (exclusive OR) of two numbers."
msgstr "Reporta la operación bit a bit \"o exclusiva\" (XOR) entre dos números."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the number of items in a list, string, or byte array."
msgstr ""
"Reporta el número de elementos de una lista, cadena de texto o lista de "
"bytes."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Join (concatenate) the given lists, strings, or byte arrays and report the result."
msgstr ""
"Reporta la unión (concatenación) de las listas, cadenas de texto o listes de "
"bytes especificadas."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
#. The (-o) tag turns into an icon of a boolean input set to on, or true (green)
msgid "Report (-o) if either value is (-o)"
msgstr "Reporta (-o) si alguno de los valores es (-o)"

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Find and report the index of an item in a list or a substring within a string. Report -1 if not found."
msgstr ""
"Busca y reporta la posición de un elemento en una lista, o una cadena de "
"texto dentro de otra. Reporta -1 si no se encuentra."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a copy from the given index through the end (or optional stop index) of the given list, string, or byte array."
msgstr ""
"Reporta una copia de una lista, cadena de texto o lista de bytes a partir de "
"la posición de inicio especificada y hasta el final (o hasta la posición "
"final opcional especificada)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Combine the items of a list into a string, optionally separated by a delimiter (e.g. comma)."
msgstr ""
"Combina los elementos de una lista en una cadena de texto, opcionalmente "
"separados por un delimitador (por ejemplo, una coma)."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Create and report a short list containing the given items. Length limited by available stack space."
msgstr ""
"Crea y reporta una lista con los elementos especificados. La largada de la "
"lista esta limitada al espacio disponible en la pila."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a string containing the given Unicode value (\"code point\") or list of values."
msgstr ""
"Reporta una cadena de texto formada por el valor o lista de valores Unicode "
"especificados."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report a byte array containing the UTF-8 bytes of the given string."
msgstr ""
"Reporta una lista de bytes que contenga los bytes UTF-8 de la cadena de "
"texto especificada."

#. Tip Bar text for a block (at the bottom of the IDE, gives info on the currently hovered block or input)
msgid "Report the number of words of memory available. Stop button frees up memory."
msgstr ""
"Reporta el número de palabras (grupos de 32 bits, o 4 bytes) de memoria "
"disponibles."

