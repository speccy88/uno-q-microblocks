#. The #BR# tag must be kept intact. It translates to a new line
msgid "#BR# reset pin _ invert colors _"
msgstr "#BR# broche de réinit _ inverser les couleurs _"

#. External Displays Library block
#. The #BR# tag must be kept intact. It translates to a new line
msgid "#BR# x offset _ y offset _"
msgstr "#BR# décalage x _ décalage y _"

#. External Displays Library block
#. The #BR# tag must be kept intact. It translates to a new line
msgid "attach ST7789 w _ h _ rotation _ #BR# dc pin _ cs pin _ backlight pin _"
msgstr ""
"attacher ST7789 larg _ haut _ rotation _ #BR# broche dc _ broche cs _ broche "
"rétroéclairage _"

#. External Displays Library block
#. The #BR# tag must be kept intact. It translates to a new line
msgid "attach ST7796 w _ h _ rotation _ #BR# dc pin _ cs pin _ backlight pin _"
msgstr ""
"attacher ST7796 larg _ haut _ rotation _ #BR# broche dc _ broche cs _ broche "
"rétroéclairage _"

#. External Displays Library block
msgid "attach ILI9341 rotation _ dc pin _ cs pin _ backlight pin _"
msgstr ""
"attacher ILI9341 rotation _ broche dc _ broche cs _ broche rétroéclairage _"

#. External Displays Library block
msgid "attach OLED w _ h _"
msgstr "attacher OLED larg _ haut _"

#. External Displays Library block
msgid "reset pin _"
msgstr "broche de réinit _"

#. External Displays Library block
msgid "detach display"
msgstr "détacher l'écran"

#. 8 Bit Graphics Library block
msgid "set scale _"
msgstr "définir l'échelle _"

#. 8 Bit Graphics Library block
msgid "draw buffer"
msgstr "dessiner le tampon"

#. 8 Bit Graphics Library block
msgid "starting at x _ y _ width _ height _"
msgstr "en commençant à x _ y _ largeur _ hauteur _"

#. 8 Bit Graphics Library block
msgid "bitmap from BMP file _"
msgstr "bitmap depuis le fichier BMP _"

#. 8 Bit Graphics Library block
msgid "bitmap of width _ from raw indexed file _"
msgstr "bitmap de largeur _ depuis fichier indexé brut _"

#. 8 Bit Graphics Library block
msgid "bitmap of width _ from string _"
msgstr "bitmap de largeur _ depuis la chaîne _"

#. 8 Bit Graphics Library block
msgid "bitmap _ rotated _ º"
msgstr "bitmap _ tourné de _ º"

#. 8 Bit Graphics Library block
msgid "bitmap _ mirrored across _ axis"
msgstr "bitmap _ inversé sur l'axe _"

#. 8 Bit Graphics Library block
msgid "merge bitmap _ at _ , _"
msgstr "fusionner le bitmap _ à _ , _"

#. 8 Bit Graphics Library block
msgid "merge tile _ from _ , _ to _ , _"
msgstr "fusionner la tuile _ de _ , _ à _ , _"

#. 8 Bit Graphics Library block
msgid "merge tile _ at tile position _ , _"
msgstr "fusionner la tuile _ à la position de tuile _ , _"

#. 8 Bit Graphics Library block
msgid "set palette _"
msgstr "définir la palette _"

#. 8 Bit Graphics Library block
msgid "set transparent color index _"
msgstr "définir l'index de couleur transparente _"

#. 8 Bit Graphics Library block
msgid "palette from pal file _"
msgstr "palette depuis le fichier pal _"

#. 8 Bit Graphics Library block
msgid "palette from BMP file _"
msgstr "palette depuis le fichier BMP _"

#. 8 Bit Graphics Library block
msgid "4 bit _ palette"
msgstr "palette 4 bits _"

#. 8 Bit Graphics Library block
msgid "8 bit _ palette"
msgstr "palette 8 bits _"

#. 8 Bit Graphics Library block
msgid "color number for r _ g _ b _ (0-255)"
msgstr "numéro de couleur pour r _ v _ b _ (0-255)"

#. 8 Bit Graphics Library block
msgid "draw palette table _"
msgstr "dessiner la table de palette _"

#. 8 Bit Graphics Library block
msgid "current palette"
msgstr "palette actuelle"

#. 8 Bit Graphics Library block
msgid "screen width"
msgstr "largeur de l'écran"

#. 8 Bit Graphics Library block
msgid "screen height"
msgstr "hauteur de l'écran"

#. Fractions library block
msgid "fract _ − _"
msgstr "fract _ − _"

#. Tone library block
msgid "start note _ octave _"
msgstr "démarrer la note _ octave _"

#. Tone library block
msgid "start midi key _"
msgstr "démarrer la touche midi _"

#. Analog Synthesis library label
#. Generate synthesized sound waves to play on a DAC, over PWM, or any other analog means
msgid "Analog Synthesis"
msgstr "Synthèse analogique"

#. Analog Synthesis library block
#. only translate "gate _" as in a synthesizer sound gate that can be triggered
msgid "#SVG#wave-sine gate _"
msgstr "#SVG#wave-sine porte _"

#. Analog Synthesis library block
#. only translate "gate _" as in a synthesizer sound gate that can be triggered
msgid "#SVG#wave-square gate _"
msgstr "#SVG#wave-square porte _"

#. Analog Synthesis library block
#. only translate "gate _" as in a synthesizer sound gate that can be triggered
msgid "#SVG#wave-triangle gate _"
msgstr "#SVG#wave-triangle porte _"

#. Analog Synthesis library block
#. only translate "gate _" as in a synthesizer sound gate that can be triggered
msgid "#SVG#wave-sawtooth gate _"
msgstr "#SVG#wave-sawtooth porte _"

#. Analog Synthesis library block
#. only translate "gate _" as in a synthesizer sound gate that can be triggered
msgid "#SVG#wave-noise gate _"
msgstr "#SVG#wave-noise porte _"

#. Analog Synthesis library block
msgid "set amplitude _ attack _ hold _ release _ for gate _"
msgstr "définir amplitude _ attaque _ maintien _ relâchement _ pour la porte _"

#. Analog Synthesis library block
msgid "trigger gate _ MIDI key _"
msgstr "déclencher la porte _ touche MIDI _"

#. Analog Synthesis library block
msgid "set frequency ramp from _ % to _ % for gate _"
msgstr "définir la rampe de fréquence de _ % à _ % pour la porte _"

#. Analog Synthesis library block
msgid "amplitude for gate _"
msgstr "amplitude pour la porte _"

#. Analog Synthesis library block
msgid "frequency for gate _"
msgstr "fréquence pour la porte _"

#. Analog Synthesis library block
#. example: output [16320] to [analog pin]
#. example: output [16320] to [MCP4725 DAC]
msgid "output _ to _"
msgstr "sortir _ vers _"

#. Analog Synthesis library block
#. as in pin number or i2c address
msgid "number/address _"
msgstr "numéro/adresse _"

#. Analog Synthesis library block
#. as in digital resolution (8 bit, 16 bit...)
msgid "asynth;resolution _"
msgstr "résolution _"

#. Analog Synthesis library block menu option
msgid "asy;pin"
