msgid "wait _ microsecs"
msgstr "காத்திருங்கள் _ மைக்ரோக்கள்"

#. Block in Control category
msgid "return _"
msgstr "திரும்ப _"

#. Block in Control category
msgid "when _ received"
msgstr "_ பெறும்போது"

#. Example message for [ when _ received ] and [ broadcast _ ] blocks
msgid "go!"
msgstr "போ!"

#. Block in Control category
msgid "broadcast _"
msgstr "ஒளிபரப்பு _"

#. Block in Control category
