msgstr "என்றென்றும் _"

#. Block in Control category
msgid "repeat _ _"
msgstr "மீண்டும் _ _"

#. Block in Control category
msgid "wait _ millisecs"
msgstr "_ மில்லிசெக்குகள் காத்திருங்கள்"

#. Block in Control category
msgid "if _ _"
msgstr "_ _ என்றால்"

#. Block in Control category
msgid "if _ _ else _"
msgstr "_ _ வேறு _ என்றால்"

#. Block in Control category
msgid "else if _ _"
msgstr "இல்லை இதுவேன்றால் _ _"

#. Block in Control category
msgid "else"
msgstr "வேறு"

#. Block in Control category
msgid "when _"
msgstr "போது _"

