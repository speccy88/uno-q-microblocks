msgstr "caja durante _ ms en el pin DAC _"

#. Cutebot Pro library block dropdown option
#. as in turn "right" on your axis
msgid "cutebotturn;right-in-place"
msgstr "derecha (sobre su eje)"

#. Cutebot Pro library block
msgid "CBPro set wheel speed left _ right _ (-60 to 60 cm/s)"
msgstr ""
"CBPro fija la velocidad de la rueda izquierda a _ y derecha a _ (-60 a 60 cm/"
"s)"

#. Cutebot Pro library block
msgid "CBPro turn _ degrees"
msgstr "CBPro gira _ grados"

#. Cutebot Pro library block
msgid "CBPro set headlight _ to _"
msgstr "CBPro pon el faro _ a _"

#. Octostudio communication library block
msgid "Octo last beam"
msgstr "último mensaje Octo"

#. Octostudio communication library block
msgid "Octo beam received?"
msgstr "¿mensaje Octo recibido?"

#. Octostudio communication library block
msgid "Octo set group _ (0-99)"
msgstr "fija grupo de Octo a _ (0-99)"

#. Cutebot Pro library block
msgid "CBPro stop wheel _"
