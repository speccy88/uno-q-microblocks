msgstr "povolit WiFi při používání BLE _"

#. File System library block
#, fuzzy
msgid "read position of file _"
msgstr "čti pozici souboru _"

#. NeZha2 robot library block
msgid "Nezha soil moisture _"
msgstr "Nezha vhlkost půdy _"

#. TFT Display library block
msgid "draw pixel row _ x _ y _"
msgstr "na TFT zobraz řadu _ x _ y _"

#. NeZha2 robot library block
msgid "Nezha set motor _ speed to _ (-100-100)"
msgstr "Nezha motor _ rychlost _ (-100 až 100)"

#. Calliope NeoPixel library block
msgid "Calliope rotate NeoPixels by _"
msgstr "Calliope rotuj NeoPixely o _"

#. Lists library block. It takes a list and replaces a few, some, most or (list of indices) items with some other element
msgid "_ with _ items replaced by _"
msgstr "_ s _ položkami nahrazenými _"

#. Calliope NeoPixel library block
msgid "Calliope set NeoPixels _ _ _"
msgstr "Calliope nastav NeoPixely _ _ _"

#. Calliope NeoPixel library block
msgid "Calliope set all NeoPixels to _"
msgstr "Calliope nastav všechny NeoPixely na _"

#. Calliope NeoPixel library block
msgid "Calliope set brightness to _ %"
msgstr "Calliope nastav jas na _ %"

#. Calliope Servoboard library block
msgid "Calliope stop servo _"
msgstr "Calliope zastav servo _"

#. Calliope Servoboard library block
msgid "Calliope set continous servo _ to speed _ (-100~100)"
msgstr "Calliope nastav kontinuální servo _ rychlost _ (-100~100)"

#. Calliope Servoboard library block
msgid "Calliope stop all motors and servos"
msgstr "Calliope zastav všechny montory a serva"

#. Calliope Servoboard library block
msgid "Calliope set _ servo _ to angle _ °"
msgstr "Calliope nastav _ servo _ do úhlu _ °"

#. Calliope Servoboard library block
msgid "Calliope set motor _ to speed _ (-100~100)"
msgstr "Calliope nastav motor _ rychlost _ (-100 - 100)"

#. Calliope Servoboard library block
msgid "Calliope stop motor _"
msgstr "Calliope zastav motor _"

#. Barometer (LPS331AP) library dropdown menu option
msgid "lps331;ºC"
msgstr "ºC"

#. Barometer (LPS331AP) library
